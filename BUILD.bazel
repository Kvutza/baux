load("@rules_python//python:defs.bzl", "py_test")
load("@rules_python//python:packaging.bzl", "py_wheel")
load("//build/bazel:python_extension.bzl", "copy_extension")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "LICENSE",
    "NOTICE",
])

alias(
    name = "cpu",
    actual = "//rust/crates/baux:baux_cpu",
)

alias(
    name = "gpu",
    actual = select({
        "@platforms//os:macos": "//rust/crates/baux:baux_metal",
        "//conditions:default": "//rust/crates/baux:baux_opencl",
    }),
)

alias(
    name = "ext",
    actual = "//rust/crates/baux-py:python_extension",
)

filegroup(
    name = "python_sources",
    srcs = glob(["src/baux/**/*.py"]),
)

copy_extension(
    name = "wheel_extension",
    src = "//rust/crates/baux-py:python_extension",
    output = "baux/baux_rust.so",
)

py_wheel(
    name = "wheel",
    abi = "cp314",
    description_content_type = "text/markdown",
    description_file = "README.md",
    distribution = "baux",
    extra_distinfo_files = {
        ":LICENSE": "licenses/LICENSE",
        ":NOTICE": "licenses/NOTICE",
    },
    homepage = "https://github.com/Kvutza/baux",
    license = "MIT",
    platform = select({
        "@platforms//os:linux": "manylinux_2_28_x86_64",
        "@platforms//os:macos": "macosx_11_0_arm64",
        "//conditions:default": "any",
    }),
    python_requires = ">=3.14,<3.16",
    python_tag = "cp314",
    requires = [
        "ax-platform>=1.3.1,<1.4",
        "botorch>=0.18.1,<0.19",
        "numpy>=2.1",
        "optuna>=5.0,<5.1",
        "scipy>=1.11",
    ],
    strip_path_prefixes = ["src"],
    summary = "Black-box optimization library",
    version = "0.0.1",
    deps = [
        ":python_sources",
        ":wheel_extension",
    ],
)

test_suite(
    name = "check",
    tests = [
        "//rust/crates/baux:baux_test",
        "//rust/crates/properties:properties_test",
        "//rust/crates/baux:trial_search_metal_test",
    ],
)

py_test(
    name = "audit",
    srcs = ["//build/bazel:audit_wheel.py"],
    args = ["$(location :wheel)"],
    data = [":wheel"],
    main = "//build/bazel:audit_wheel.py",
)
