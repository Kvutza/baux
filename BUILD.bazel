load("@rules_python//python:defs.bzl", "py_test")
load("@rules_python//python:packaging.bzl", "py_wheel")
load("//admin/bazel:python_extension.bzl", "copy_extension")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "LICENSE",
    "NOTICE",
])

alias(
    name = "cpu",
    actual = "//rust/crates/baux:baux_cpu",
)

alias(
    name = "gpu",
    actual = select({
        "@platforms//os:macos": "//rust/crates/baux:baux_metal",
        "//conditions:default": "//rust/crates/baux:baux_cpu",
    }),
)

alias(
    name = "ext",
    actual = "//rust/crates/baux-py:python_extension",
)

filegroup(
    name = "python_sources",
    srcs = glob(["python/baux/**/*.py"]),
)

copy_extension(
    name = "wheel_extension",
    src = "//rust/crates/baux-py:python_extension",
    output = "baux/baux_rust.so",
)

py_wheel(
    name = "wheel",
    abi = "cp314",
    description_content_type = "text/markdown",
    description_file = "README.md",
    distribution = "baux",
    extra_distinfo_files = {
        ":LICENSE": "licenses/LICENSE",
        ":NOTICE": "licenses/NOTICE",
    },
    homepage = "https://github.com/Kvutza/baux",
    license = "MIT",
    platform = select({
        "@platforms//os:linux": "manylinux_2_28_x86_64",
        "@platforms//os:macos": "macosx_11_0_arm64",
        "//conditions:default": "any",
    }),
    python_requires = ">=3.12,<3.16",
    python_tag = "cp314",
    requires = [
        "numpy>=2.1",
    ],
    extra_requires = {
        "ax": ["ax-platform>=1.3.1,<1.4"],
        "botorch": ["botorch>=0.18.1,<0.19"],
        "optuna": ["optuna>=5.0,<5.1"],
        "gp": [
            "torch>=2.2",
            "gpytorch>=1.11",
            "scipy>=1.11",
        ],
        "integrations": [
            "ax-platform>=1.3.1,<1.4",
            "botorch>=0.18.1,<0.19",
            "optuna>=5.0,<5.1",
            "scipy>=1.11",
        ],
        "compiler": [
            "optree==0.20.0",
            "jax==0.12.0.1",
            "jaxlib==0.12.0.1",
            "iree-base-compiler==3.13.0",
            "iree-base-runtime==3.13.1",
            "apache-tvm==0.27.0.post1",
            "apache-tvm-ffi==0.1.15.post2",
            "cyxla-pjrt-cpu==0.12.0.1; sys_platform == 'darwin' and platform_machine == 'arm64'",
        ],
    },
    strip_path_prefixes = ["python"],
    summary = "Black-box optimization library",
    version = "0.0.6",
    deps = [
        ":python_sources",
        ":wheel_extension",
    ],
)

test_suite(
    name = "check",
    tests = [
        "//rust/crates/baux:baux_test",
        "//rust/crates/properties:properties_test",
        "//rust/crates/baux:knn_metal_test",
    ],
)

py_test(
    name = "audit",
    srcs = ["//admin/bazel:audit_wheel.py"],
    args = ["$(location :wheel)"],
    data = [":wheel"],
    main = "//admin/bazel:audit_wheel.py",
)
