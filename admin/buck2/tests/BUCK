load(":suite.bzl", "test_suite")
load("//admin/buck2:python.bzl", "PYTHON_COMPILER_ENVIRONMENT", "PYTHON_ENVIRONMENT")

sh_test(
    name = "compiler-python",
    test = "compiler.sh",
    args = ["-k", read_config("baux", "compiler_filter", ""), "-o", "faulthandler_timeout=30"],
    resources = ["//:compiler-source", "//:wheel-macos-arm64"],
    env = {
        "BAUX_TEST_PYTHON": ".pixi/envs/" + PYTHON_COMPILER_ENVIRONMENT + "/bin/python",
        "BAUX_TEST_WHEEL": "$(location //:wheel-macos-arm64)",
    },
    target_compatible_with = ["prelude//os/constraints:macos"],
)

