#!/usr/bin/env python3
"""Generate admin/ui/py_presets.ml from examples/repl/presets.toml and examples/repl/*.py."""

from __future__ import annotations

import argparse
import difflib
import sys
import tomllib
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
PRESETS_TOML = REPO_ROOT / "examples" / "repl" / "presets.toml"
REPL_DIR = REPO_ROOT / "examples" / "repl"
TARGET_ML = REPO_ROOT / "admin" / "ui" / "py_presets.ml"


def escape_ocaml_str(s: str) -> str:
    return s.replace("\\", "\\\\").replace('"', '\\"')


def format_ocaml_code(py_source: str) -> str:
    lines = py_source.splitlines(keepends=True)
    parts: list[str] = []
    for line in lines:
        has_nl = line.endswith("\n")
        content = line[:-1] if has_nl else line
        escaped = content.replace("\\", "\\\\").replace('"', '\\"')
        if has_nl:
            escaped += "\\n"
        parts.append(f'"{escaped}"')
    return "\n        ^ ".join(parts)


def generate_ml() -> str:
    if not PRESETS_TOML.is_file():
        raise FileNotFoundError(f"Presets TOML not found: {PRESETS_TOML}")

    with open(PRESETS_TOML, "rb") as f:
        data = tomllib.load(f)

    presets_list = data.get("presets", [])
    if not presets_list:
        raise ValueError(f"No presets found in {PRESETS_TOML}")

    blocks: list[str] = []
    for p in presets_list:
        pid = p["id"]
        py_file = REPL_DIR / f"{pid}.py"
        if not py_file.is_file():
            raise FileNotFoundError(f"Missing Python script: {py_file}")

        py_source = py_file.read_text(encoding="utf-8")
        for idx, line in enumerate(py_source.splitlines(), start=1):
            if len(line) > 88:
                msg = f"{py_file}:{idx}: line exceeds 88 columns ({len(line)} chars):\n{line}"
                raise ValueError(msg)

        label = escape_ocaml_str(p["label"])
        tag = escape_ocaml_str(p["tag"])
        desc = escape_ocaml_str(p["description"])
        code_expr = format_ocaml_code(py_source)

        block = (
            f"    {{\n"
            f'      id = "{pid}";\n'
            f'      label = "{label}";\n'
            f'      tag = "{tag}";\n'
            f"      description =\n"
            f'        "{desc}";\n'
            f"      code =\n"
            f"        {code_expr};\n"
            f"    }};"
        )
        blocks.append(block)

    presets_body = "\n".join(blocks)

    ml_content = (
        "(* admin/ui/py_presets.ml\n"
        "   Auto-generated by admin/tools/gen-repl-presets. DO NOT EDIT.\n"
        "*)\n\n"
        '[@@@warning "-32-27-33"]\n\n'
        "type preset = {\n"
        "  id : string;\n"
        "  label : string;\n"
        "  tag : string;\n"
        "  description : string;\n"
        "  code : string;\n"
        "}\n\n"
        "let presets : preset list =\n"
        "  [\n"
        f"{presets_body}\n"
        "  ]\n"
    )
    return ml_content


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Generate admin/ui/py_presets.ml from examples/repl/"
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Check if admin/ui/py_presets.ml is up to date",
    )
    args = parser.parse_args()

    try:
        content = generate_ml()
    except Exception as e:
        sys.stderr.write(f"Error generating presets: {e}\n")
        return 1

    if args.check:
        if not TARGET_ML.is_file():
            sys.stderr.write(
                f"Error: {TARGET_ML} does not exist. Run ./admin/tools/gen-repl-presets\n"
            )
            return 1
        existing = TARGET_ML.read_text(encoding="utf-8")
        if existing != content:
            diff = difflib.unified_diff(
                existing.splitlines(keepends=True),
                content.splitlines(keepends=True),
                fromfile="admin/ui/py_presets.ml (on disk)",
                tofile="admin/ui/py_presets.ml (generated)",
            )
            sys.stderr.write("Error: admin/ui/py_presets.ml is out of date. Diff:\n")
            sys.stderr.writelines(diff)
            sys.stderr.write("\nRun ./admin/tools/gen-repl-presets to regenerate.\n")
            return 1
        print("admin/ui/py_presets.ml is up to date.")
        return 0

    TARGET_ML.write_text(content, encoding="utf-8")
    print(f"Wrote {TARGET_ML} ({len(content.splitlines())} lines)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
