#!/bin/sh
set -eu
repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
cd "$repo_dir"
if [ "$(uname -s)" = Linux ] && [ "${1:-}" = cuda ] && [ "${2:-}" = setup ]; then
    shift 2
    exec ./admin/tools/cuda-setup "$@"
fi
if [ "$(uname -s)" = Linux ] && [ "${1:-}" = cuda ] && [ "${2:-}" = tune-t4 ]; then
    shift 2
    exec ./admin/tools/buck2w run --console simple -v 2 //rust/crates/runner:baux-runner -- \
        cuda-tune-t4 "$@"
fi
case "${BAUX_BUILD_SYSTEM:-buck2}" in
    buck2)
        pid_file="$repo_dir/.cache/baux/daemon/daemon.pid"
        daemon_alive=0
        if [ -f "$pid_file" ]; then
            IFS= read -r dpid < "$pid_file" || dpid=""
            if [ -n "$dpid" ] && kill -0 "$dpid" 2>/dev/null; then
                daemon_alive=1
            fi
        fi
        if [ "$daemon_alive" -eq 0 ] && [ "${BAUX_NO_DAEMON:-0}" = 0 ] && [ -x "$repo_dir/admin/tools/baux-daemon" ]; then
            nohup "$repo_dir/admin/tools/baux-daemon" >/dev/null 2>&1 &
        fi
        if [ "$daemon_alive" -eq 1 ] && [ "${BAUX_NO_DAEMON:-0}" = 0 ] && [ $# -eq 1 ] && [ "$1" = test ]; then
            rc=0
            "$repo_dir/admin/tools/baux-daemon" test || rc=$?
            if [ "$rc" -ne 2 ]; then
                exit "$rc"
            fi
        fi
        stamp="$repo_dir/.cache/baux/cli-bin.path"
        binary=""
        if [ -f "$stamp" ] && [ -z "$(find rust/crates/cli rust/crates/tooling rust/crates/baux/artifact -type f -newer "$stamp" -print -quit 2>/dev/null)" ]; then
            IFS= read -r binary < "$stamp" || binary=""
        fi
        if [ -z "$binary" ] || [ ! -x "$binary" ]; then
            built=$(./admin/tools/buck2w build --console simple -v 2 --show-full-output //rust/crates/cli:baux)
            case "$built" in
                *"root//rust/crates/cli:baux "*)
                    line=${built##*root//rust/crates/cli:baux }
                    binary=${line%%
*}
                    ;;
                *) echo "baux: could not resolve the Buck2 CLI artifact" >&2; exit 1 ;;
            esac
            [ -x "$binary" ] || { echo "baux: Buck2 CLI artifact is not executable" >&2; exit 1; }
            mkdir -p "$(dirname "$stamp")"
            printf '%s\n' "$binary" > "$stamp"
        fi
        exec "$binary" "$@"
        ;;
    bazel) exec bazel run --config=release --config=constrained //rust/crates/cli:baux -- "$@" ;;
    *) echo "baux: BAUX_BUILD_SYSTEM must be buck2 or bazel" >&2; exit 1 ;;
esac
