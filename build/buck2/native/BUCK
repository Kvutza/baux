cxx_library(
    name = "mujoco-shim",
    srcs = ["mujoco_shim.c"],
    header_namespace = "",
    headers = {
        "gymnasium_assets.h": ":gymnasium-assets-header",
    },
    preprocessor_flags = select({
        "//:linux-arm64": ["-I$(location :mujoco-linux-arm64-archive[include])", "-O3"],
        "//:linux-x86_64": ["-I$(location :mujoco-linux-x86_64-archive[include])", "-O3"],
        "//:macos-arm64": ["-I$(location :mujoco-macos-arm64-archive[mujoco/include])", "-O3", "-DACCELERATE_NEW_LAPACK"],
    }),
    exported_linker_flags = select({
        "//:macos-arm64": ["-framework", "Accelerate"],
        "DEFAULT": [],
    }),
    exported_deps = select({
        "//:linux-arm64": [":mujoco-lib-linux-arm64"],
        "//:linux-x86_64": [":mujoco-lib-linux-x86_64"],
        "//:macos-arm64": [":mujoco-lib-macos"],
    }),
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
)

