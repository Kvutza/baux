patch_mujoco_macos(
    name = "mujoco-macos-dylib",
    archive = ":mujoco-macos-arm64-archive",
    target_compatible_with = ["prelude//os/constraints:macos"],
    visibility = ["PUBLIC"],
)

prebuilt_cxx_library(
    name = "mujoco-lib-macos",
    exported_linker_flags = [
        "-Wl,-needed_library,$(location :mujoco-macos-dylib)",
    ],
    preferred_linkage = "shared",
    shared_lib = ":mujoco-macos-dylib",
    soname = "libmujoco.3.17.0.dylib",
    target_compatible_with = ["prelude//os/constraints:macos"],
    visibility = ["PUBLIC"],
)

