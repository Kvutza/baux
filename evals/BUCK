load("//build/buck2:reindeer_rules.bzl", "app_rust_binary", "app_rust_library")
load("//build:targets.bzl", "RUST_EDITION")

filegroup(
    name = "source",
    srcs = glob(["src/**/*.rs"]) + ["Cargo.toml"],
    visibility = ["PUBLIC"],
)

_FAST_FLAGS = [
    "-Copt-level=3",
    "-Cdebug-assertions=off",
    "-Coverflow-checks=off",
]

app_rust_library(
    name = "evals",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**"]),
    crate = "baux_evals",
    crate_root = "src/evals.rs",
    edition = RUST_EDITION,
    rustc_flags = _FAST_FLAGS,
    deps = [
        "//build/buck2/native:mujoco-shim",
        "//rust:deser",
        "//rust:ndarray",
        "//rust:rand",
        "//rust:rand_chacha",
        "//rust/crates/baux:baux",
    ],
    visibility = ["PUBLIC"],
)

rust_test(
    name = "evals-unit",
    srcs = glob(["src/**/*.rs", "experiments/*.toml"], exclude = ["src/bin/**"]),
    crate = "baux_evals",
    crate_root = "src/evals.rs",
    edition = RUST_EDITION,
    rustc_flags = _FAST_FLAGS,
    deps = [
        "//build/buck2/native:mujoco-shim",
        "//rust:deser",
        "//rust:ndarray",
        "//rust:rand",
        "//rust:rand_chacha",
        "//rust/crates/baux:baux",
    ] + select({
        "//:macos-arm64": ["//build/buck2/native:openmp-macos"],
        "DEFAULT": [],
    }),
    rpath = True,
    runtime_dependency_handling = "symlink",
    visibility = ["//build/buck2/tests:all"],
)

app_rust_binary(
    name = "control-bench",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/bin/control_bench.rs",
    edition = RUST_EDITION,
    rustc_flags = _FAST_FLAGS,
    deps = [
        ":evals",
        "//build/buck2/native:mujoco-shim",
        "//rust:deser",
        "//rust:ndarray",
        "//rust:rand",
        "//rust:rand_chacha",
        "//rust/crates/baux:baux",
    ] + select({
        "//:macos-arm64": ["//build/buck2/native:openmp-macos"],
        "DEFAULT": [],
    }),
    rpath = True,
    runtime_dependency_handling = "symlink",
    visibility = ["PUBLIC"],
)
