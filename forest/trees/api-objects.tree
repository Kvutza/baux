\title{Resident objects}
\meta{toc}{false}

\p{Resident objects encapsulate acceleration buffers, Metal search state, and multi-region portfolios. The functional interface (such as \code{baux.init}, \code{baux.ask}, and \code{baux.tell}) manipulates immutable \code{OptimizerState} values; these resident objects provide direct handle semantics for high-throughput GPU workflows and native buffers.}

\<section>[id]{baux.Telemetry}[class]{api-entry}[data-symbol]{baux.Telemetry}[data-kind]{class}[data-module]{baux.turbo.optimizer_types}{
  \<div>[class]{api-entry-header}{\<h2>[class]{api-entry-title}{[\code{baux.Telemetry}](api-objects.html#baux.Telemetry)}}
  \pre{
baux.Telemetry(
    dt_fit: float,
    dt_sel: float,
    dt_gen: float = 0.0,
    dt_tell: float = 0.0,
    num_candidates: int = 0,
)
  }
  \p{Timings and candidate count from optimizer work.}
  \p{\code{dt_fit}, \code{dt_sel}, \code{dt_gen} and \code{dt_tell} are durations in seconds. \code{num_candidates} is the candidate count. Available on optimizer state as \code{state.telemetry}.}
  \<div>[class]{api-example}{\<p>[class]{example-label}{Example}
\pre{
import numpy as np
import baux

bounds = np.array([[-1.0, 1.0], [-2.0, 2.0]])
st = baux.init(bounds, seed=0)
st, batch = baux.ask(st, 2)
st, _ = baux.tell(st, batch, np.sum(batch.points**2, axis=-1, keepdims=True))
telem = st.telemetry

assert isinstance(telem, baux.Telemetry)
assert telem.num_candidates >= 0
print("telemetry:", telem.dt_fit, telem.dt_sel, telem.num_candidates)
}
  }
  \<p>[class]{api-source}{[Source in \code{python/baux/turbo/optimizer_types.py}](https://github.com/Kvutza/baux/blob/main/python/baux/turbo/optimizer_types.py#L26)}
}

\<section>[id]{baux.Region}[class]{api-entry}[data-symbol]{baux.Region}[data-kind]{class}{
  \<div>[class]{api-entry-header}{\<h2>[class]{api-entry-title}{[\code{baux.Region}](api-objects.html#baux.Region)}}
  \pre{
class baux.Region
  }
  \p{Apple Metal resident trust region search state.}
  \p{Maintains trust region centers, local step sizing, success/failure counters, and on-device proposal generation for Apple Silicon acceleration. Call \code{region.ask(...)} to obtain \code{(next_region, trial)}, and \code{region.tell(trial, y)} to record objective values and return \code{(next_region, y_best)}.}
  \<p>[class]{api-source}{[Source in \code{rust/crates/baux-py/src/py_metal.rs}](https://github.com/Kvutza/baux/blob/main/rust/crates/baux-py/src/py_metal.rs#L23)}
}

\<section>[id]{baux.Trial}[class]{api-entry}[data-symbol]{baux.Trial}[data-kind]{class}{
  \<div>[class]{api-entry-header}{\<h2>[class]{api-entry-title}{[\code{baux.Trial}](api-objects.html#baux.Trial)}}
  \pre{
class baux.Trial
  }
  \p{Apple Metal resident proposal ticket.}
  \p{Encapsulates candidate weights and coordinate evaluation tickets generated by a resident \code{Region}. Provides \code{trial.weights()} or \code{trial.var()} to access resident parameter buffers without host transfers.}
  \<p>[class]{api-source}{[Source in \code{rust/crates/baux-py/src/py_metal/py_buf.rs}](https://github.com/Kvutza/baux/blob/main/rust/crates/baux-py/src/py_metal/py_buf.rs#L92)}
}

\<section>[id]{baux.Portfolio}[class]{api-entry}[data-symbol]{baux.Portfolio}[data-kind]{class}{
  \<div>[class]{api-entry-header}{\<h2>[class]{api-entry-title}{[\code{baux.Portfolio}](api-objects.html#baux.Portfolio)}}
  \pre{
class baux.Portfolio
  }
  \p{Apple Metal multi-region portfolio search coordinator.}
  \p{Coordinates multiple trust regions across diverse search spaces with resident allocation strategies and cross-region sharing. Call \code{portfolio.ask(...)} to obtain \code{(next_portfolio, trials)} as \code{RegionTrial} tickets, and \code{portfolio.tell(trials, y)} to return \code{(next_portfolio, imported)}.}
  \<p>[class]{api-source}{[Source in \code{rust/crates/baux-py/src/py_portfolio.rs}](https://github.com/Kvutza/baux/blob/main/rust/crates/baux-py/src/py_portfolio.rs#L22)}
}

\<section>[id]{baux.RegionTrial}[class]{api-entry}[data-symbol]{baux.RegionTrial}[data-kind]{class}{
  \<div>[class]{api-entry-header}{\<h2>[class]{api-entry-title}{[\code{baux.RegionTrial}](api-objects.html#baux.RegionTrial)}}
  \pre{
class baux.RegionTrial
  }
  \p{Apple Metal multi-region proposal ticket.}
  \p{Encapsulates candidate evaluation proposals returned from a \code{Portfolio}. Exposes \code{ticket.region}, \code{ticket.generation}, and \code{ticket.weights()} for evaluating points across regions.}
  \<p>[class]{api-source}{[Source in \code{rust/crates/baux-py/src/py_portfolio.rs}](https://github.com/Kvutza/baux/blob/main/rust/crates/baux-py/src/py_portfolio.rs#L290)}
}

\<section>[id]{baux.Tensor}[class]{api-entry}[data-symbol]{baux.Tensor}[data-kind]{class}{
  \<div>[class]{api-entry-header}{\<h2>[class]{api-entry-title}{[\code{baux.Tensor}](api-objects.html#baux.Tensor)}}
  \pre{
class baux.Tensor
  }
  \p{Device-resident multi-backend buffer with DLPack export.}
  \p{Represents contiguous multi-dimensional arrays resident on accelerator backends (CPU, Metal, CUDA). Supports zero-copy DLPack protocol export via \code{__dlpack__()} and \code{__dlpack_device__()} to PyTorch, JAX, or NumPy.}
  \<p>[class]{api-source}{[Source in \code{rust/crates/baux-py/src/py_posterior.rs}](https://github.com/Kvutza/baux/blob/main/rust/crates/baux-py/src/py_posterior.rs#L68)}
}

\<section>[id]{baux.Var}[class]{api-entry}[data-symbol]{baux.Var}[data-kind]{class}{
  \<div>[class]{api-entry-header}{\<h2>[class]{api-entry-title}{[\code{baux.Var}](api-objects.html#baux.Var)}}
  \pre{
class baux.Var
  }
  \p{Apple Metal resident parameter weights buffer.}
  \p{Encapsulates 16-bit float weight representations stored in Metal device memory, enabling parameter evaluation and kernel operations without CPU memory round-trips.}
  \<p>[class]{api-source}{[Source in \code{rust/crates/baux-py/src/py_metal/py_buf.rs}](https://github.com/Kvutza/baux/blob/main/rust/crates/baux-py/src/py_metal/py_buf.rs#L17)}
}
