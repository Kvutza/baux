\title{baux}
\meta{toc}{false}

\p{Derivative-free optimization with a Rust core and functional Python API. Prebuilt Python 3.12–3.15 wheels for Linux x86-64 and macOS arm64.}

\subtree{
  \title{Install}
  \pre{
pip install baux
cargo add baux
  }
}

\subtree{
  \title{Usage}
  \<div>[id]{quickstart}{
  \pre{
import baux
import numpy as np

bounds = np.array([[-2.0, 2.0], [-1.0, 3.0]])
state = baux.init(bounds, pipe=baux.enn(), seed=0)

def rosenbrock(x):
    return -(1.0 - x[:, 0]) ** 2 - 20.0 * (x[:, 1] - x[:, 0] ** 2) ** 2

for _ in range(10):
    state, batch = baux.ask(state, num_arms=4)
    values = rosenbrock(batch.points)
    state, _ = baux.tell(state, batch, values)

print("Rosenbrock max(-f):", round(float(state.best_y), 5), "at", np.round(state.best_x, 4))
  }
  }
  \p{baux maximizes objective values; pass the state returned by \code{ask} and \code{tell} to the next step.}
}

