\title{ENN Predictions}

\p{
  Use \code{enn_init}, \code{fit}, and \code{posterior} directly on existing \code{(x, y)} observations (see [API Reference](api-enn.html#baux.enn_init)), or pass \code{baux.enn(k=8)} inside a pipeline.
}

\pre{
import numpy as np
import baux

x = np.concatenate([np.linspace(-1.4, 0.2, 16), np.linspace(1.1, 1.8, 8)]).reshape(-1, 1)
y = np.exp(-0.35 * x ** 2) * np.cos(2.8 * x) + 0.15 * x
data = baux.enn_init(x, y)
params = baux.fit(data, k=8, key=baux.key(0))
prediction = baux.posterior(data, np.array([[0.0], [0.65]]), params)

assert prediction.mu.shape == (2, 1)
print("dense x=0.0  mu=", round(float(prediction.mu[0, 0]), 4), "se=", round(float(prediction.se[0, 0]), 4))
print("gap   x=0.65 mu=", round(float(prediction.mu[1, 0]), 4), "se=", round(float(prediction.se[1, 0]), 4))
}

\subtree{
  \title{Inverse-Variance Posterior}

  \p{
    Given #{\mathcal{D} = \{(x_m, y_m, s_m)\}_{m=1}^N}, dissimilarity #{\delta}, target variance #{\hat{\sigma}_y^2 > 0}, and scale parameters #{\theta=(s_0^2,c_e)} ([[BJS25]](https://arxiv.org/abs/2506.12818)):
  }

  ##{
    \mu(x \mid x_m) = y_m, \qquad
    \sigma_a^2(x \mid x_m) = \hat{\sigma}_y^2 s_0^2 + s_m^2, \qquad
    \sigma_e^2(x \mid x_m) = \hat{\sigma}_y^2 c_e\, \delta(x, x_m).
  }

  \p{
    Over the #{K} nearest indices #{N_K(x)=\{\pi_1(x),\ldots,\pi_K(x)\}} with #{w_i(x) = (\sigma_a^2(x \mid x_{\pi_i(x)}) + \sigma_e^2(x \mid x_{\pi_i(x)}))^{-1}}:
  }

  ##{
    \mu(x) = \frac{\sum_{i=1}^K w_i(x)\, y_{\pi_i(x)}}{\sum_{i=1}^K w_i(x)}, \qquad
    \sigma_a^2(x) = \frac{\sum_{i=1}^K w_i(x)\, \sigma_a^2(x \mid x_{\pi_i(x)})}{\sum_{i=1}^K w_i(x)}, \qquad
    \sigma_e^2(x) = \frac{1}{\sum_{i=1}^K w_i(x)},
  }

  \p{
    Total variance is #{\sigma^2(x) = \sigma_e^2(x) + \sigma_a^2(x)}, fitted via leave-one-out Gaussian pseudolikelihood over subsample #{S_P}:
  }

  ##{
    \widehat{\log \mathcal{L}}(\theta) = -\frac{1}{2P} \sum_{n \in S_P} \left[\log\bigl(2\pi \sigma_{-n}^2(x_n; \theta)\bigr) + \frac{\bigl(y_n - \mu_{-n}(x_n; \theta)\bigr)^2}{\sigma_{-n}^2(x_n; \theta)}\right].
  }
}

\subtree{
  \title{Joint Draws}

  \p{
    Attaching #{z_{s,m,j} \stackrel{\text{i.i.d.}}{\sim} \mathcal{N}(0, 1)} to stored points (#{\bar{w}_{i,j}(x) = w_{i,j}(x) / \sum_{r=1}^K w_{r,j}(x)}, zero-extended to #{\tilde{w}_{m,j}(x)}) yields correlated joint draws without a #{Q \times Q} Cholesky factor:
  }

  ##{
    \tilde{f}_{s,j}(x) = \mu_j(x) + \frac{\sigma_{e,j}(x)}{\Vert\bar{w}_j(x)\Vert_2} \sum_{i=1}^K \bar{w}_{i,j}(x)\, z_{s,\pi_i(x),j} \sim \mathcal{N}\bigl(\mu_j(x),\, \sigma_{e,j}^2(x)\bigr),
  }

  ##{
    \operatorname{Cov}\bigl(\tilde{f}_{s,j}(x),\, \tilde{f}_{s,j}(x')\bigr) = \frac{\sigma_{e,j}(x)\,\sigma_{e,j}(x')}{\Vert\bar{w}_j(x)\Vert_2\,\Vert\bar{w}_j(x')\Vert_2} \sum_{m \in N_K(x)\cap N_K(x')} \tilde{w}_{m,j}(x)\,\tilde{w}_{m,j}(x') \ge 0.
  }
}

\subtree{
  \title{Local-Scale Distances}

  \p{
    With #{d(x,x')=\Vert x-x'\Vert_2} and local radius #{\sigma(x)>0}:
  }

  \ul{
    \li{
      \strong{Conformal} ([[ZP04]](https://proceedings.neurips.cc/paper/2004/hash/40173ea48d9567f1f393b20c855bb40b-Abstract.html)):
      ##{
        \delta_c(x, x_m) = \frac{d^2(x, x_m)}{\sigma(x)\,\sigma(x_m)}.
      }
    }
    \li{
      \strong{Hyperbolic} (Poincaré half-space [[Bea83]](https://doi.org/10.1007/978-1-4612-1146-4), [[CFK+97]](https://library.slmath.org/books/Book31/files/cannon.pdf), [[NK17]](https://arxiv.org/abs/1705.08039)):
      ##{
        \delta_h(x, x_m) = \frac{d^2(x, x_m)}{2\,\sigma(x)\,\sigma(x_m)} + \frac{\bigl(\sigma(x) - \sigma(x_m)\bigr)^2}{2\,\sigma(x)\,\sigma(x_m)}.
      }
    }
    \li{
      \strong{Wasserstein} (hybrid):
      ##{
        \delta_w(x, x_m) = \frac{d^2(x, x_m)}{\sqrt{\sigma(x)\,\sigma(x_m)}} + \bigl(\sigma(x) - \sigma(x_m)\bigr)^2.
      }
    }
  }

  \pre{
import numpy as np
import baux

rng = np.random.default_rng(7)
basin_x = 0.6 + 0.04 * rng.normal(size=(24, 6))
shell_x = rng.uniform(-1.5, 1.5, size=(24, 6))
train_x = np.vstack([basin_x, shell_x])

signal = np.exp(-1.5 * np.sum((train_x - 0.6) ** 2, axis=1, keepdims=True))
train_yvar = np.vstack([np.full((24, 1), 5e-4), np.full((24, 1), 5e-2)])
train_y = signal + np.sqrt(train_yvar) * rng.normal(size=(48, 1))

k_fit, k_draw = baux.split(baux.key(11), 2)
enn_state = baux.with_geometry(
    baux.enn_init(train_x, train_y, train_yvar, scale_x=True),
    "hyperbolic",
    local_k=4,
)
params = baux.fit(enn_state, k=8, infer_aleatoric=False, key=k_fit)

queries = np.vstack([
    np.full((1, 6), 0.600),
    np.full((1, 6), 0.601),
    np.full((1, 6), 2.400),
])
post = baux.posterior(
    enn_state, queries, params, flags=baux.enn.PosteriorFlags(observation_noise=True)
)
draws, idx = baux.sample(enn_state, queries, params, key=k_draw, num_draws=64)

corr_basin = float(np.corrcoef(draws[0, 0], draws[1, 0])[0, 1])
assert np.all(idx[0] < 24)
assert post.se_epi[0, 0] < post.se_epi[2, 0]
assert np.allclose(post.se**2, post.se_epi**2 + post.se_ale**2)
assert corr_basin > 0.8
print(f"basin se_epi={post.se_epi[0, 0]:.4f} < far se_epi={post.se_epi[2, 0]:.4f} | draw_corr={corr_basin:.4f}")
  }
}
