\title{Neighborhood Surrogates}

\subtree{
  \title{Inverse-Variance Prediction from #{K} Nearest Neighbors}

  \p{
    Gaussian process surrogates factor an #{N \times N} kernel covariance matrix in #{\mathcal{O}(N^3)} time. Given #{N} noisy observations #{\mathcal{D} = \{(x_m, y_m, s_m)\}_{m=1}^N \subset \mathcal{X} \times \mathbb{R} \times \mathbb{R}_+} modeled as #{y_m = f(x_m) + s_m \varepsilon_m} with #{\varepsilon_m \stackrel{\text{i.i.d.}}{\sim} \mathcal{N}(0, 1)}, Epistemic Nearest Neighbors (Bafna et al. [[BJS25]](https://arxiv.org/abs/2506.12818)) forms local predictions at #{x \in \mathcal{X}} from a pairwise dissimilarity #{\delta : \mathcal{X} \times \mathcal{X} \to \mathbb{R}_+}, empirical target variance #{\hat{\sigma}_y^2 > 0}, and scale parameters #{\theta = (s_0^2, c_e) \in \mathbb{R}_+^2}. Each observation #{m} contributes an observation-noise variance and a distance-proportional epistemic variance:
  }

  ##{
    \mu(x \mid x_m) = y_m, \qquad
    \sigma_a^2(x \mid x_m) = \hat{\sigma}_y^2 s_0^2 + s_m^2, \qquad
    \sigma_e^2(x \mid x_m) = \hat{\sigma}_y^2 c_e\, \delta(x, x_m).
  }

  \p{
    Let #{N_K(x) = \{\pi_1(x), \dots, \pi_K(x)\}} list the #{K} nearest indices ordered by nondecreasing #{\delta(x, x_{\pi_i(x)})} (breaking ties by datum index), with inverse-variance weights #{w_i(x) = \bigl(\sigma_a^2(x \mid x_{\pi_i(x)}) + \sigma_e^2(x \mid x_{\pi_i(x)})\bigr)^{-1}}. An #{\mathcal{O}(N D + N \log K)} scan per query yields the local mean, aleatoric variance, and epistemic variance:
  }

  ##{
    \mu(x) = \frac{\sum_{i=1}^K w_i(x)\, y_{\pi_i(x)}}{\sum_{i=1}^K w_i(x)}, \qquad
    \sigma_a^2(x) = \frac{\sum_{i=1}^K w_i(x)\, \sigma_a^2(x \mid x_{\pi_i(x)})}{\sum_{i=1}^K w_i(x)}, \qquad
    \sigma_e^2(x) = \frac{1}{\sum_{i=1}^K w_i(x)},
  }

  \p{
    with total predictive variance #{\sigma^2(x) = \sigma_e^2(x) + \sigma_a^2(x)}. The scale parameters #{\theta = (s_0^2, c_e)} maximize a leave-one-out Gaussian log-likelihood over a subsample #{S_P \subset \{1, \dots, N\}} of size #{P \le N} [[BJS25]](https://arxiv.org/abs/2506.12818):
  }

  ##{
    \widehat{\log \mathcal{L}}(\theta) = -\frac{1}{2P} \sum_{n \in S_P} \left[\log\bigl(2\pi \sigma_{-n}^2(x_n; \theta)\bigr) + \frac{\bigl(y_n - \mu_{-n}(x_n; \theta)\bigr)^2}{\sigma_{-n}^2(x_n; \theta)}\right],
  }

  \p{
    where #{\mu_{-n}} and #{\sigma_{-n}^2} omit observation #{n} from its #{K}-neighbor set.
  }
}

\subtree{
  \title{Correlated Posterior Draws}

  \p{
    Thompson sampling over #{Q} candidate points requires function draws that covary across nearby queries without factoring a #{Q \times Q} joint covariance matrix. For draw #{s} and output channel #{j}, attaching one independent normal variable #{z_{s,m,j} \stackrel{\text{i.i.d.}}{\sim} \mathcal{N}(0, 1)} to each stored observation #{m \in \{1, \dots, N\}} couples queries through their shared neighbors.
  }

  \p{
    Let #{\bar{w}_{i,j}(x) = w_{i,j}(x) / \sum_{r=1}^K w_{r,j}(x)} denote normalized weights on #{N_K(x)}, extended to #{m \in \{1, \dots, N\}} by #{\tilde{w}_{m,j}(x) = \bar{w}_{i,j}(x)} when #{m = \pi_i(x)} and #{0} otherwise, and set #{\Vert\bar{w}_j(x)\Vert_2 = \bigl(\sum_{i=1}^K \bar{w}_{i,j}^2(x)\bigr)^{1/2}}. Rescaling the weighted sum of neighbor draws preserves the marginal epistemic variance #{\sigma_{e,j}^2(x)} at every #{x}:
  }

  ##{
    \tilde{f}_{s,j}(x) = \mu_j(x) + \frac{\sigma_{e,j}(x)}{\Vert\bar{w}_j(x)\Vert_2} \sum_{i=1}^K \bar{w}_{i,j}(x)\, z_{s,\pi_i(x),j} \sim \mathcal{N}\bigl(\mu_j(x),\, \sigma_{e,j}^2(x)\bigr).
  }

  \p{
    Sample paths vary smoothly inside each order-#{K} Voronoi cell where #{N_K(x)} is fixed, and any two queries with overlapping neighborhoods #{S_K(x, x') = N_K(x) \cap N_K(x') \ne \emptyset} share positive covariance:
  }

  ##{
    \operatorname{Cov}\bigl(\tilde{f}_{s,j}(x),\, \tilde{f}_{s,j}(x')\bigr) = \frac{\sigma_{e,j}(x)\,\sigma_{e,j}(x')}{\Vert\bar{w}_j(x)\Vert_2\,\Vert\bar{w}_j(x')\Vert_2} \sum_{m \in S_K(x, x')} \tilde{w}_{m,j}(x)\,\tilde{w}_{m,j}(x') > 0.
  }
}

\subtree{
  \title{Local-Scale Distances under Uneven Sampling}

  \p{
    Iterative search concentrates evaluations tightly inside active trust-region basins while leaving the rest of the domain sparsely sampled. Under plain Euclidean distance #{d(x, x') = \Vert x - x'\Vert_2}, a dense cluster can absorb coarse outer points into its #{K}-neighbor set or pull in distant exploratory queries. Letting #{\sigma(x) > 0} denote the distance from #{x} to its #{k_0}-th nearest observation in #{\mathcal{D}}, three rescaled dissimilarities adjust neighbor selection to local point spacing:
  }

  \ul{
    \li{
      \strong{Conformal scaling} (Zelnik-Manor & Perona [[ZP04]](https://proceedings.neurips.cc/paper/2004/hash/40173ea48d9567f1f393b20c855bb40b-Abstract.html)) divides squared Euclidean distance by the geometric mean of endpoint spacings:
      ##{
        \delta_c(x, x_m) = \frac{d^2(x, x_m)}{\sigma(x)\,\sigma(x_m)}.
      }
    }
    \li{
      \strong{Poincaré half-space distance} (Beardon [[Bea83]](https://doi.org/10.1007/978-1-4612-1146-4), Cannon et al. [[CFK+97]](https://library.slmath.org/books/Book31/files/cannon.pdf), Nickel & Kiela [[NK17]](https://arxiv.org/abs/1705.08039)) associates each point with #{(x, \sigma(x)) \in \mathcal{X} \times \mathbb{R}_+} under #{ds^2 = (\Vert dx\Vert_2^2 + d\sigma^2)/\sigma^2}. Evaluating #{\cosh d_{\mathbb{H}} - 1} adds a scale-difference penalty to conformal distance:
      ##{
        \delta_h(x, x_m) = \frac{d^2(x, x_m)}{2\,\sigma(x)\,\sigma(x_m)} + \frac{\bigl(\sigma(x) - \sigma(x_m)\bigr)^2}{2\,\sigma(x)\,\sigma(x_m)}.
      }
      When #{\sigma(x) \ll \sigma(x_m)}, the second term grows as #{\mathcal{O}(\sigma(x_m)/\sigma(x))}, keeping fine-scale basin neighborhoods separate from coarse outer points and preventing sparse queries from collapsing onto dense clusters.
    }
    \li{
      \strong{Hybrid transport dissimilarity}, motivated by Gaussian Bures–Wasserstein coupling (Gelbrich [[Gel90]](https://doi.org/10.1002/mana.19901470121), Villani [[Vil09]](https://doi.org/10.1007/978-3-540-71050-9), Peyré & Cuturi [[PC19]](https://doi.org/10.1561/2200000073)), combines root-geometric scaling with an additive spacing term:
      ##{
        \delta_w(x, x_m) = \frac{d^2(x, x_m)}{\sqrt{\sigma(x)\,\sigma(x_m)}} + \bigl(\sigma(x) - \sigma(x_m)\bigr)^2.
      }
    }
  }

  \p{
    The standalone functional interface ([baux.enn_init](docs.html#baux.enn_init), [baux.with_geometry](docs.html#baux.with_geometry), [baux.enn_fit](docs.html#baux.enn_fit), [baux.enn_posterior](docs.html#baux.enn_posterior), and [baux.enn_sample](docs.html#baux.enn_sample)) fits and queries these geometries directly. On a 6D design combining a dense low-noise basin with a sparse high-noise outer shell, hyperbolic distance selects in-basin neighbors, separates epistemic (\code{.se_epi}) from aleatoric (\code{.se_ale}) standard error, and produces correlated draws across adjacent basin queries:
  }

  \pre{
import numpy as np
import baux

rng = np.random.default_rng(7)
basin_x = 0.6 + 0.04 * rng.normal(size=(24, 6))
shell_x = rng.uniform(-1.5, 1.5, size=(24, 6))
train_x = np.vstack([basin_x, shell_x])

signal = np.exp(-1.5 * np.sum((train_x - 0.6) ** 2, axis=1, keepdims=True))
train_yvar = np.vstack([np.full((24, 1), 5e-4), np.full((24, 1), 5e-2)])
train_y = signal + np.sqrt(train_yvar) * rng.normal(size=(48, 1))

k_fit, k_draw = baux.split(baux.key(11), 2)
enn_state = baux.with_geometry(
    baux.enn_init(train_x, train_y, train_yvar, scale_x=True),
    "hyperbolic",
    local_k=4,
)
params = baux.enn_fit(enn_state, k=8, infer_aleatoric=False, key=k_fit)

queries = np.vstack([
    np.full((1, 6), 0.600),
    np.full((1, 6), 0.601),
    np.full((1, 6), 2.400),
])
post = baux.enn_posterior(
    enn_state, queries, params, flags=baux.enn.PosteriorFlags(observation_noise=True)
)
draws, idx = baux.enn_sample(enn_state, queries, params, key=k_draw, num_draws=64)

corr_basin = float(np.corrcoef(draws[0, 0], draws[1, 0])[0, 1])
assert np.all(idx[0] < 24)
assert post.se_epi[0, 0] < post.se_epi[2, 0]
assert np.allclose(post.se**2, post.se_epi**2 + post.se_ale**2)
assert corr_basin > 0.8
  }
}
