      \<tr>[data-symbol]{baux.turbo_enn}[data-kind]{function}[data-module]{baux.turbo.config}{
        \<td>{[\code{baux.turbo_enn}](#baux.turbo_enn)}
        \<td>{Preset factory returning an \code{OptimizerConfig} backed by an \code{ENNSurrogate}.}
      }
      \<tr>[data-symbol]{baux.turbo_one}[data-kind]{function}[data-module]{baux.turbo.config}{
        \<td>{[\code{baux.turbo_one}](#baux.turbo_one)}
        \<td>{Preset factory returning a \code{TuRBO-1} configuration backed by a Gaussian Process surrogate.}
      }
      \<tr>[data-symbol]{baux.turbo_zero}[data-kind]{function}[data-module]{baux.turbo.config}{
        \<td>{[\code{baux.turbo_zero}](#baux.turbo_zero)}
        \<td>{Preset factory returning a surrogate-free \code{TuRBO-0} configuration.}
      }
      \<tr>[data-symbol]{baux.lhd_only}[data-kind]{function}[data-module]{baux.turbo.config}{
        \<td>{[\code{baux.lhd_only}](#baux.lhd_only)}
        \<td>{Preset factory returning a global Latin Hypercube Design-only configuration.}
      }
      \<tr>[data-symbol]{baux.RegionalSearchPolicy}[data-kind]{class}[data-module]{baux.region}{
        \<td>{[\code{baux.RegionalSearchPolicy}](#baux.RegionalSearchPolicy)}
        \<td>{Multi-region search policy governing slot count, tolerances, observation sharing, and arm allocation.}
      }
      \<tr>[data-symbol]{baux.TrustRegionBounds}[data-kind]{class}[data-module]{baux.region}{
        \<td>{[\code{baux.TrustRegionBounds}](#baux.TrustRegionBounds)}
        \<td>{Validated side-length bounds \code{(length_init, length_min, length_max)} for trust-region controllers.}
      }
    }
  }

  \<div>[id]{baux.Transform}[class]{api-entry}[data-symbol]{baux.Transform}[data-kind]{class}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.Transform}](#baux.Transform)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.Transform(
    name: str,
    fn: Callable[..., OptimizerConfig],
)
    }
    \p{Frozen Optax-style combinator wrapping a pure configuration morphism \code{OptimizerConfig -> OptimizerConfig}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{name} (\em{str}) — Human-readable stage description (concatenated with \code{" | "} under composition).}
          \li{\code{fn} (\em{Callable}) — Pure function mapping an input [\code{OptimizerConfig}](#baux.OptimizerConfig) to an updated \code{OptimizerConfig}.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{__call__(config: OptimizerConfig | None = None) -> OptimizerConfig} — Apply \code{fn} to \code{config}, or to a fresh \code{OptimizerConfig()} when \code{config is None}.}
          \li{\code{__or__(other: Transform | Callable[..., OptimizerConfig]) -> Transform} — Left-to-right pipe operator \code{t1 | t2} returning \code{Transform(name, lambda cfg: other(self(cfg)))}.}
        }
      }
    }
  }

  \<div>[id]{baux.chain}[class]{api-entry}[data-symbol]{baux.chain}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.chain}](#baux.chain)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.chain(
    *steps: Transform | Callable[..., OptimizerConfig] | OptimizerConfig,
) -> OptimizerConfig
    }
    \p{Fold zero or more \code{Transform} stages (or base \code{OptimizerConfig} checkpoints) left-to-right into a materialized, cross-validated \code{OptimizerConfig}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{*steps} (\em{Transform | Callable | OptimizerConfig}) — Ordered configuration transforms; passing an \code{OptimizerConfig} resets the current base to that config before applying subsequent stages.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{OptimizerConfig} — Validated composite configuration.}
    }
  }

  \<div>[id]{baux.lhd}[class]{api-entry}[data-symbol]{baux.lhd}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.lhd}](#baux.lhd)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.lhd(num_init: int = 10, *, only: bool = False) -> Transform
    }
    \p{Configure stratified Latin Hypercube Design (\code{LHD}) warm-up evaluations, or pure global space-filling LHD exploration when \code{only=True}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{num_init} (\em{int}, default \code{10}) — Positive number of initial LHD points (\code{num_init > 0}).}
          \li{\code{only} (\em{bool}, keyword-only, default \code{False}) — When \code{True}, sets \code{NoTrustRegion()}, \code{LHDOnlyInit()}, \code{NoSurrogate()}, and \code{RandomAcquisitionConfig()}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Transform} — Pipeline stage updating \code{config.init} (and disabling surrogate/trust-region stages when \code{only=True}).}
    }
  }

  \<div>[id]{baux.sobol}[class]{api-entry}[data-symbol]{baux.sobol}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.sobol}](#baux.sobol)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.sobol(
    num_candidates: int | None = None,
    *,
    per_arm: int | None = None,
    num_pert: int | None = None,
) -> Transform
    }
    \p{Configure scrambled Joe–Kuo D6 Sobol quasi-Monte Carlo candidate generation (\code{CandidateSampler.SOBOL}) inside the active trust region.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{num_candidates} (\em{int | None}, default \code{None}) — Explicit candidate pool size (\code{> 0}); when \code{None}, defaults dynamically to \code{min(5000, 100 * D)}.}
          \li{\code{per_arm} (\em{int | None}, keyword-only, default \code{None}) — Minimum candidates per requested arm (\code{max(base, per_arm * num_arms)}).}
          \li{\code{num_pert} (\em{int | None}, keyword-only, default \code{None}) — Expected perturbed coordinate count when masked Sobol perturbation is active (e.g., MORBO).}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Transform} — Candidate sampler configuration stage.}
    }
  }

  \<div>[id]{baux.raasp}[class]{api-entry}[data-symbol]{baux.raasp}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.raasp}](#baux.raasp)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.raasp(
    num_pert: int | None = 20,
    *,
    num_candidates: int | None = None,
    per_arm: int | None = None,
    driver: RAASPDriver = RAASPDriver.ORIG,
) -> Transform
    }
    \p{Configure Random Axis-Aligned Subspace Perturbation (\code{CandidateSampler.RAASP}) around the trust-region incumbent for high-dimensional search spaces.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{num_pert} (\em{int | None}, default \code{20}) — Target number of perturbed coordinates per candidate (\code{> 0}).}
          \li{\code{num_candidates} (\em{int | None}, keyword-only, default \code{None}) — Total candidate pool size override (\code{min(5000, 100 * D)} when \code{None}).}
          \li{\code{per_arm} (\em{int | None}, keyword-only, default \code{None}) — Minimum candidate count per proposed arm.}
          \li{\code{driver} (\em{RAASPDriver}, keyword-only, default \code{RAASPDriver.ORIG}) — Mask generation kernel (\code{RAASPDriver.ORIG} or \code{RAASPDriver.FAST}, imported from \code{baux.turbo.config}).}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Transform} — RAASP candidate generation stage.}
      \<dt>{Notes}
      \<dd>{\code{RAASPDriver.ORIG} perturbs a deterministic count of \code{min(max(1, num_pert), D)} coordinates per candidate row via partial Fisher–Yates sampling without replacement (\code{O(num_pert)} time per candidate). \code{RAASPDriver.FAST} draws a stochastic perturbation count \code{max(1, Binomial(D, min(num_pert / D, 1.0)))} per row before selecting coordinates without replacement and sampling uniformly within trust-region bounds. When \code{tied_dims} are present from manifold embeddings, multi-column leaf groups are selected and perturbed as atomic units.}
    }
  }

  \<div>[id]{baux.uniform_pert}[class]{api-entry}[data-symbol]{baux.uniform_pert}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.uniform_pert}](#baux.uniform_pert)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.uniform_pert(
    num_candidates: int | None = None,
    *,
    per_arm: int | None = None,
    num_pert: int | None = None,
) -> Transform
    }
    \p{Configure independent uniform random candidate sampling (\code{CandidateSampler.UNIFORM}) across all coordinates of the active trust-region box.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{num_candidates} (\em{int | None}, default \code{None}) — Total candidate pool size (\code{min(5000, 100 * D)} when \code{None}).}
          \li{\code{per_arm} (\em{int | None}, keyword-only, default \code{None}) — Minimum candidates per arm.}
          \li{\code{num_pert} (\em{int | None}, keyword-only, default \code{None}) — Optional perturbation parameter retained on \code{CandidateConfig}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Transform} — Uniform candidate generation stage.}
    }
  }

  \<div>[id]{baux.enn}[class]{api-entry}[data-symbol]{baux.enn}[data-kind]{function}[data-module]{baux.enn}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.enn}](#baux.enn)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.enn(
    *,
    k: int | None = 10,
    num_samples: int | None = 100,
    scale_x: bool = False,
    index: NeighborIndex | str = NeighborIndex.FLAT,
    storage: str | None = None,
    metric_learning: str = "none",
    geometry: str = "euclidean",
    local_k: int = 4,
    stiefel: Stiefel | np.ndarray | None = None,
    affine: Affine | tuple[Any, Any, Any] | None = None,
    tied_dims: tuple[tuple[int, ...], ...] | None = None,
) -> Transform
    }
    \p{Configure the Epistemic Nearest Neighbors (\code{ENNSurrogate}) stage in an optimization pipeline. \code{baux.enn} also serves as a callable module namespace re-exporting standalone ENN types and functions.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{k} (\em{int | None}, keyword-only, default \code{10}) — Nearest-neighbor count \code{K} for inverse-variance moment aggregation.}
          \li{\code{num_samples} (\em{int | None}, keyword-only, default \code{100}) — Subsampled LOO rows used when fitting \code{(epistemic_scale, aleatoric_scale)}; \code{None} disables scale fitting for parameter-free Pareto selection.}
          \li{\code{scale_x} (\em{bool}, keyword-only, default \code{False}) — Standardize input columns by empirical standard deviation (must be \code{False} when \code{metric_learning="auto"}).}
          \li{\code{index} (\em{NeighborIndex | str}, keyword-only, default \code{NeighborIndex.FLAT}) — Index backend: [\code{NeighborIndex}](#baux.NeighborIndex) or \code{"exact"}/\code{"flat"}, \code{"hnsw"}/\code{"usearch"}, \code{"tree"}/\code{"bpann"}/\code{"bpann_disk"}, \code{"metal"}, \code{"cuda"}, \code{"auto"}.}
          \li{\code{storage} (\em{str | None}, keyword-only, default \code{None}) — Storage backend (\code{"memory"} or \code{"disk"}).}
          \li{\code{metric_learning} (\em{str}, keyword-only, default \code{"none"}) — Automatic held-out LOO diagonal metric learning (\code{"none"} or \code{"auto"}).}
          \li{\code{geometry} (\em{str}, keyword-only, default \code{"euclidean"}) — Pairwise dissimilarity geometry: \code{"euclidean"}, \code{"conformal"}, \code{"hyperbolic"}, or \code{"wasserstein"}.}
          \li{\code{local_k} (\em{int}, keyword-only, default \code{4}) — Neighbor rank (\code{>= 1}) for local-scale estimation in non-Euclidean geometries.}
          \li{\code{stiefel} (\em{Stiefel | np.ndarray | None}, keyword-only, default \code{None}) — Optional [\code{Stiefel}](#baux.Stiefel) frame for multi-output James–Stein contraction.}
          \li{\code{affine} (\em{Affine | tuple | None}, keyword-only, default \code{None}) — Optional [\code{Affine}](#baux.Affine) posterior location-scale map.}
          \li{\code{tied_dims} (\em{tuple[tuple[int, ...], ...] | None}, keyword-only, default \code{None}) — Tied coordinate groups sharing a single learned metric weight.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Transform} — Stage attaching \code{ENNSurrogate} and promoting \code{RandomAcquisitionConfig} to \code{UCBAcquisitionConfig} (when \code{num_samples is not None}) or \code{ParetoAcquisitionConfig} (when \code{num_samples is None}).}
      \<dt>{Notes}
      \<dd>{Precision weights apply a relative variance floor \code{eps_var = 1e-9 * sigma_y**2} (\code{ENN._EPS_VAR = 1e-9}) to prevent singular weights at noiseless zero-distance queries.}
    }
  }

  \<div>[id]{baux.gp}[class]{api-entry}[data-symbol]{baux.gp}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.gp}](#baux.gp)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.gp() -> Transform
    }
    \p{Configure an exact ARD Gaussian Process surrogate (\code{GaussianProcess()}, \code{TuRBO-1}), promoting \code{RandomAcquisitionConfig} to Thompson posterior-draw acquisition.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Returns}
      \<dd>{\code{Transform} — GP surrogate configuration stage.}
    }
  }

  \<div>[id]{baux.zero}[class]{api-entry}[data-symbol]{baux.zero}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.zero}](#baux.zero)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.zero() -> Transform
    }
    \p{Configure surrogate-free \code{TuRBO-zero} optimization (\code{NoSurrogate()}, \code{RandomAcquisitionConfig()}), promoting \code{NoTrustRegion} to \code{TurboTrustRegion()} for zero-overhead high-dimensional direct policy search.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Returns}
      \<dd>{\code{Transform} — Surrogate-free trust-region stage.}
    }
  }

  \<div>[id]{baux.ucb}[class]{api-entry}[data-symbol]{baux.ucb}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.ucb}](#baux.ucb)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.ucb(beta: float = 2.0) -> Transform
    }
    \p{Configure Upper Confidence Bound acquisition scoring candidates by \code{mu(x) + beta * se(x)}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{beta} (\em{float}, default \code{2.0}) — Strictly positive exploration weight (\code{beta > 0}).}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Transform} — UCB acquisition stage (attaching \code{ENNSurrogate(k=10, num_samples=100)} if the current surrogate is \code{NoSurrogate}).}
    }
  }

  \<div>[id]{baux.thompson}[class]{api-entry}[data-symbol]{baux.thompson}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.thompson}](#baux.thompson)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.thompson() -> Transform
    }
    \p{Configure Thompson sampling (\code{DrawAcquisitionConfig()}) selecting each batch arm as the maximizer of an independent coherent posterior function draw.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Returns}
      \<dd>{\code{Transform} — Posterior-draw acquisition stage (ensuring LOO hyperparameter fitting with \code{num_samples=100} when paired with \code{NoSurrogate} or unfitted \code{ENNSurrogate}).}
    }
  }

  \<div>[id]{baux.pareto}[class]{api-entry}[data-symbol]{baux.pareto}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.pareto}](#baux.pareto)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.pareto() -> Transform
    }
    \p{Configure hyperparameter-free bi-objective \code{(mu(x), se(x))} Pareto front acquisition via Non-Dominated Sorting (\code{ParetoAcquisitionConfig()}, \code{NDSOptimizerConfig()}).}
    \<dl>[class]{api-spec-list}{
      \<dt>{Returns}
      \<dd>{\code{Transform} — Pareto acquisition stage (attaching \code{ENNSurrogate(k=10)} if the current surrogate is \code{NoSurrogate}).}
    }
  }

  \<div>[id]{baux.random_acq}[class]{api-entry}[data-symbol]{baux.random_acq}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.random_acq}](#baux.random_acq)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.random_acq() -> Transform
    }
    \p{Configure uniform random arm selection from generated trust-region candidates (\code{RandomAcquisitionConfig()}).}
    \<dl>[class]{api-spec-list}{
      \<dt>{Returns}
      \<dd>{\code{Transform} — Random acquisition stage.}
    }
  }

  \<div>[id]{baux.tr_bounds}[class]{api-entry}[data-symbol]{baux.tr_bounds}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.tr_bounds}](#baux.tr_bounds)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.tr_bounds(
    *,
    length_init: float = 0.8,
    length_min: float = 0.5**7,
    length_max: float = 1.6,
) -> Transform
    }
    \p{Configure unit-cube trust-region side-length bounds on a single-region \code{TurboTrustRegion} or existing \code{RegionalSearchPolicy}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{length_init} (\em{float}, keyword-only, default \code{0.8}) — Initial side length (\code{length_min <= length_init <= length_max}).}
          \li{\code{length_min} (\em{float}, keyword-only, default \code{0.0078125}) — Restart threshold side length (\code{0 < length_min < length_max}).}
          \li{\code{length_max} (\em{float}, keyword-only, default \code{1.6}) — Upper expansion cap.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Transform} — Trust-region bounds modifier.}
    }
  }

  \<div>[id]{baux.regions}[class]{api-entry}[data-symbol]{baux.regions}[data-kind]{function}[data-module]{baux.transforms}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.regions}](#baux.regions)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.regions(
    count: int = 4,
    *,
    sharing: str = "ellipsoid_ball",
    allocation: str = "incumbent_ucb1",
    success_tolerance: int = 3,
    failure_tolerance: int = 5,
    length: TrustRegionBounds | None = None,
) -> Transform
    }
    \p{Configure multi-region portfolio optimization ([\code{RegionalSearchPolicy}](#baux.RegionalSearchPolicy)) maintaining \code{count} concurrent local trust regions.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{count} (\em{int}, default \code{4}) — Number of concurrent regional slots (\code{count >= 1}).}
          \li{\code{sharing} (\em{str}, keyword-only, default \code{"ellipsoid_ball"}) — Cross-region observation adoption policy: \code{"ellipsoid_ball"}, \code{"box_contain"}, \code{"nearest_center"}, or \code{"origin_only"}.}
          \li{\code{allocation} (\em{str}, keyword-only, default \code{"incumbent_ucb1"}) — Arm budget routing policy: \code{"incumbent_ucb1"}, \code{"least_trials"}, or \code{"joint_acquisition"}.}
          \li{\code{success_tolerance} (\em{int}, keyword-only, default \code{3}) — Consecutive improving completions required before doubling a region's side length.}
          \li{\code{failure_tolerance} (\em{int}, keyword-only, default \code{5}) — Consecutive non-improving completions tolerated before halving a region's side length.}
          \li{\code{length} (\em{TrustRegionBounds | None}, keyword-only, default \code{None}) — Explicit [\code{TrustRegionBounds}](#baux.TrustRegionBounds) (inherits any prior \code{tr_bounds} when \code{None}).}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Transform} — Multi-region policy stage.}
    }
  }

  \<div>[id]{baux.with_geometry}[class]{api-entry}[data-symbol]{baux.with_geometry}[data-kind]{function}[data-module]{baux.enn}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.with_geometry}](#baux.with_geometry)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.with_geometry(
    model: ENNState | ENN | OptimizerConfig | Transform | OptimizerState,
    geometry: str,
    local_k: int = 4,
) -> Any
    }
    \p{Return a copy-on-write state, surrogate, config, or composed \code{Transform} equipped with a local-scale Riemannian dissimilarity geometry.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{model} (\em{ENNState | ENN | OptimizerConfig | Transform | OptimizerState}) — Target object to equip with \code{geometry}.}
          \li{\code{geometry} (\em{str}) — Dissimilarity family: \code{"euclidean"}, \code{"conformal"} (Zelnik-Manor & Perona local scaling), \code{"hyperbolic"} (Poincaré half-space), or \code{"wasserstein"} (local Gaussian optimal transport).}
          \li{\code{local_k} (\em{int}, default \code{4}) — Positive neighbor rank (\code{local_k >= 1}) defining local scale radii.}
        }
      }
      \<dt>{Returns}
      \<dd>{Updated instance matching \code{model}'s type without mutating functional snapshots.}
    }
  }

  \<div>[id]{baux.stein}[class]{api-entry}[data-symbol]{baux.stein}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.stein}](#baux.stein)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.stein(
    target: Any = None,
    frame: Stiefel | np.ndarray | int | None = None,
    *,
    rank: int | None = None,
) -> Transform | ENNState | ENN | OptimizerConfig | OptimizerState
    }
    \p{Configure Empirical-Bayes James–Stein orthogonal-subspace contraction toward a [\code{Stiefel}](#baux.Stiefel) frame or top-\code{rank} empirical target covariance subspace.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{target} (\em{ENNState | ENN | OptimizerConfig | Transform | OptimizerState | Stiefel | int | None}, default \code{None}) — Target state/config/transform to update, or a \code{Stiefel} frame / integer \code{rank} when called as a standalone pipeline constructor (e.g., \code{baux.stein(rank=4)} or \code{baux.stein(frame)}).}
          \li{\code{frame} (\em{Stiefel | np.ndarray | int | None}, default \code{None}) — Explicit \code{(M, F)} Stiefel loadings or subspace rank when \code{target} is a state, model, or config.}
          \li{\code{rank} (\em{int | None}, keyword-only, default \code{None}) — Principal covariance subspace dimension \code{1 <= rank <= M} estimated from observed \code{y}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Transform} when called without a state/config target, or an updated copy of \code{target}.}
    }
  }

  \<div>[id]{baux.calibrate}[class]{api-entry}[data-symbol]{baux.calibrate}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.calibrate}](#baux.calibrate)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.calibrate(
    target: Any = None,
    affine: Affine | float | None = None,
    *,
    alpha: float | None = None,
) -> Transform | ENNState | ENN | OptimizerConfig | OptimizerState
    }
    \p{Attach an [\code{Affine}](#baux.Affine) location-scale map \code{(a + b * mu, c * se)} or online leave-one-out WLS plus conformal residual scaling.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{target} (\em{ENNState | ENN | OptimizerConfig | Transform | OptimizerState | Affine | float | None}, default \code{None}) — Target state/config/transform to update, or an \code{Affine} map / miscoverage rate \code{alpha} when constructing a pipeline \code{Transform} (e.g., \code{baux.calibrate(alpha=0.1)}).}
          \li{\code{affine} (\em{Affine | tuple | float | None}, default \code{None}) — Pre-fitted \code{Affine} map or miscoverage rate when \code{target} is a state, model, or config.}
          \li{\code{alpha} (\em{float | None}, keyword-only, default \code{None}) — Miscoverage rate in \code{(0, 1)} for order-statistic standard-error scaling (\code{0.0} fits WLS dispersion without quantile inflation).}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Transform} when called as a pipeline stage constructor, or an updated copy of \code{target}.}
      \<dt>{Notes}
      \<dd>{Finite-sample distribution-free marginal coverage \code{1 - alpha} holds when an \code{Affine} map is calibrated via \code{Affine.conformal_scale} on an exchangeable held-out calibration split. When applied online to adaptively collected optimization histories, LOO residual quantile scaling serves as an empirical uncertainty-recalibration heuristic because adaptive sequential sampling is non-exchangeable.}
    }
  }

  \<div>[id]{baux.OptimizerConfig}[class]{api-entry}[data-symbol]{baux.OptimizerConfig}[data-kind]{class}[data-module]{baux.turbo.config}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.OptimizerConfig}](#baux.OptimizerConfig)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.OptimizerConfig(
    trust_region: TrustRegionConfig = TurboTrustRegion(),
    candidates: CandidateConfig = CandidateConfig(),
    init: InitConfig = InitConfig(),
    surrogate: Surrogate = NoSurrogate(),
    acquisition: AcquisitionConfig = RandomAcquisitionConfig(),
    acq_optimizer: AcqOptimizerConfig = RAASPOptimizerConfig(),
    observation_history: ObservationHistoryConfig = ObservationHistoryConfig(),
)
    }
    \p{Immutable composite dataclass specifying every stage of a single-region TuRBO, multi-objective MORBO, or multi-region portfolio optimizer.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{trust_region} (\em{NoTrustRegion | TurboTrustRegion | MorboTrustRegion | RegionalSearchPolicy}) — Trust-region controller policy.}
          \li{\code{candidates} (\em{CandidateConfig}) — Candidate sampler (\code{SOBOL}, \code{RAASP}, \code{UNIFORM}), pool count, perturbation width, and \code{tied_dims}.}
          \li{\code{init} (\em{InitConfig}) — Warm-up strategy (\code{HybridInit} or \code{LHDOnlyInit}) and \code{num_init} budget.}
          \li{\code{surrogate} (\em{NoSurrogate | GaussianProcess | ENNSurrogate | ExternalSurrogate}) — Surrogate model specification.}
          \li{\code{acquisition} (\em{UCBAcquisitionConfig | DrawAcquisitionConfig | ParetoAcquisitionConfig | RandomAcquisitionConfig}) — Candidate scoring rule.}
          \li{\code{acq_optimizer} (\em{RAASPOptimizerConfig | NDSOptimizerConfig}) — Discrete candidate selection reducer.}
          \li{\code{observation_history} (\em{ObservationHistoryConfig}) — History retention settings.}
          \li{\code{num_metrics} (\em{int | None}) — Number of objective metrics when \code{trust_region} is \code{MorboTrustRegion}, else \code{None}.}
          \li{\code{candidate_sampler} (\em{CandidateSampler}) — Shortcut for \code{candidates.sampler}.}
          \li{\code{num_candidates} (\em{int | None}) — Shortcut for \code{candidates.num_candidates}.}
          \li{\code{raasp_driver} (\em{RAASPDriver}) — Shortcut for \code{candidates.raasp_driver}.}
        }
      }
      \<dt>{Raises}
      \<dd>{\code{ValueError} or \code{TypeError} on incompatible stage combinations (e.g., \code{NoSurrogate} paired with \code{UCB}/\code{Thompson}, \code{ParetoAcquisitionConfig} without \code{NDSOptimizerConfig}, \code{LHDOnlyInit} with a surrogate, or non-\code{SQUARED_L2} ENN metric inside the native optimizer).}
    }
  }

  \<div>[id]{baux.turbo_enn}[class]{api-entry}[data-symbol]{baux.turbo_enn}[data-kind]{function}[data-module]{baux.turbo.config}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.turbo_enn}](#baux.turbo_enn)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.turbo_enn(
    *,
    enn: ENNSurrogate | None = None,
    trust_region: TrustRegionConfig | None = None,
    candidates: CandidateConfig | None = None,
    num_init: int | None = None,
    acquisition: AcquisitionKind = AcquisitionKind.PARETO,
) -> OptimizerConfig
    }
    \p{Preset factory constructing a TuRBO [\code{OptimizerConfig}](#baux.OptimizerConfig) backed by an \code{ENNSurrogate}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{enn} (\em{ENNSurrogate | None}, keyword-only, default \code{None}) — Custom \code{ENNSurrogate} instance (defaults to \code{ENNSurrogate()}; note \code{enn.fit.num_samples} must be set if \code{acquisition} is \code{UCB} or \code{THOMPSON}).}
          \li{\code{trust_region} (\em{TrustRegionConfig | None}, keyword-only, default \code{None}) — Defaults to \code{TurboTrustRegion()}.}
          \li{\code{candidates} (\em{CandidateConfig | None}, keyword-only, default \code{None}) — Defaults to \code{CandidateConfig()}.}
          \li{\code{num_init} (\em{int | None}, keyword-only, default \code{None}) — Warm-up evaluation count (\code{10} when \code{None}).}
          \li{\code{acquisition} (\em{AcquisitionKind}, keyword-only, default \code{AcquisitionKind.PARETO}) — One of \code{AcquisitionKind.PARETO}, \code{AcquisitionKind.UCB}, or \code{AcquisitionKind.THOMPSON}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{OptimizerConfig} — Validated TuRBO-ENN configuration.}
    }
  }

  \<div>[id]{baux.turbo_one}[class]{api-entry}[data-symbol]{baux.turbo_one}[data-kind]{function}[data-module]{baux.turbo.config}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.turbo_one}](#baux.turbo_one)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.turbo_one(
    *,
    num_candidates: int | None = None,
    num_init: int | None = None,
    trust_region: TrustRegionConfig | None = None,
    sampler: CandidateSampler = CandidateSampler.SOBOL,
    acquisition: AcquisitionKind = AcquisitionKind.THOMPSON,
) -> OptimizerConfig
    }
    \p{Preset factory constructing a standard \code{TuRBO-1} configuration backed by an exact Gaussian Process surrogate and Thompson sampling.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Returns}
      \<dd>{\code{OptimizerConfig} — Validated \code{TuRBO-1} configuration.}
    }
  }

  \<div>[id]{baux.turbo_zero}[class]{api-entry}[data-symbol]{baux.turbo_zero}[data-kind]{function}[data-module]{baux.turbo.config}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.turbo_zero}](#baux.turbo_zero)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.turbo_zero(
    *,
    num_candidates: int | None = None,
    num_candidates_per_arm: int | None = None,
    num_init: int | None = None,
    trust_region: TrustRegionConfig | None = None,
    sampler: CandidateSampler = CandidateSampler.SOBOL,
) -> OptimizerConfig
    }
    \p{Preset factory constructing a surrogate-free \code{TuRBO-0} configuration combining adaptive trust-region side lengths with random candidate acquisition.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Returns}
      \<dd>{\code{OptimizerConfig} — Validated \code{TuRBO-0} configuration.}
    }
  }

  \<div>[id]{baux.lhd_only}[class]{api-entry}[data-symbol]{baux.lhd_only}[data-kind]{function}[data-module]{baux.turbo.config}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.lhd_only}](#baux.lhd_only)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.lhd_only(
    *,
    num_candidates: int | None = None,
    num_init: int | None = None,
    trust_region: TrustRegionConfig | None = None,
    sampler: CandidateSampler = CandidateSampler.SOBOL,
) -> OptimizerConfig
    }
    \p{Preset factory constructing a pure global Latin Hypercube Design (\code{LHDOnlyInit}, \code{NoTrustRegion}, \code{NoSurrogate}) baseline configuration.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Returns}
      \<dd>{\code{OptimizerConfig} — Validated LHD-only configuration.}
    }
  }

  \<div>[id]{baux.RegionalSearchPolicy}[class]{api-entry}[data-symbol]{baux.RegionalSearchPolicy}[data-kind]{class}[data-module]{baux.region}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.RegionalSearchPolicy}](#baux.RegionalSearchPolicy)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.RegionalSearchPolicy(
    count: int = 4,
    length: TrustRegionBounds = TrustRegionBounds(),
    success_tolerance: int = 3,
    failure_tolerance: int = 5,
    sharing: Literal["box_contain", "ellipsoid_ball", "nearest_center", "origin_only"] = "box_contain",
    allocation: Literal["incumbent_ucb1", "least_trials", "joint_acquisition"] = "incumbent_ucb1",
    restart_memory: Literal["fresh", "retain_relevant"] = "fresh",
    restart_center: RestartCenterPolicy = RestartCenterPolicy(),
    controller: Literal["turbo", "fixed_radius"] = "turbo",
    acquisitions: tuple[AcquisitionConfig | None, ...] = (),
)
    }
    \p{Frozen policy record configuring multi-region portfolio optimization (\code{TuRBO-M}), cross-region observation sharing, bandit slot routing, and regional restart behavior.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{count} (\em{int}) — Number of concurrent regional slots (\code{count > 0}).}
          \li{\code{length} (\em{TrustRegionBounds}) — Side-length bounds shared across regional controllers (also exposed via properties \code{length_init}, \code{length_min}, \code{length_max}).}
          \li{\code{success_tolerance} / \code{failure_tolerance} (\em{int}) — Positive streak thresholds for side-length expansion (\code{2x}) and contraction (\code{0.5x}).}
          \li{\code{sharing} (\em{str}) — Observation relevance rule: \code{"box_contain"}, \code{"ellipsoid_ball"}, \code{"nearest_center"}, or \code{"origin_only"}.}
          \li{\code{allocation} (\em{str}) — Candidate/arm routing rule across slots: \code{"incumbent_ucb1"}, \code{"least_trials"}, or \code{"joint_acquisition"}.}
          \li{\code{restart_memory} (\em{str}) — Local surrogate retention on slot restart (\code{"fresh"} or \code{"retain_relevant"}).}
          \li{\code{restart_center} (\em{RestartCenterPolicy}) — Automatic restart-center selection policy (\code{candidates: int = 1}, \code{selection: "first" | "maximin"}).}
          \li{\code{controller} (\em{str}) — Radius update rule (\code{"turbo"} or \code{"fixed_radius"}).}
          \li{\code{acquisitions} (\em{tuple[AcquisitionConfig | None, ...]}) — Optional per-slot acquisition overrides (empty tuple or length \code{count}).}
        }
      }
    }
  }

  \<div>[id]{baux.TrustRegionBounds}[class]{api-entry}[data-symbol]{baux.TrustRegionBounds}[data-kind]{class}[data-module]{baux.region}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.TrustRegionBounds}](#baux.TrustRegionBounds)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.TrustRegionBounds(
    length_init: float = 0.8,
    length_min: float = 0.5**7,
    length_max: float = 1.6,
)
    }
    \p{Frozen record enforcing side-length invariants \code{0 < length_min <= length_init <= length_max} and \code{length_min < length_max} in normalized unit-cube coordinates.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{length_init} (\em{float}, default \code{0.8}) — Initial trust-region side length.}
          \li{\code{length_min} (\em{float}, default \code{0.0078125}) — Minimum side length triggering region restart.}
          \li{\code{length_max} (\em{float}, default \code{1.6}) — Maximum side length cap.}
        }
      }
    }
  }
}

\subtree{
  \title{Spaces, PyTrees & Codomain Operators}

  \<table>[class]{api-summary-table}{
    \<thead>{
      \<tr>{
        \<th>{Symbol}
        \<th>{Summary}
      }
    }
    \<tbody>{
      \<tr>[data-symbol]{baux.Space}[data-kind]{class}[data-module]{baux.pytree}{
        \<td>{[\code{baux.Space}](#baux.Space)}
        \<td>{Domain specification alias for \code{PyTreeSpec} compiling nested parameter trees.}
      }
      \<tr>[data-symbol]{baux.PyTreeSpec}[data-kind]{class}[data-module]{baux.pytree}{
        \<td>{[\code{baux.PyTreeSpec}](#baux.PyTreeSpec)}
        \<td>{Compiled immutable parameter-space specification with bounds, leaf offsets, and tied manifold groups.}
      }
      \<tr>[data-symbol]{baux.LeafSpec}[data-kind]{class}[data-module]{baux.pytree}{
        \<td>{[\code{baux.LeafSpec}](#baux.LeafSpec)}
        \<td>{Metadata descriptor for a single leaf inside a \code{PyTreeSpec}.}
      }
      \<tr>[data-symbol]{baux.pytree_bounds}[data-kind]{function}[data-module]{baux.pytree}{
        \<td>{[\code{baux.pytree_bounds}](#baux.pytree_bounds)}
        \<td>{Compile a nested PyTree of arrays, shape tuples, and manifold charts into a \code{PyTreeSpec}.}
      }
      \<tr>[data-symbol]{baux.ravel}[data-kind]{function}[data-module]{baux.pytree}{
        \<td>{[\code{baux.ravel}](#baux.ravel)}
        \<td>{Encode and flatten a single PyTree into \code{(D,)} or a batch of PyTrees into \code{(N, D)}.}
      }
      \<tr>[data-symbol]{baux.unflatten}[data-kind]{function}[data-module]{baux.pytree}{
        \<td>{[\code{baux.unflatten}](#baux.unflatten)}
        \<td>{Decode a 1D flat coordinate vector \code{(D,)} into a single structured parameter PyTree.}
      }
      \<tr>[data-symbol]{baux.unflatten_batch}[data-kind]{function}[data-module]{baux.pytree}{
        \<td>{[\code{baux.unflatten_batch}](#baux.unflatten_batch)}
        \<td>{Decode a 2D \code{(N, D)} coordinate matrix into a \code{tuple} of \code{N} structured PyTrees.}
      }
      \<tr>[data-symbol]{baux.unflatten_stacked}[data-kind]{function}[data-module]{baux.pytree}{
        \<td>{[\code{baux.unflatten_stacked}](#baux.unflatten_stacked)}
        \<td>{Decode a 2D \code{(N, D)} coordinate matrix into a single PyTree with batch-stacked leaves.}
      }
      \<tr>[data-symbol]{baux.Log}[data-kind]{class}[data-module]{baux.pytree}{
        \<td>{[\code{baux.Log}](#baux.Log)}
        \<td>{Scale-invariant multiplicative logarithmic chart on \code{[low, high]} for strictly positive parameters.}
      }
      \<tr>[data-symbol]{baux.Periodic}[data-kind]{class}[data-module]{baux.pytree}{
        \<td>{[\code{baux.Periodic}](#baux.Periodic)}
        \<td>{Isometric 2-column circular trigonometric chart mapping angular phases on \code{[low, high]} modulo period onto \code{S^1}.}
      }
      \<tr>[data-symbol]{baux.Simplex}[data-kind]{class}[data-module]{baux.pytree}{
        \<td>{[\code{baux.Simplex}](#baux.Simplex)}
        \<td>{Fisher–Rao / Hellinger square-root chart on the \code{dim}-component probability simplex.}
      }
      \<tr>[data-symbol]{baux.Categorical}[data-kind]{class}[data-module]{baux.pytree}{
        \<td>{[\code{baux.Categorical}](#baux.Categorical)}
        \<td>{Isometric one-hot or Rademacher Johnson–Lindenstrauss discrete categorical codebook.}
      }
      \<tr>[data-symbol]{baux.categorical}[data-kind]{function}[data-module]{baux.pytree}{
        \<td>{[\code{baux.categorical}](#baux.categorical)}
        \<td>{Functional constructor building a \code{Categorical} leaf chart from any non-empty sequence.}
      }
      \<tr>[data-symbol]{baux.Stiefel}[data-kind]{class}[data-module]{baux.pytree}{
        \<td>{[\code{baux.Stiefel}](#baux.Stiefel)}
        \<td>{Orthonormal \code{(M, F)} Stiefel subspace frame implementing multi-output James–Stein contraction.}
      }
      \<tr>[data-symbol]{baux.Affine}[data-kind]{class}[data-module]{baux.pytree}{
        \<td>{[\code{baux.Affine}](#baux.Affine)}
        \<td>{Per-metric \code{(a + b * mu, c * se)} posterior location-scale map with OLS/WLS and conformal scaling.}
      }
    }
  }

  \<div>[id]{baux.Space}[class]{api-entry}[data-symbol]{baux.Space}[data-kind]{class}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.Space}](#baux.Space)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.Space = baux.PyTreeSpec
    }
    \p{Top-level alias for [\code{baux.PyTreeSpec}](#baux.PyTreeSpec). Calling \code{baux.Space(tree, low=-1.0, high=1.0)} compiles a nested parameter template directly into a \code{PyTreeSpec}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Notes}
      \<dd>{Identical in type, attributes, and methods to [\code{baux.PyTreeSpec}](#baux.PyTreeSpec) (\code{baux.Space is baux.PyTreeSpec}).}
    }
  }

  \<div>[id]{baux.PyTreeSpec}[class]{api-entry}[data-symbol]{baux.PyTreeSpec}[data-kind]{class}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.PyTreeSpec}](#baux.PyTreeSpec)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.PyTreeSpec(
    dim: Any,
    bounds: Any = None,
    leaves: tuple[LeafSpec, ...] | None = None,
    template: Any = None,
    *,
    low: Any = -1.0,
    high: Any = 1.0,
) -> PyTreeSpec
    }
    \p{Immutable compiled domain specification describing leaf traversal paths, manifold chart encodings, flat coordinate bounds, and tied coordinate groups.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{dim} (\em{int}) — Total flat solver coordinate dimension \code{D}.}
          \li{\code{bounds} (\em{np.ndarray}) — Read-only \code{(D, 2)} \code{float64} matrix of embedded coordinate bounds.}
          \li{\code{leaves} (\em{tuple[LeafSpec, ...]}) — Ordered [\code{LeafSpec}](#baux.LeafSpec) descriptors in depth-first traversal order.}
          \li{\code{template} (\em{Any}) — Original container template (mappings, tuples, lists, namedtuples, dataclasses).}
          \li{\code{tied_dims} (\em{tuple[tuple[int, ...], ...]}) — Column-index groups for multi-column manifold leaves (\code{Categorical}, \code{Periodic}, \code{Simplex} with \code{size > 1}).}
          \li{\code{key} (\em{Key}) — Deterministic 128-bit [\code{Key}](#baux.Key) hashed from \code{bounds} and \code{leaves}.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{ravel(tree: Any) -> np.ndarray} (alias \code{flatten}) — Encode a single PyTree to \code{(dim,)} or batch to \code{(N, dim)}.}
          \li{\code{unflatten(flat: Any, weights: np.ndarray | None = None) -> Any} — Decode a \code{(dim,)} vector into a single PyTree.}
          \li{\code{unflatten_batch(flat_batch: Any, weights: np.ndarray | None = None) -> tuple[Any, ...]} — Decode an \code{(N, dim)} matrix into a tuple of \code{N} PyTrees.}
          \li{\code{unflatten_stacked(flat_batch: Any, weights: np.ndarray | None = None) -> Any} — Decode an \code{(N, dim)} matrix into one PyTree with leading \code{N} batch axes.}
        }
      }
    }
  }

  \<div>[id]{baux.LeafSpec}[class]{api-entry}[data-symbol]{baux.LeafSpec}[data-kind]{class}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.LeafSpec}](#baux.LeafSpec)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.LeafSpec(
    path: tuple[Any, ...],
    shape: tuple[int, ...],
    offset: int,
    size: int,
    low: np.ndarray,
    high: np.ndarray,
    categorical: Categorical | None = None,
    embed: Any = None,
)
    }
    \p{Frozen descriptor recording the path, slice offset, bounds, and optional manifold chart of one leaf in a [\code{PyTreeSpec}](#baux.PyTreeSpec).}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{path} (\em{tuple[Any, ...]}) — Sequence of dict keys, sequence indices, or field names from the root container.}
          \li{\code{shape} (\em{tuple[int, ...]}) — Embedded leaf array shape (\code{(width,)} for manifold charts).}
          \li{\code{offset} (\em{int}) — Starting column index in the flat \code{(D,)} coordinate vector.}
          \li{\code{size} (\em{int}) — Number of flat coordinate columns occupied by this leaf.}
          \li{\code{low} / \code{high} (\em{np.ndarray}) — Read-only \code{float64} bound arrays of shape \code{shape}.}
          \li{\code{categorical} (\em{Categorical | None}) — [\code{Categorical}](#baux.Categorical) chart instance for discrete leaves, else \code{None}.}
          \li{\code{embed} (\em{Categorical | Periodic | Simplex | Log | None}) — Manifold chart instance when embedded, else \code{None}.}
        }
      }
    }
  }

  \<div>[id]{baux.pytree_bounds}[class]{api-entry}[data-symbol]{baux.pytree_bounds}[data-kind]{function}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.pytree_bounds}](#baux.pytree_bounds)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.pytree_bounds(
    tree: Any,
    low: Any = -1.0,
    high: Any = 1.0,
) -> PyTreeSpec
    }
    \p{Compile a template PyTree of sample arrays, positive integer shape tuples (e.g., \code{(64, 16)}), or manifold leaf charts into a validated [\code{PyTreeSpec}](#baux.PyTreeSpec).}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{tree} (\em{Any}) — Nested mapping, list, tuple, namedtuple, or dataclass containing at least one leaf (returns \code{tree} unchanged if already a \code{PyTreeSpec}).}
          \li{\code{low} (\em{float | np.ndarray | PyTree}, default \code{-1.0}) — Broadcastable scalar, array, or matching-prefix PyTree of lower bounds for Euclidean leaves.}
          \li{\code{high} (\em{float | np.ndarray | PyTree}, default \code{1.0}) — Broadcastable scalar, array, or matching-prefix PyTree of upper bounds for Euclidean leaves.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{PyTreeSpec} — Compiled parameter space.}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — If \code{tree} has no leaves, if shape tuple dimensions are \code{<= 0}, or if \code{low > high} at any Euclidean leaf.}
    }
  }

  \<div>[id]{baux.ravel}[class]{api-entry}[data-symbol]{baux.ravel}[data-kind]{function}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.ravel}](#baux.ravel)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.ravel(
    tree: Any,
    spec: PyTreeSpec | None = None,
) -> np.ndarray
    }
    \p{Encode manifold leaves and flatten a single parameter PyTree into \code{(D,)} or a sequence/stacked batch of \code{N} PyTrees into \code{(N, D)}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{tree} (\em{Any}) — Single PyTree, sequence of \code{N} PyTrees, or PyTree with batch-stacked leaves.}
          \li{\code{spec} (\em{PyTreeSpec | None}, default \code{None}) — Optional [\code{PyTreeSpec}](#baux.PyTreeSpec) applying manifold \code{.encode()} rules and leaf-path validation; when \code{None}, concatenates raw \code{float64} leaf arrays.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{np.ndarray} — \code{float64} vector of shape \code{(D,)} or batch matrix of shape \code{(N, D)}.}
      \<dt>{Raises}
      \<dd>{\code{KeyError} if a leaf path in \code{spec} is missing from \code{tree}; \code{ValueError} on leaf shape mismatches.}
    }
  }

  \<div>[id]{baux.unflatten}[class]{api-entry}[data-symbol]{baux.unflatten}[data-kind]{function}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.unflatten}](#baux.unflatten)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.unflatten(
    flat: Any,
    spec: PyTreeSpec,
    weights: np.ndarray | None = None,
) -> Any
    }
    \p{Reconstruct a single parameter PyTree from a 1D flat coordinate vector of shape \code{(spec.dim,)}, retracting manifold charts to natural parameter values.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{flat} (\em{array-like of shape (D,)}) — Flat solver coordinates matching \code{spec.dim}.}
          \li{\code{spec} (\em{PyTreeSpec}) — Target [\code{PyTreeSpec}](#baux.PyTreeSpec).}
          \li{\code{weights} (\em{ndarray of shape (D,) | None}, default \code{None}) — Optional per-coordinate metric weights passed to \code{Categorical.snap} for Mahalanobis-weighted category decoding.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Any} — Reconstructed PyTree matching \code{spec.template}.}
    }
  }

  \<div>[id]{baux.unflatten_batch}[class]{api-entry}[data-symbol]{baux.unflatten_batch}[data-kind]{function}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.unflatten_batch}](#baux.unflatten_batch)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.unflatten_batch(
    flat_batch: Any,
    spec: PyTreeSpec,
    weights: np.ndarray | None = None,
) -> tuple[Any, ...]
    }
    \p{Decode a 2D \code{(N, spec.dim)} coordinate matrix into a \code{tuple} of \code{N} structured parameter PyTrees.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{flat_batch} (\em{array-like of shape (N, D)}) — Batch coordinate matrix.}
          \li{\code{spec} (\em{PyTreeSpec}) — Target [\code{PyTreeSpec}](#baux.PyTreeSpec).}
          \li{\code{weights} (\em{ndarray of shape (D,) | None}, default \code{None}) — Optional coordinate weights for \code{Categorical} decoding.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[Any, ...]} — Tuple of \code{N} decoded parameter PyTrees.}
    }
  }

  \<div>[id]{baux.unflatten_stacked}[class]{api-entry}[data-symbol]{baux.unflatten_stacked}[data-kind]{function}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.unflatten_stacked}](#baux.unflatten_stacked)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.unflatten_stacked(
    flat_batch: Any,
    spec: PyTreeSpec,
    weights: np.ndarray | None = None,
) -> Any
    }
    \p{Decode a 2D \code{(N, spec.dim)} coordinate matrix into a single PyTree whose array/manifold leaves carry leading batch dimension \code{(N, *leaf_shape)} (and \code{tuple} of length \code{N} for \code{Categorical} leaves) for vectorized \code{vmap} evaluation.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{flat_batch} (\em{array-like of shape (N, D)}) — Batch coordinate matrix.}
          \li{\code{spec} (\em{PyTreeSpec}) — Target [\code{PyTreeSpec}](#baux.PyTreeSpec).}
          \li{\code{weights} (\em{ndarray of shape (D,) | None}, default \code{None}) — Optional coordinate weights for \code{Categorical} decoding.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Any} — Single batch-stacked PyTree.}
    }
  }

  \<div>[id]{baux.Log}[class]{api-entry}[data-symbol]{baux.Log}[data-kind]{class}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.Log}](#baux.Log)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.Log(low: float, high: float)
    }
    \p{Scale-invariant multiplicative Riemannian leaf chart on \code{[low, high]} (\code{0 < low < high}) mapping \code{x} to \code{u = log(x / low) / log(high / low)} in \code{[0, 1]}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{low} / \code{high} (\em{float}) — Finite strictly positive interval endpoints (\code{0 < low < high}).}
          \li{\code{width} (\em{int}) — Embedded dimension (\code{1}).}
          \li{\code{bounds} (\em{tuple[float, float]}) — Embedded coordinate bounds \code{(0.0, 1.0)}.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{encode(x: Any) -> np.ndarray} (alias \code{flatten}) — Map positive scalar or array \code{x} to \code{(1,)} or \code{(N, 1)} log-unit coordinates.}
          \li{\code{decode(u: Any) -> float | np.ndarray} (aliases \code{unflatten}, \code{snap}) — Retract \code{u} via \code{low * (high / low) ** u}.}
        }
      }
    }
  }

  \<div>[id]{baux.Periodic}[class]{api-entry}[data-symbol]{baux.Periodic}[data-kind]{class}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.Periodic}](#baux.Periodic)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.Periodic(low: float = 0.0, high: float = 2.0 * math.pi)
    }
    \p{Isometric circular trigonometric chart mapping periodic phases on \code{[low, high]} (modulo \code{high - low}) onto 2 tied coordinates \code{(0.5 + cos(phi) / (2*pi), 0.5 + sin(phi) / (2*pi))} in \code{[0, 1]^2}, eliminating boundary seam discontinuities.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{low} / \code{high} (\em{float}) — Finite phase period endpoints (\code{low < high}).}
          \li{\code{width} (\em{int}) — Embedded dimension (\code{2}, registered as a tied group in \code{PyTreeSpec.tied_dims}).}
          \li{\code{bounds} (\em{tuple[float, float]}) — Per-coordinate bounds \code{(0.0, 1.0)}.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{encode(theta: Any) -> np.ndarray} (alias \code{flatten}) — Map scalar or array \code{theta} to \code{(2,)} or \code{(N, 2)} circle coordinates.}
          \li{\code{decode(u: Any) -> float | np.ndarray} (aliases \code{unflatten}, \code{snap}) — Retract 2D coordinates back onto the principal period \code{[low, high]} via \code{atan2} modulo \code{high - low}.}
        }
      }
    }
  }

  \<div>[id]{baux.Simplex}[class]{api-entry}[data-symbol]{baux.Simplex}[data-kind]{class}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.Simplex}](#baux.Simplex)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.Simplex(dim: int)
    }
    \p{Positive-orthant Hellinger square-root chart \code{psi_i(p) = sqrt(p_i)} equipping the \code{(dim - 1)}-simplex of probability vectors with the Fisher–Rao metric.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{dim} (\em{int}) — Number of simplex components (\code{dim >= 1}).}
          \li{\code{width} (\em{int}) — Embedded coordinate width (\code{== dim}).}
          \li{\code{bounds} (\em{tuple[float, float]}) — Per-coordinate bounds \code{(0.0, 1.0)}.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{encode(p: Any) -> np.ndarray} (alias \code{flatten}) — Map probability vector(s) of trailing axis \code{dim} to \code{sqrt(max(p, 0))}.}
          \li{\code{decode(u: Any) -> np.ndarray} (aliases \code{unflatten}, \code{snap}) — Project back onto the probability simplex via \code{max(u, 0)**2} normalized by its sum (falling back to uniform \code{1.0 / dim} if degenerate).}
        }
      }
    }
  }

  \<div>[id]{baux.Categorical}[class]{api-entry}[data-symbol]{baux.Categorical}[data-kind]{class}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.Categorical}](#baux.Categorical)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.Categorical(
    categories: tuple[Any, ...],
    encoding: str = "auto",
    seed: Any = None,
    separation: float = 10.0,
    dim_cap: int = 48,
    key: Any = None,
)
    }
    \p{Isometric discrete categorical leaf chart supporting exact simplex one-hot vectors and logarithmic-width SplitMix64 Rademacher Johnson–Lindenstrauss codebooks.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{categories} (\em{tuple[Any, ...]}) — Non-empty ordered tuple of discrete category values.}
          \li{\code{encoding} (\em{str}, default \code{"auto"}) — Requested scheme: \code{"auto"}, \code{"onehot"}, or \code{"rademacher"}.}
          \li{\code{seed} (\em{int}) — Resolved unsigned 64-bit codebook hash seed.}
          \li{\code{separation} (\em{float}, default \code{10.0}) — Positive Euclidean codeword norm parameter for Rademacher embeddings.}
          \li{\code{dim_cap} (\em{int}, default \code{48}) — Maximum embedding width cap (\code{1 <= dim_cap <= 64}).}
          \li{\code{card} (\em{int}) — Category cardinality \code{C = len(categories)}.}
          \li{\code{kind} (\em{str}) — Resolved encoding (\code{"onehot"} or \code{"rademacher"}).}
          \li{\code{width} (\em{int}) — Continuous embedding dimension (\code{C} for \code{"onehot"}, \code{min(ceil(2 * log2(C) + 7), dim_cap)} for \code{"rademacher"}).}
          \li{\code{bounds} (\em{tuple[float, float]}) — \code{(0.0, 1.0)} for \code{"onehot"}, or \code{(-s, s)} with \code{s = separation / sqrt(width)} for \code{"rademacher"}.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{codebook(variable_idx: int = 0) -> np.ndarray} — Return the \code{(card, width)} \code{float64} codeword matrix.}
          \li{\code{encode(value: Any, variable_idx: int = 0) -> np.ndarray} — Encode a category label (or integer index) into its \code{(width,)} codeword.}
          \li{\code{snap(vec: Any, variable_idx: int = 0, weights: np.ndarray | None = None) -> Any} — Retract a continuous vector to the category maximizing (optionally \code{weights}-scaled) inner product.}
        }
      }
      \<dt>{Notes}
      \<dd>{Under \code{encoding="auto"} (with default \code{dim_cap=48}), cardinalities \code{C <= 15} resolve to exact \code{"onehot"} vertices in \code{R^C}, whereas \code{C > 15} switch to Rademacher JL codewords of logarithmic width \code{min(ceil(2 * log2(C) + 7), dim_cap)} (matching the \code{O(ln C)} Johnson–Lindenstrauss distortion scaling while capping high-cardinality dimensionality at \code{dim_cap}).}
    }
  }

  \<div>[id]{baux.categorical}[class]{api-entry}[data-symbol]{baux.categorical}[data-kind]{function}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.categorical}](#baux.categorical)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.categorical(
    categories: Sequence[Any],
    *,
    encoding: str = "auto",
    key: Key | None = None,
    seed: int | None = None,
    separation: float = 10.0,
    dim_cap: int = 48,
) -> Categorical
    }
    \p{Convenience constructor coercing any non-empty \code{Sequence} of discrete labels into a [\code{Categorical}](#baux.Categorical) leaf chart.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Returns}
      \<dd>{\code{Categorical} — Frozen categorical leaf specification.}
    }
  }

  \<div>[id]{baux.Stiefel}[class]{api-entry}[data-symbol]{baux.Stiefel}[data-kind]{class}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.Stiefel}](#baux.Stiefel)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.Stiefel(loadings: np.ndarray)
    }
    \p{Orthonormal subspace frame \code{V} of shape \code{(M, F)} on the Stiefel manifold \code{St(F, M)} implementing Empirical-Bayes James–Stein orthogonal residual contraction across correlated multi-output metrics.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{loadings} (\em{np.ndarray}) — Read-only \code{(M, F)} \code{float64} orthonormal loading matrix.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{Stiefel.from_factors(factors: np.ndarray) -> Stiefel} — Project a finite full-column-rank \code{(M, F)} factor matrix (\code{M >= F >= 1}) onto \code{St(F, M)} via polar SVD \code{U @ Vh}.}
          \li{\code{Stiefel.from_cov(y: np.ndarray, rank: int = 1) -> Stiefel} — Extract the top \code{rank} principal right singular vectors of centered \code{(N, M)} observations (\code{min(N, M) >= rank >= 1}).}
          \li{\code{transform_stein(mu: np.ndarray, se: np.ndarray) -> tuple[np.ndarray, np.ndarray]} (alias \code{stein}) — Contract orthogonal residual \code{r_perp = mu - mu @ P} per row by \code{alpha = ||r_perp||^2 / (||r_perp||^2 + sum_j se_j^2 * (1 - P_jj))}, returning read-only \code{(mu_out, se_out)} matching \code{(M,)} or \code{(Q, M)}.}
        }
      }
    }
  }

  \<div>[id]{baux.Affine}[class]{api-entry}[data-symbol]{baux.Affine}[data-kind]{class}[data-module]{baux.pytree}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.Affine}](#baux.Affine)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.Affine(
    a: np.ndarray,
    b: np.ndarray,
    c: np.ndarray,
)
    }
    \p{Diagonal affine posterior map transforming predictive moments \code{(mu, se)} componentwise to \code{(a + b * mu, c * se)} across \code{M} output metrics.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{a} (\em{np.ndarray}) — Read-only \code{(M,)} \code{float64} intercept vector.}
          \li{\code{b} (\em{np.ndarray}) — Read-only \code{(M,)} \code{float64} slope vector.}
          \li{\code{c} (\em{np.ndarray}) — Read-only \code{(M,)} \code{float64} standard-error scale multiplier.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{Affine.fit(mu: np.ndarray, y: np.ndarray, se: np.ndarray | None = None) -> Affine} — Fit unweighted OLS \code{(a, b)} and RMS standardized residual dispersion \code{c}.}
          \li{\code{Affine.fit_wls(mu: np.ndarray, y: np.ndarray, se: np.ndarray) -> Affine} — Fit Aitken inverse-variance Weighted Least Squares (\code{w = se**-2}) \code{(a, b)} and dispersion \code{c}.}
          \li{\code{conformal_scale(mu: np.ndarray, y: np.ndarray, se: np.ndarray, alpha: float = 0.1) -> np.ndarray} — Compute order-statistic conformal multiplier \code{q} at sorted rank \code{ceil((N + 1) * (1 - alpha)) - 1} of \code{|y - (a + b * mu)| / se} (\code{0 < alpha < 1}), returning a read-only \code{(M,)} \code{float64} vector.}
        }
      }
    }
  }
}

\subtree{
  \title{Standalone ENN Surrogate}

  \<table>[class]{api-summary-table}{
    \<thead>{
      \<tr>{
        \<th>{Symbol}
