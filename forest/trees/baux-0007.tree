  \<div>[id]{baux.init}[class]{api-entry}[data-symbol]{baux.init}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.init}](#baux.init)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.init(
    domain: np.ndarray | PyTreeSpec | Any,
    config: OptimizerConfig | Transform | None = None,
    *,
    pipe: OptimizerConfig | Transform | None = None,
    key: Key | None = None,
    seed: int | np.random.Generator | None = None,
    low: Any = -1.0,
    high: Any = 1.0,
) -> OptimizerState
    }
    \p{Construct an immutable state object at transition counter \code{epoch=0} from coordinate bounds, a compiled domain specification, or a template parameter PyTree.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{domain} (\em{np.ndarray of shape (D, 2) | PyTreeSpec | Any}) — Continuous coordinate bounds \code{[low, high]} per dimension, a compiled \code{PyTreeSpec}, or a structured PyTree template.}
          \li{\code{config} (\em{OptimizerConfig | Transform | None}, default \code{None}) — Base optimizer configuration or pipeline [\code{Transform}](#baux.Transform). Defaults to standard TuRBO when \code{None}.}
          \li{\code{pipe} (\em{OptimizerConfig | Transform | None}, keyword-only, default \code{None}) — Mutually exclusive keyword alias for \code{config}.}
          \li{\code{key} (\em{Key | None}, keyword-only, default \code{None}) — Deterministic 128-bit PRNG key (takes precedence over \code{seed}).}
          \li{\code{seed} (\em{int | np.random.Generator | None}, keyword-only, default \code{None}) — Integer seed or NumPy random generator used to initialize pseudo-random sequences.}
          \li{\code{low} (\em{float | Any}, keyword-only, default \code{-1.0}) — Default lower bound applied to continuous leaf dimensions when compiling PyTree domains.}
          \li{\code{high} (\em{float | Any}, keyword-only, default \code{1.0}) — Default upper bound applied to continuous leaf dimensions when compiling PyTree domains.}
        }
      }
      \<dt>{Returns}
      \<dd>{[\code{OptimizerState}](#baux.OptimizerState) — Initialized state object ready for synchronous or asynchronous optimization transitions.}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — If both \code{config} and \code{pipe} are passed, if bounds do not have shape \code{(D, 2)} with \code{low <= high}, or if the configuration is invalid.}
      \<dt>{Example}
      \<dd>{
        \pre{
import numpy as np
import baux

domain = np.array([[-2.0, 2.0], [-2.0, 2.0]])
state = baux.init(domain, seed=42)
for _ in range(6):
    state, batch = baux.ask(state, num_arms=2)
    y = -np.sum(batch.points**2, axis=-1)
    state, _ = baux.tell(state, batch, y)

assert state.num_observations == 12
        }
      }
    }
  }

  \<div>[id]{baux.ask}[class]{api-entry}[data-symbol]{baux.ask}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.ask}](#baux.ask)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.ask(
    state: OptimizerState,
    num_arms: int | None = None,
    *,
    n: int | None = None,
) -> tuple[OptimizerState, AskBatch]
    }
    \p{Propose candidate parameter arms inside \code{state.bounds}, returning an updated state object and a candidate batch without modifying \code{state}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Input state object.}
          \li{\code{num_arms} (\em{int | None}, default \code{None}) — Number of candidate arms to propose (\code{num_arms >= 1}). Defaults to \code{1} when both \code{num_arms} and \code{n} are \code{None}.}
          \li{\code{n} (\em{int | None}, keyword-only, default \code{None}) — Mutually exclusive keyword alias for \code{num_arms}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[OptimizerState, AskBatch]} — Pair of \code{(next_state, batch)}. The updated state advances its transition counter (\code{next_state.epoch == state.epoch + 1}) with deterministic key advancement, and \code{batch} is an [\code{AskBatch}](#baux.AskBatch) containing \code{num_arms} candidate points and evaluation tickets.}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — If both \code{num_arms} and \code{n} are supplied, or if the requested arm count is less than \code{1}.}
      \<dt>{Notes}
      \<dd>{Each proposal folds \code{epoch + 1} into the PRNG sequence. When multi-region search is enabled (\code{state.identified == True}), the generated \code{batch.ids} are registered in \code{next_state.pending_ids} for tracking.}
    }
  }

  \<div>[id]{baux.tell}[class]{api-entry}[data-symbol]{baux.tell}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.tell}](#baux.tell)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.tell(
    state: OptimizerState,
    x: AskBatch | np.ndarray | Any,
    y: np.ndarray | Sequence[float],
    *,
    y_var: np.ndarray | Sequence[float] | None = None,
) -> tuple[OptimizerState, np.ndarray]
    }
    \p{Ingest evaluated points \code{(x, y)} into the observation store and update surrogate models and trust-region state via copy-on-write state update.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Base state object.}
          \li{\code{x} (\em{AskBatch | np.ndarray of shape (N, D) or (D,) | PyTree}) — Evaluated candidate batch, coordinate array, or structured PyTree parameters matching \code{state.spec}.}
          \li{\code{y} (\em{np.ndarray of shape (N,) or (N, M) | Sequence[float]}) — Finite maximization objective values. Scalar objectives use shape \code{(N,)}, while multi-output targets use shape \code{(N, M)}.}
          \li{\code{y_var} (\em{np.ndarray | Sequence[float] | None}, keyword-only, default \code{None}) — Optional finite non-negative observation noise variances matching \code{y}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[OptimizerState, np.ndarray]} — Pair of \code{(next_state, fitted_mu)}, where \code{fitted_mu} is a read-only NumPy array (\code{writeable=False}) of posterior predictive means at \code{x} (or raw objective values when no surrogate is configured).}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — On dimension or shape mismatches, non-finite values, negative noise variances, or out-of-order submission against an active multi-region batch. In multi-region mode (\code{state.identified == True}), passing an [\code{AskBatch}](#baux.AskBatch) validates that the batch's evaluation IDs are registered and active.}
    }
  }

  \<div>[id]{baux.step}[class]{api-entry}[data-symbol]{baux.step}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.step}](#baux.step)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.step(
    state: OptimizerState,
    objective: Callable[[Any], Any],
    *,
    num_arms: int = 1,
    use_pytree: bool = False,
) -> tuple[OptimizerState, np.ndarray]
    }
    \p{Execute one synchronous proposal, evaluation, and ingestion cycle (\code{ask -> objective -> tell}) without in-place mutation.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Current state object.}
          \li{\code{objective} (\em{Callable[[Any], Any]}) — Maximization objective function returning an array-like of shape \code{(num_arms,)} or \code{(num_arms, M)}.}
          \li{\code{num_arms} (\em{int}, keyword-only, default \code{1}) — Number of candidate arms proposed and evaluated in this step.}
          \li{\code{use_pytree} (\em{bool}, keyword-only, default \code{False}) — When \code{True} and \code{state.spec} is set, passes decoded PyTree parameters to \code{objective}; otherwise passes flat coordinate rows.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[OptimizerState, np.ndarray]} — Pair of \code{(next_state, y)} with the post-ingestion state object and the evaluated objective array.}
    }
  }

  \<div>[id]{baux.complete}[class]{api-entry}[data-symbol]{baux.complete}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.complete}](#baux.complete)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.complete(
    state: OptimizerState,
    ids: AskBatch | tuple[AskId, ...] | list[AskId],
    y: np.ndarray | Sequence[float],
    *,
    y_var: np.ndarray | Sequence[float] | None = None,
) -> OptimizerState
    }
    \p{Resolve an arbitrary subset of pending evaluation IDs out of order in a multi-region optimization workflow.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Multi-region state object with active pending evaluations (\code{state.identified == True}).}
          \li{\code{ids} (\em{AskBatch | tuple[AskId, ...] | list[AskId]}) — Candidate batch or sequence of [\code{AskId}](#baux.AskId) tokens to complete.}
          \li{\code{y} (\em{np.ndarray of shape (K,) or (K, 1) | Sequence[float]}) — Finite scalar objective values matching \code{ids}.}
          \li{\code{y_var} (\em{np.ndarray | Sequence[float] | None}, keyword-only, default \code{None}) — Optional finite non-negative observation noise variances.}
        }
      }
      \<dt>{Returns}
      \<dd>{[\code{OptimizerState}](#baux.OptimizerState) — Updated state object with observations recorded and completed IDs removed from \code{pending_ids}.}
      \<dt>{Raises}
      \<dd>{\code{TypeError} — If any item in \code{ids} is not an [\code{AskId}](#baux.AskId) token. \code{ValueError} — If \code{y} shape does not match \code{ids}, or if any ID is unknown, previously resolved, or belongs to an invalidated regional generation.}
      \<dt>{Example}
      \<dd>{
        \pre{
import numpy as np
import baux

domain = np.array([[-1.0, 1.0], [-1.0, 1.0]])
pipe = baux.enn(k=5) | baux.regions(2)
state = baux.init(domain, pipe, seed=42)
state, batch = baux.ask(state, num_arms=4)
assert len(state.pending_ids) == 4
state = baux.complete(state, batch.ids[:2], np.array([0.5, 0.8]))
state = baux.cancel(state, batch.ids[2:])
assert len(state.pending_ids or ()) == 0
        }
      }
    }
  }

  \<div>[id]{baux.cancel}[class]{api-entry}[data-symbol]{baux.cancel}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.cancel}](#baux.cancel)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.cancel(
    state: OptimizerState,
    ids: AskBatch | tuple[AskId, ...] | list[AskId],
) -> OptimizerState
    }
    \p{Retire unevaluated pending evaluation IDs without recording observations or updating trust-region success and failure counters.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Multi-region state object with active pending evaluations.}
          \li{\code{ids} (\em{AskBatch | tuple[AskId, ...] | list[AskId]}) — Batch or sequence of [\code{AskId}](#baux.AskId) tokens to retire.}
        }
      }
      \<dt>{Returns}
      \<dd>{[\code{OptimizerState}](#baux.OptimizerState) — Updated state object with retired IDs removed from \code{pending_ids}.}
      \<dt>{Raises}
      \<dd>{\code{TypeError} — If any element is not an [\code{AskId}](#baux.AskId) token.}
    }
  }

  \<div>[id]{baux.restart_region}[class]{api-entry}[data-symbol]{baux.restart_region}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.restart_region}](#baux.restart_region)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.restart_region(
    state: OptimizerState,
    slot: int,
    center: np.ndarray | Any,
) -> tuple[OptimizerState, tuple[AskId, ...]]
    }
    \p{Restart a multi-region trust-region slot at a specified center coordinate, advancing its generation and invalidating in-flight evaluations owned by that slot.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Multi-region state object (\code{state.identified == True}).}
          \li{\code{slot} (\em{int}) — Trust-region slot index in \code{0 .. state.num_regions - 1}.}
          \li{\code{center} (\em{np.ndarray of shape (D,) | PyTree}) — New center coordinate vector within domain bounds.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[OptimizerState, tuple[AskId, ...]]} — Pair of \code{(next_state, abandoned_ids)} listing the invalidated evaluation IDs.}
      \<dt>{Raises}
      \<dd>{\code{RuntimeError} — If called on a single-region optimizer. \code{ValueError} — If \code{slot} is out of range or \code{center} violates domain bounds.}
    }
  }

  \<div>[id]{baux.import_observations}[class]{api-entry}[data-symbol]{baux.import_observations}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.import_observations}](#baux.import_observations)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.import_observations(
    state: OptimizerState,
    x: AskBatch | np.ndarray | Any,
    y: np.ndarray | Sequence[float],
    *,
    y_var: np.ndarray | Sequence[float] | None = None,
) -> tuple[OptimizerState, np.ndarray]
    }
    \p{Append external, historical, or late-arriving observations to a multi-region optimizer without resolving active pending evaluation batches.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Multi-region state object.}
          \li{\code{x} (\em{AskBatch | np.ndarray of shape (N, D) or (D,) | PyTree}) — Coordinate rows or structured PyTree parameters.}
          \li{\code{y} (\em{np.ndarray of shape (N,) or (N, M) | Sequence[float]}) — Maximization objective values.}
          \li{\code{y_var} (\em{np.ndarray | Sequence[float] | None}, keyword-only, default \code{None}) — Optional observation noise variances.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[OptimizerState, np.ndarray]} — Pair of \code{(next_state, fitted_mu)} with observations added to the surrogate store.}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — On dimension mismatches or when called on a single-region state object.}
    }
  }

  \<div>[id]{baux.posterior_mu}[class]{api-entry}[data-symbol]{baux.posterior_mu}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.posterior_mu}](#baux.posterior_mu)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.posterior_mu(
    state: OptimizerState,
    x: AskBatch | np.ndarray | Any,
) -> np.ndarray
    }
    \p{Query fitted surrogate posterior predictive means at coordinates \code{x} in natural target units without advancing the transition counter.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — State object configured with an active surrogate model.}
          \li{\code{x} (\em{AskBatch | np.ndarray of shape (Q, D) or (D,) | PyTree}) — Query coordinates or structured PyTree parameters.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{np.ndarray} — Read-only NumPy array (\code{writeable=False}) of posterior means of shape \code{(Q, M)}.}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — If coordinate dimensions do not match \code{state.dim}.}
    }
  }

  \<div>[id]{baux.OptimizerState}[class]{api-entry}[data-symbol]{baux.OptimizerState}[data-kind]{class}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.OptimizerState}](#baux.OptimizerState)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
class baux.OptimizerState  (frozen dataclass; constructed via baux.init)
    }
    \p{Immutable state object encapsulating an optimizer search domain, configuration, observation history, trust-region ledger, and state digest.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes & Properties}
      \<dd>{
        \ul{
          \li{\code{x} (\em{np.ndarray}) — Read-only NumPy array (\code{writeable=False}) of observed parameter rows of shape \code{(N, D)} (alias for \code{x_obs}).}
          \li{\code{y} (\em{np.ndarray}) — Read-only NumPy array (\code{writeable=False}) of observed objective values of shape \code{(N, M)} (alias for \code{y_obs}).}
          \li{\code{y_var} (\em{np.ndarray | None}) — Read-only observation noise variances matching \code{y}, or \code{None} if unobserved.}
          \li{\code{bounds} (\em{np.ndarray}) — Read-only \code{(D, 2)} \code{float64} coordinate bounds \code{[low, high]}.}
          \li{\code{num_observations} (\em{int}) — Total count of recorded observation rows \code{N}.}
          \li{\code{best_x} (\em{np.ndarray | None}) — Read-only \code{(D,)} coordinate vector of the incumbent best observation, or \code{None} when empty.}
          \li{\code{best_y} (\em{float | None}) — Maximum observed primary objective scalar, or \code{None} when empty.}
          \li{\code{best_params} (\em{Any}) — Incumbent parameter set decoded through \code{spec}, or \code{best_x} when unspec'd.}
          \li{\code{tr_length} (\em{float}) — Current side length of the active trust region in unit-cube coordinates.}
          \li{\code{pending_ids} (\em{tuple[int, ...] | None}) — Outstanding evaluation IDs in multi-region mode, or \code{None} when none are pending.}
          \li{\code{epoch} (\em{int}) — Monotonic transition counter incremented by \code{1} per functional transition.}
          \li{\code{identified} (\em{bool}) — Boolean flag indicating whether multi-region evaluation identity tracking is active.}
          \li{\code{spec} (\em{PyTreeSpec | None}) — Compiled domain specification when initialized from a PyTree domain, else \code{None}.}
          \li{\code{key} (\em{Key}) — Deterministic 128-bit PRNG key derived from the state digest.}
          \li{\code{digest} (\em{Callable[[], str]}) — Method returning the 64-character hexadecimal BLAKE3 state digest.}
          \li{\code{config} (\em{OptimizerConfig}) — Validated composite configuration governing pipeline behavior.}
        }
      }
    }
  }

  \<div>[id]{baux.AskBatch}[class]{api-entry}[data-symbol]{baux.AskBatch}[data-kind]{class}[data-module]{baux.bo}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.AskBatch}](#baux.AskBatch)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.AskBatch(
    ids: tuple[AskId, ...],
    points: np.ndarray,
    spec: PyTreeSpec | None = None,
    weights: np.ndarray | None = None,
)
    }
    \p{Candidate batch returned by [\code{baux.ask}](#baux.ask) bundling evaluation IDs, coordinate rows, and structured PyTree decodings.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes & Properties}
      \<dd>{
        \ul{
          \li{\code{ids} (\em{tuple[AskId, ...]}) — Tuple of \code{K} typed [\code{AskId}](#baux.AskId) evaluation tokens.}
          \li{\code{points} (\em{np.ndarray}) — Read-only \code{(K, D)} NumPy array of candidate coordinates within natural domain bounds.}
          \li{\code{params} (\em{tuple[Any, ...]}) — Decoded parameter PyTrees (length \code{K}) when \code{spec} is set, else tuple of coordinate rows.}
          \li{\code{stacked} (\em{Any}) — Single PyTree whose leaves carry leading batch dimension \code{(K, *shape)} when \code{spec} is set, else \code{points}.}
        }
      }
      \<dt>{Behavior}
      \<dd>{\code{len(batch)} returns arm count \code{K}. \code{batch[i]} indexes candidate rows, and \code{np.asarray(batch)} returns \code{points}.}
    }
  }

  \<div>[id]{baux.AskId}[class]{api-entry api-entry-compact}[data-symbol]{baux.AskId}[data-kind]{class}[data-module]{baux.bo}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.AskId}](#baux.AskId)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.AskId(value: int)
    }
    \p{Immutable 64-bit ticket (\code{int(aid)}) wrapping an unsigned integer evaluation identity (\code{0 <= value < 2**64}). It is hashable, totally ordered, and matched by [\code{baux.complete}](#baux.complete) and [\code{baux.cancel}](#baux.cancel) to resolve pending multi-region evaluations.}
  }
}

\subtree{
  \title{Pipeline Stages}

  \p{
    Pipeline stages compose left-to-right with the pipe operator \code{|} (for example, \code{baux.enn(k=15) | baux.ucb(beta=1.5) | baux.regions(4)}) into an immutable [\code{Transform}](#baux.Transform) compiled by [\code{baux.init}](#baux.init) or [\code{baux.chain}](#baux.chain). Later stages override earlier settings for the same component slot.
  }

