  \<div>[id]{baux.init}[class]{api-entry}[data-symbol]{baux.init}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.init}](#baux.init)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.init(
    domain: np.ndarray | PyTreeSpec | Any,
    config: OptimizerConfig | Transform | None = None,
    *,
    pipe: OptimizerConfig | Transform | None = None,
    key: Key | None = None,
    seed: int | np.random.Generator | None = None,
    low: Any = -1.0,
    high: Any = 1.0,
) -> OptimizerState
    }
    \p{Construct an immutable \code{OptimizerState} at \code{epoch=0} from explicit coordinate bounds, a compiled \code{PyTreeSpec}, or a template parameter PyTree.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{domain} (\em{ndarray of shape (D, 2) | PyTreeSpec | Any}) — Continuous coordinate bounds \code{[low, high]} per dimension, a compiled [\code{PyTreeSpec}](#baux.PyTreeSpec), or a nested container (mapping, tuple, list, namedtuple, or dataclass) of arrays, shape tuples, and manifold leaf charts compiled via [\code{baux.pytree_bounds}](#baux.pytree_bounds).}
          \li{\code{config} (\em{OptimizerConfig | Transform | None}, default \code{None}) — Composite [\code{OptimizerConfig}](#baux.OptimizerConfig) or pipeline [\code{Transform}](#baux.Transform). When \code{None} (and \code{pipe} is \code{None}), defaults to \code{OptimizerConfig()}.}
          \li{\code{pipe} (\em{OptimizerConfig | Transform | None}, keyword-only, default \code{None}) — Mutually exclusive alias for \code{config}; passing both \code{config} and \code{pipe} raises \code{ValueError}.}
          \li{\code{key} (\em{Key | None}, keyword-only, default \code{None}) — Deterministic 128-bit [\code{Key}](#baux.Key) (takes precedence over \code{seed} when provided).}
          \li{\code{seed} (\em{int | np.random.Generator | None}, keyword-only, default \code{None}) — Integer seed, byte buffer, or NumPy \code{Generator}. When both \code{key} and \code{seed} are \code{None}, derives a deterministic content-addressed seed from the domain bounds/key and \code{repr(cfg)}.}
          \li{\code{low} (\em{float | Any}, keyword-only, default \code{-1.0}) — Scalar or matching-prefix PyTree lower bound applied to Euclidean array/shape leaves when compiling \code{domain}.}
          \li{\code{high} (\em{float | Any}, keyword-only, default \code{1.0}) — Scalar or matching-prefix PyTree upper bound applied to Euclidean array/shape leaves when compiling \code{domain}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{OptimizerState} — Initialized immutable snapshot ready for [\code{baux.ask}](#baux.ask), [\code{baux.step}](#baux.step), [\code{baux.scan}](#baux.scan), or [\code{baux.pmap}](#baux.pmap).}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — If both \code{config} and \code{pipe} are supplied, if array bounds do not have shape \code{(D, 2)} with \code{low <= high}, or if \code{config} is unsupported by the native solver.}
      \<dt>{Notes}
      \<dd>{When \code{domain} compiles to a \code{PyTreeSpec} with multi-column manifold embeddings (\code{spec.tied_dims}), \code{baux.init} automatically populates \code{config.candidates.tied_dims} and \code{config.surrogate.tied_dims} (on \code{ENNSurrogate}) whenever unset so coordinate perturbations and metric learning respect leaf boundaries.}
    }
  }

  \<div>[id]{baux.ask}[class]{api-entry}[data-symbol]{baux.ask}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.ask}](#baux.ask)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.ask(
    state: OptimizerState,
    num_arms: int | None = None,
    *,
    n: int | None = None,
) -> tuple[OptimizerState, AskBatch]
    }
    \p{Pure proposal transition generating \code{num_arms} candidate parameter rows inside \code{state.bounds} without mutating \code{state}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Immutable optimizer snapshot.}
          \li{\code{num_arms} (\em{int | None}, default \code{None}) — Number of candidate arms \code{K >= 1} to propose. Defaults to \code{1} when both \code{num_arms} and \code{n} are \code{None}.}
          \li{\code{n} (\em{int | None}, keyword-only, default \code{None}) — Mutually exclusive keyword alias for \code{num_arms}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[OptimizerState, AskBatch]} — \code{(next_state, batch)} where \code{next_state.epoch == state.epoch + 1} and \code{batch} is an [\code{AskBatch}](#baux.AskBatch) holding \code{K} evaluation IDs and a read-only \code{(K, D)} \code{float64} coordinate matrix.}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — If both \code{num_arms} and \code{n} are passed, or if the resolved arm count is \code{<= 0}.}
    }
  }

  \<div>[id]{baux.tell}[class]{api-entry}[data-symbol]{baux.tell}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.tell}](#baux.tell)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.tell(
    state: OptimizerState,
    x: AskBatch | np.ndarray | Any,
    y: np.ndarray | Sequence[float],
    *,
    y_var: np.ndarray | Sequence[float] | None = None,
) -> tuple[OptimizerState, np.ndarray]
    }
    \p{Pure observation transition appending evaluated points \code{(x, y)} and updating surrogate hyperparameters and trust-region state while leaving \code{state} untouched.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Optimizer snapshot from which the branch advances.}
          \li{\code{x} (\em{AskBatch | ndarray of shape (N, D) or (D,) | PyTree}) — Evaluated candidate batch, coordinate array, or structured PyTree(s) matching \code{state.spec}.}
          \li{\code{y} (\em{array-like of shape (N,) or (N, M)}) — Finite maximization objective values (\code{float64}).}
          \li{\code{y_var} (\em{array-like of shape (N,) or (N, M) | None}, keyword-only, default \code{None}) — Optional finite nonnegative observation noise variances matching \code{y}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[OptimizerState, np.ndarray]} — \code{(next_state, fitted_mu)}, where \code{fitted_mu} is a read-only \code{float64} array of posterior means at \code{x} (retaining 1D \code{(N,)} shape when \code{y} is 1D scalar, or returning \code{y} directly when no surrogate model is active).}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — On shape mismatches, non-finite coordinates/objectives, negative variances, or out-of-order submission against a partially completed multi-region batch. Raises [\code{TellPredictionError}](#baux.TellPredictionError) if native ingestion succeeds on \code{next_state} but post-ingestion \code{posterior_mu} evaluation fails.}
    }
  }

  \<div>[id]{baux.step}[class]{api-entry}[data-symbol]{baux.step}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.step}](#baux.step)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.step(
    state: OptimizerState,
    objective: Callable[..., Any],
    *,
    num_arms: int = 1,
    use_pytree: bool = False,
) -> tuple[OptimizerState, np.ndarray]
    }
    \p{Execute one pure synchronous \code{ask -> objective -> tell} optimization step.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Input optimizer snapshot.}
          \li{\code{objective} (\em{Callable[..., Any]}) — Maximization objective returning an array-like of shape \code{(num_arms,)} or \code{(num_arms, M)}.}
          \li{\code{num_arms} (\em{int}, keyword-only, default \code{1}) — Batch size \code{K >= 1} proposed in this round.}
          \li{\code{use_pytree} (\em{bool}, keyword-only, default \code{False}) — When \code{True} and \code{state.spec is not None}, invokes \code{objective(batch.params[0])} for \code{num_arms == 1} or \code{objective(batch.stacked)} for \code{num_arms > 1}; otherwise passes \code{batch.points} of shape \code{(num_arms, D)}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[OptimizerState, np.ndarray]} — \code{(next_state, y)} containing the post-\code{tell} snapshot (\code{epoch == state.epoch + 2}) and read-only \code{float64} objective array \code{y}.}
    }
  }

  \<div>[id]{baux.complete}[class]{api-entry}[data-symbol]{baux.complete}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.complete}](#baux.complete)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.complete(
    state: OptimizerState,
    ids: AskBatch | tuple[AskId, ...] | list[AskId],
    y: np.ndarray | Sequence[float],
    *,
    y_var: np.ndarray | Sequence[float] | None = None,
) -> OptimizerState
    }
    \p{Complete any non-empty subset of pending multi-region evaluation \code{AskId} tokens in arbitrary arrival order.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Multi-region optimizer snapshot (\code{state.identified == True}) with pending proposals.}
          \li{\code{ids} (\em{AskBatch | tuple[AskId, ...] | list[AskId]}) — Batch or sequence of \code{K} typed [\code{AskId}](#baux.AskId) tokens to resolve.}
          \li{\code{y} (\em{array-like of shape (K,) or (K, 1)}) — Finite scalar objective values corresponding 1-to-1 with \code{ids}.}
          \li{\code{y_var} (\em{array-like of shape (K,) or (K, 1) | None}, keyword-only, default \code{None}) — Optional finite nonnegative observation noise variances.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{OptimizerState} — Updated snapshot with completed observations ingested and resolved \code{ids} retired from \code{pending_ids}.}
      \<dt>{Raises}
      \<dd>{\code{TypeError} if \code{ids} contains non-\code{AskId} elements; \code{ValueError} if \code{y} is not shape \code{(K,)}/\code{(K, 1)} or if any ID is unknown, already resolved, or belongs to a stale regional generation.}
      \<dt>{Notes}
      \<dd>{Each \code{AskId} carries \code{(slot, generation)} provenance in the native regional ledger. Active completions append globally to the surrogate store immediately; a region slot's TuRBO side length and success/failure counters adapt once every arm in its pending group settles (via \code{complete} or \code{cancel}) and its \code{generation} matches the slot's active epoch. If a slot was restarted via [\code{baux.restart_region}](#baux.restart_region), its abandoned IDs belong to a stale generation and are rejected by \code{complete}; ingest late measurements from abandoned runs via [\code{baux.import_observations}](#baux.import_observations) instead.}
    }
  }

  \<div>[id]{baux.cancel}[class]{api-entry}[data-symbol]{baux.cancel}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.cancel}](#baux.cancel)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.cancel(
    state: OptimizerState,
    ids: AskBatch | tuple[AskId, ...] | list[AskId],
) -> OptimizerState
    }
    \p{Retire unevaluated pending \code{AskId} tokens without recording objective values or applying TuRBO success/failure credit.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Multi-region optimizer snapshot with pending evaluation IDs.}
          \li{\code{ids} (\em{AskBatch | tuple[AskId, ...] | list[AskId]}) — Pending [\code{AskId}](#baux.AskId) tokens to retire (e.g., worker preemption or simulator timeout).}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{OptimizerState} — Updated snapshot with \code{ids} removed from \code{pending_ids}.}
      \<dt>{Notes}
      \<dd>{Cancelled warm-up arms do not consume the \code{num_init} initialization budget. Cancelled post-warm-up arms release their regional pending slot without incrementing consecutive failure counters or shrinking trust-region side length.}
    }
  }

  \<div>[id]{baux.restart_region}[class]{api-entry}[data-symbol]{baux.restart_region}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.restart_region}](#baux.restart_region)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.restart_region(
    state: OptimizerState,
    slot: int,
    center: np.ndarray | Any,
) -> tuple[OptimizerState, tuple[AskId, ...]]
    }
    \p{Restart multi-region slot \code{slot} at \code{center}, advancing its regional generation and abandoning any in-flight evaluations owned by that slot.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Multi-region optimizer snapshot (\code{state.identified == True}) after warm-up completion.}
          \li{\code{slot} (\em{int}) — Region slot index in \code{0 .. state.num_regions - 1}.}
          \li{\code{center} (\em{ndarray of shape (D,) | PyTree}) — Natural-coordinate restart center inside \code{state.bounds} (or structured PyTree matching \code{state.spec}).}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[OptimizerState, tuple[AskId, ...]]} — \code{(next_state, abandoned_ids)} where \code{abandoned_ids} lists previously pending \code{AskId} tokens invalidated by the generation increment.}
      \<dt>{Raises}
      \<dd>{\code{RuntimeError} if \code{state} is not a multi-region optimizer; \code{ValueError} if warm-up is incomplete, \code{slot} is out of range, or \code{center} lies outside \code{state.bounds}.}
    }
  }

  \<div>[id]{baux.import_observations}[class]{api-entry}[data-symbol]{baux.import_observations}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.import_observations}](#baux.import_observations)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.import_observations(
    state: OptimizerState,
    x: AskBatch | np.ndarray | Any,
    y: np.ndarray | Sequence[float],
    *,
    y_var: np.ndarray | Sequence[float] | None = None,
) -> tuple[OptimizerState, np.ndarray]
    }
    \p{Append external, historical, or late-arriving observations to a multi-region optimizer without resolving pending \code{AskId} batches or crediting regional controllers.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Multi-region optimizer snapshot.}
          \li{\code{x} (\em{AskBatch | ndarray of shape (N, D) or (D,) | PyTree}) — Parameter coordinates or PyTree(s) in natural domain units.}
          \li{\code{y} (\em{array-like of shape (N,) or (N, M)}) — Finite objective values.}
          \li{\code{y_var} (\em{array-like of shape (N,) or (N, M) | None}, keyword-only, default \code{None}) — Optional finite nonnegative observation noise variances.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[OptimizerState, np.ndarray]} — \code{(next_state, fitted_mu)} with global surrogate and incumbent updated.}
      \<dt>{Raises}
      \<dd>{\code{ValueError} if called on a single-region optimizer or on invalid array shapes; [\code{TellPredictionError}](#baux.TellPredictionError) if post-ingestion \code{posterior_mu} retrieval fails.}
    }
  }

  \<div>[id]{baux.posterior_mu}[class]{api-entry}[data-symbol]{baux.posterior_mu}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.posterior_mu}](#baux.posterior_mu)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.posterior_mu(
    state: OptimizerState,
    x: AskBatch | np.ndarray | Any,
) -> np.ndarray
    }
    \p{Evaluate the fitted surrogate's posterior predictive mean at query coordinates \code{x} in natural target units without recording observations or advancing \code{state.epoch}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Optimizer snapshot configured with a surrogate model (\code{ENN} or \code{GP}).}
          \li{\code{x} (\em{AskBatch | ndarray of shape (Q, D) or (D,) | PyTree}) — Query coordinates or structured PyTree(s) matching \code{state.spec}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{np.ndarray} — Read-only \code{float64} array of posterior means of shape \code{(Q, M)}.}
    }
  }

  \<div>[id]{baux.OptimizerState}[class]{api-entry}[data-symbol]{baux.OptimizerState}[data-kind]{class}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.OptimizerState}](#baux.OptimizerState)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
class baux.OptimizerState  (frozen dataclass; constructed via baux.init)
    }
    \p{Immutable, forkable value token encapsulating an optimizer's search domain, configuration, observation store, trust-region ledger, and BLAKE3 state digest via copy-on-write Rust cursors.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{dim} (\em{int}) — Flat continuous search-space dimension \code{D}.}
          \li{\code{bounds} (\em{np.ndarray}) — Read-only \code{(D, 2)} \code{float64} coordinate bounds \code{[low, high]}.}
          \li{\code{config} (\em{OptimizerConfig}) — Validated composite [\code{OptimizerConfig}](#baux.OptimizerConfig).}
          \li{\code{seed} (\em{int}) — Base 63-bit integer seed folded with \code{epoch} on each transition.}
          \li{\code{epoch} (\em{int}) — Monotonic transition counter (\code{0} at \code{init}, incremented by \code{1} per functional transition).}
          \li{\code{spec} (\em{PyTreeSpec | None}) — Compiled [\code{PyTreeSpec}](#baux.PyTreeSpec) when initialized from a PyTree domain, else \code{None}.}
          \li{\code{identified} (\em{bool}) — \code{True} when \code{config.trust_region} is a [\code{RegionalSearchPolicy}](#baux.RegionalSearchPolicy) supporting typed \code{AskId} completion.}
          \li{\code{num_observations} (\em{int}) — Total count \code{N} of ingested observations.}
          \li{\code{num_regions} (\em{int}) — Number of configured trust-region slots (\code{1} for single-region, \code{count} for multi-region).}
          \li{\code{tr_length} (\em{float}) — Current side length of the primary trust region in unit-cube coordinates.}
          \li{\code{init_progress} (\em{tuple[int, int] | None}) — \code{(completed, total)} warm-up counts when initialization is active, else \code{None}.}
          \li{\code{pending_ids} (\em{tuple[int, ...] | None}) — Outstanding raw evaluation IDs in original \code{ask} order, or \code{None}.}
          \li{\code{ingestion_failure} (\em{str | None}) — Terminal deferred-flush error message if native storage failed, else \code{None}.}
          \li{\code{telemetry} (\em{Telemetry}) — [\code{Telemetry}](#baux.Telemetry) timings and candidate count from the latest transition.}
          \li{\code{x_obs} (\em{np.ndarray}) — Read-only \code{(N, D)} \code{float64} matrix of observed coordinates (\code{(0, D)} when empty).}
          \li{\code{y_obs} (\em{np.ndarray}) — Read-only \code{(N, M)} \code{float64} matrix of observed objectives (\code{(0, 1)} when empty).}
          \li{\code{best_x} / \code{incumbent_x} (\em{np.ndarray | None}) — Read-only \code{(D,)} \code{float64} incumbent coordinate vector, or \code{None} when \code{N == 0}.}
          \li{\code{best_y} / \code{incumbent_y} (\em{float | None}) — Maximum observed primary objective \code{float(np.max(y_obs[:, 0]))}, or \code{None} when \code{N == 0}.}
          \li{\code{best_params} / \code{incumbent_params} (\em{Any}) — Incumbent decoded via \code{spec.unflatten(..., weights=metric_weights)} when \code{spec} is present, else \code{best_x}.}
          \li{\code{lengthscales} (\em{np.ndarray | None}) — Read-only \code{(D,)} \code{float64} per-dimension surrogate lengthscales, or \code{None}.}
          \li{\code{metric_weights} (\em{np.ndarray | None}) — Read-only \code{(D,)} \code{float64} inverse lengthscales \code{1.0 / np.maximum(lengthscales, 1e-12)}, or \code{None}.}
          \li{\code{key} (\em{Key}) — Content-addressed 128-bit [\code{Key}](#baux.Key) derived from \code{bytes.fromhex(state.digest())}.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{digest() -> str} — Return the 64-character lowercase hexadecimal BLAKE3 digest of the native optimizer state.}
          \li{\code{fork(key: Any = None, *, seed: Any = None) -> OptimizerState} — Return an independent copy-on-write snapshot optionally re-seeded with \code{key} or \code{seed}.}
        }
      }
    }
  }

  \<div>[id]{baux.AskBatch}[class]{api-entry}[data-symbol]{baux.AskBatch}[data-kind]{class}[data-module]{baux.bo}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.AskBatch}](#baux.AskBatch)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.AskBatch(
    ids: tuple[AskId, ...],
    points: np.ndarray,
    spec: PyTreeSpec | None = None,
    weights: np.ndarray | None = None,
)
    }
    \p{Frozen record returned by [\code{baux.ask}](#baux.ask) and \code{Optimizer.ask_batch} bundling evaluation IDs, flat candidate coordinates, and lazy PyTree decodings.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{ids} (\em{tuple[AskId, ...]}) — Tuple of \code{K} [\code{AskId}](#baux.AskId) tokens, one per proposed row.}
          \li{\code{points} (\em{np.ndarray}) — Read-only \code{(K, D)} \code{float64} candidate coordinate matrix in natural domain bounds.}
          \li{\code{spec} (\em{PyTreeSpec | None}) — Optional [\code{PyTreeSpec}](#baux.PyTreeSpec) used to decode \code{params} and \code{stacked}.}
          \li{\code{weights} (\em{np.ndarray | None}) — Optional \code{(D,)} \code{float64} metric weights used for Riemannian \code{Categorical} snapping.}
          \li{\code{params} (\em{tuple[Any, ...]}) — Decoded PyTrees (length \code{K}) when \code{spec} is set, else tuple of \code{K} 1D \code{(D,)} coordinate rows.}
          \li{\code{stacked} (\em{Any}) — Single PyTree whose leaves carry leading batch axis \code{(K, *leaf_shape)} when \code{spec} is set, else \code{points}.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{__len__() -> int} — Return batch arm count \code{K == points.shape[0]}.}
          \li{\code{__array__(dtype: Any = None) -> np.ndarray} — NumPy array protocol returning \code{np.asarray(points, dtype=dtype)}.}
        }
      }
    }
  }

  \<div>[id]{baux.AskId}[class]{api-entry}[data-symbol]{baux.AskId}[data-kind]{class}[data-module]{baux.bo}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.AskId}](#baux.AskId)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.AskId(value: int)
    }
    \p{Frozen, totally ordered (\code{order=True}) wrapper around an unsigned 64-bit evaluation token issued for asynchronous multi-region proposals.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{value} (\em{int}) — Unsigned 64-bit integer identity (\code{0 <= value < 2**64}; booleans rejected with \code{TypeError}).}
        }
      }
      \<dt>{Notes}
      \<dd>{Pass \code{AskId} instances back unchanged to [\code{baux.complete}](#baux.complete) or [\code{baux.cancel}](#baux.cancel) (or \code{Optimizer.complete} / \code{Optimizer.cancel}).}
    }
  }
}

\subtree{
  \title{PRNG Keys, Rollouts & Serialization}

  \<table>[class]{api-summary-table}{
    \<thead>{
      \<tr>{
        \<th>{Symbol}
        \<th>{Summary}
      }
    }
    \<tbody>{
      \<tr>[data-symbol]{baux.Key}[data-kind]{class}[data-module]{baux.functional}{
        \<td>{[\code{baux.Key}](#baux.Key)}
        \<td>{Splittable 128-bit \code{(u64, u64)} SplitMix64/BLAKE3 cryptographic PRNG key.}
      }
      \<tr>[data-symbol]{baux.key}[data-kind]{function}[data-module]{baux.functional}{
        \<td>{[\code{baux.key}](#baux.key)}
        \<td>{Construct or extract a 128-bit \code{Key} from an integer, state, space, array, bytes, or OS entropy.}
      }
      \<tr>[data-symbol]{baux.split}[data-kind]{function}[data-module]{baux.functional}{
        \<td>{[\code{baux.split}](#baux.split)}
        \<td>{Deterministically partition a \code{Key} into \code{n} statistically independent child keys.}
      }
      \<tr>[data-symbol]{baux.fold}[data-kind]{function}[data-module]{baux.functional}{
        \<td>{[\code{baux.fold}](#baux.fold)}
        \<td>{Mix an integer tag into a \code{Key} without mutating the parent key.}
      }
      \<tr>[data-symbol]{baux.scan}[data-kind]{function}[data-module]{baux.functional}{
        \<td>{[\code{baux.scan}](#baux.scan)}
        \<td>{Fold \code{steps} pure optimization rounds over \code{state} and \code{key}, recording per-step traces.}
      }
      \<tr>[data-symbol]{baux.pmap}[data-kind]{function}[data-module]{baux.functional}{
        \<td>{[\code{baux.pmap}](#baux.pmap)}
        \<td>{Fork \code{state} and split \code{key} across \code{branches} worker threads concurrently.}
      }
      \<tr>[data-symbol]{baux.digest}[data-kind]{function}[data-module]{baux.functional}{
        \<td>{[\code{baux.digest}](#baux.digest)}
        \<td>{Compute the 64-character hexadecimal BLAKE3 cryptographic digest of \code{state}.}
      }
      \<tr>[data-symbol]{baux.freeze}[data-kind]{function}[data-module]{baux.functional}{
        \<td>{[\code{baux.freeze}](#baux.freeze)}
        \<td>{Serialize an \code{OptimizerState} into a versioned binary checkpoint.}
      }
      \<tr>[data-symbol]{baux.thaw}[data-kind]{function}[data-module]{baux.functional}{
        \<td>{[\code{baux.thaw}](#baux.thaw)}
        \<td>{Validate and restore an \code{OptimizerState} from binary checkpoint bytes.}
      }
    }
  }

  \<div>[id]{baux.Key}[class]{api-entry}[data-symbol]{baux.Key}[data-kind]{class}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.Key}](#baux.Key)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.Key(source: int | bytes | Key | None = None) -> Key
    }
    \p{Native Rust 128-bit \code{(u64, u64)} splittable PRNG key seeding deterministic ChaCha12 streams, LOO hyperparameter fits, and coherent posterior function draws.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{hi} (\em{int}) — Upper unsigned 64-bit word (\code{0 <= hi < 2**64}).}
          \li{\code{lo} (\em{int}) — Lower unsigned 64-bit word (\code{0 <= lo < 2**64}).}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{Key.entropy() -> Key} — Draw fresh 128-bit OS entropy.}
          \li{\code{Key.from_bytes(data: bytes) -> Key} — Hash arbitrary byte payloads via BLAKE3 into a deterministic \code{Key}.}
          \li{\code{Key.from_pair(hi: int, lo: int) -> Key} — Construct directly from explicit upper and lower \code{u64} words.}
          \li{\code{seed() -> int} — Derive a deterministic unsigned 64-bit integer seed.}
          \li{\code{split() -> tuple[Key, Key]} — Deterministically split into two independent child keys.}
          \li{\code{split_n(n: int) -> list[Key]} — Deterministically split into \code{n} independent child keys.}
          \li{\code{fold(tag: int) -> Key} — Mix an unsigned 64-bit integer \code{tag} into a derived child key.}
        }
      }
    }
  }

  \<div>[id]{baux.key}[class]{api-entry}[data-symbol]{baux.key}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.key}](#baux.key)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.key(source: Any = None) -> Key
    }
    \p{Construct or extract a 128-bit [\code{Key}](#baux.Key) from an integer, byte buffer, NumPy array, content-addressed state/space, or OS entropy.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{source} (\em{int | bytes | np.ndarray | OptimizerState | ENNState | PyTreeSpec | Key | None}, default \code{None}) — Seed material. Extracts \code{source.key} if present, hashes \code{np.ascontiguousarray(source).tobytes()} for arrays, or samples OS entropy when \code{None}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Key} — Immutable 128-bit splittable PRNG key.}
    }
  }

  \<div>[id]{baux.split}[class]{api-entry}[data-symbol]{baux.split}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.split}](#baux.split)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.split(k: Key, n: int = 2) -> tuple[Key, ...]
    }
    \p{Deterministically partition \code{k} into a tuple of \code{n} independent subkeys without mutating \code{k}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{k} (\em{Key}) — Parent 128-bit PRNG key.}
          \li{\code{n} (\em{int}, default \code{2}) — Number of subkeys to derive.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[Key, ...]} — Tuple of \code{n} child \code{Key} instances.}
    }
  }

  \<div>[id]{baux.fold}[class]{api-entry}[data-symbol]{baux.fold}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.fold}](#baux.fold)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.fold(k: Key, tag: int) -> Key
    }
    \p{Mix a 64-bit integer \code{tag} (\code{int(tag) & ((1 << 64) - 1)}) into \code{k}, returning an independent derived \code{Key} without mutating \code{k}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{k} (\em{Key}) — Base 128-bit PRNG key.}
          \li{\code{tag} (\em{int}) — Step index, worker ID, or domain salt folded into \code{k}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Key} — Derived 128-bit key.}
    }
  }

  \<div>[id]{baux.scan}[class]{api-entry}[data-symbol]{baux.scan}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.scan}](#baux.scan)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.scan(
    state: OptimizerState,
    key: Key | int | Callable[..., Any] | None = None,
    steps: int = 0,
    eval_fn: Callable[..., Any] | None = None,
    num_arms: int = 1,
) -> tuple[OptimizerState, Key, list[dict[str, Any]]] | tuple[OptimizerState, np.ndarray]
    }
    \p{Fold \code{steps} sequential pure optimization rounds over \code{state}, either splitting an explicit \code{Key} stream with trace records or running a shorthand objective loop.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Initial optimizer snapshot.}
          \li{\code{key} (\em{Key | int | Callable[..., Any] | None}, default \code{None}) — Root PRNG key (defaults to \code{state.key} when \code{eval_fn} is provided), or a callable objective when \code{eval_fn is None}.}
          \li{\code{steps} (\em{int}, default \code{0}) — Nonnegative number of optimization rounds (\code{steps >= 0}).}
          \li{\code{eval_fn} (\em{Callable[..., Any] | None}, default \code{None}) — Objective accepting \code{batch.points} of shape \code{(num_arms, D)} (or \code{(step_idx, batch.points)} if 1-arg call raises \code{TypeError}).}
          \li{\code{num_arms} (\em{int}, default \code{1}) — Arms proposed per round.}
        }
      }
      \<dt>{Returns}
      \<dd>{When \code{eval_fn} is provided: \code{(final_state, next_key, traces)}, where each element of \code{traces} is a \code{dict} exposing \code{"step"} (\code{int}), \code{"best_y"} (\code{float | None}), and lazy \code{"digest"} (\code{str}). When \code{eval_fn is None} and \code{key} is callable: \code{(final_state, history)} where \code{history} is a read-only \code{(steps, num_arms)} \code{float64} reward matrix.}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — If \code{steps < 0} or if \code{eval_fn is None} when \code{key} is not callable.}
    }
  }

  \<div>[id]{baux.pmap}[class]{api-entry}[data-symbol]{baux.pmap}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.pmap}](#baux.pmap)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.pmap(
    state: OptimizerState,
    key: Key | int | None,
    branches: int,
    branch_fn: Callable[..., Any],
) -> list[Any]
    }
    \p{Split \code{key} into \code{branches} independent subkeys, fork \code{state} per branch, and execute \code{branch_fn(branch_idx, branch_state, subkey)} concurrently across threads.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Base snapshot forked independently per worker without shared mutable state.}
          \li{\code{key} (\em{Key | int | None}) — Root key split across \code{branches} (defaults to \code{state.key} when \code{None}).}
          \li{\code{branches} (\em{int}) — Nonnegative branch count (\code{0} returns \code{[]}).}
          \li{\code{branch_fn} (\em{Callable[..., Any]}) — Worker function with signature \code{(branch_idx: int, branch_state: OptimizerState, subkey: Key) -> Any}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{list[Any]} — Collected branch return values ordered by branch index \code{0 .. branches - 1}.}
      \<dt>{Notes}
      \<dd>{Native Rust ENN search, LOO fitting, and candidate generation release the Python GIL, enabling true multi-core execution inside \code{ThreadPoolExecutor}.}
    }
  }

  \<div>[id]{baux.digest}[class]{api-entry}[data-symbol]{baux.digest}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.digest}](#baux.digest)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.digest(state: OptimizerState) -> str
    }
    \p{Return the canonical 64-character lowercase hexadecimal BLAKE3 digest of \code{state}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Snapshot to hash.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{str} — 64-hex-character BLAKE3 digest covering domain bounds, configuration, ingested observations, and regional controller state.}
    }
  }

  \<div>[id]{baux.freeze}[class]{api-entry}[data-symbol]{baux.freeze}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.freeze}](#baux.freeze)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.freeze(state: OptimizerState) -> bytes
    }
    \p{Serialize \code{state} into a deterministic, self-framing binary checkpoint without \code{pickle} or arbitrary code execution.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Snapshot to serialize.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{bytes} — Portable binary wire representation suitable for [\code{baux.thaw}](#baux.thaw).}
    }
  }

  \<div>[id]{baux.thaw}[class]{api-entry}[data-symbol]{baux.thaw}[data-kind]{function}[data-module]{baux.functional}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.thaw}](#baux.thaw)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.thaw(state: OptimizerState, data: bytes) -> OptimizerState
    }
    \p{Restore a new \code{OptimizerState} from binary checkpoint \code{data} against template \code{state} without mutating \code{state}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{OptimizerState}) — Template snapshot defining expected domain bounds, dimension \code{D}, \code{spec}, and optimizer configuration layout.}
          \li{\code{data} (\em{bytes}) — Binary payload produced by [\code{baux.freeze}](#baux.freeze).}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{OptimizerState} — Restored immutable snapshot at \code{epoch = state.epoch + 1}.}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — If \code{data} has an invalid magic header, unsupported wire version, mismatched domain bounds/dimension/layout, non-finite values, truncated slices, trailing bytes, or out-of-bounds dimensions.}
      \<dt>{Notes}
      \<dd>{Every buffer passed to \code{baux.thaw} is treated as untrusted input across the Python/Rust FFI boundary: the parser validates wire headers, enforces hard upper caps on \code{D}, observation count \code{N}, target dimension \code{M}, and trust-region count \code{R}, computes byte lengths with checked integer arithmetic, and allocates fallibly (\code{Vec::try_reserve_exact}) so malformed inputs deterministically raise \code{ValueError} rather than panicking or aborting.}
    }
  }
}

