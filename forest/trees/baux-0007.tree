  \<div>[id]{baux.enn_init}[class]{api-entry}[data-symbol]{baux.enn_init}[data-kind]{function}[data-module]{baux.enn}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.enn_init}](#baux.enn_init)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.enn_init(
    train_x: np.ndarray | Any,
    train_y: np.ndarray | Any,
    train_yvar: np.ndarray | Any = None,
    *,
    scale_x: bool = False,
    stiefel: Stiefel | np.ndarray | None = None,
    affine: Affine | tuple[Any, Any, Any] | None = None,
    **options: Any,
) -> ENNState
    }
    \p{Construct an immutable [\code{ENNState}](#baux.ENNState) over training observations without mutating caller arrays. Also exported in \code{baux.enn} as \code{baux.enn.init}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{train_x} (\em{array-like of shape (N, D)}) — Training feature coordinates (\code{float64}).}
          \li{\code{train_y} (\em{array-like of shape (N,) or (N, M)}) — Training target values (reshaped internally to \code{(N, 1)} when 1D).}
          \li{\code{train_yvar} (\em{array-like of shape (N,) or (N, M) | None}, default \code{None}) — Optional known observation noise variances.}
          \li{\code{scale_x} (\em{bool}, keyword-only, default \code{False}) — Standardize input features by empirical column standard deviation.}
          \li{\code{stiefel} (\em{Stiefel | np.ndarray | None}, keyword-only, default \code{None}) — Optional [\code{Stiefel}](#baux.Stiefel) subspace frame.}
          \li{\code{affine} (\em{Affine | tuple | None}, keyword-only, default \code{None}) — Optional [\code{Affine}](#baux.Affine) posterior location-scale map.}
          \li{\code{**options} (\em{Any}) — Forwarded to [\code{baux.ENN}](#baux.ENN): \code{index}, \code{index_driver}, \code{storage}, \code{enn_storage}, \code{work_dir}, \code{device}, \code{y_bounds}, \code{metric_learning}, \code{tied_dims}, \code{unscaled_dims}, \code{metric_seed}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{ENNState} — Immutable surrogate snapshot.}
    }
  }

  \<div>[id]{baux.enn_append}[class]{api-entry}[data-symbol]{baux.enn_append}[data-kind]{function}[data-module]{baux.enn}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.enn_append}](#baux.enn_append)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.enn_append(
    state: ENNState,
    x: np.ndarray | Any,
    y: np.ndarray | Any,
    y_var: np.ndarray | Any = None,
) -> ENNState
    }
    \p{Return a new \code{ENNState} with \code{(x, y)} appended via Rust copy-on-write (\code{append_cow}), leaving \code{state} untouched. Exported at top level under both \code{baux.enn_append} and the alias \code{baux.append}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{ENNState}) — Existing surrogate snapshot.}
          \li{\code{x} (\em{array-like of shape (K, D) or (D,)}) — New input rows.}
          \li{\code{y} (\em{array-like of shape (K, M) or (K,)}) — New target rows.}
          \li{\code{y_var} (\em{array-like of shape (K, M) or (K,) | None}, default \code{None}) — Optional noise variances (presence must match \code{state.y_var is not None}).}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{ENNState} — Copy-on-write snapshot containing \code{len(state) + K} observations.}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — If \code{(state.y_var is None) != (y_var is None)} or if column dimensions disagree.}
    }
  }

  \<div>[id]{baux.enn_fit}[class]{api-entry}[data-symbol]{baux.enn_fit}[data-kind]{function}[data-module]{baux.enn}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.enn_fit}](#baux.enn_fit)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.enn_fit(
    state: ENNState,
    k: int = 10,
    *,
    num_candidates: int = 100,
    num_samples: int = 10,
    infer_aleatoric: bool = True,
    key: Key | None = None,
    seed: int | np.random.Generator | None = None,
    warm: ENNParams | None = None,
) -> ENNParams
    }
    \p{Stateless hyperparameter fit maximizing subsampled leave-one-out Gaussian log-pseudolikelihood over \code{(epistemic_scale, aleatoric_scale)}. Exported at top level under both \code{baux.enn_fit} and the alias \code{baux.fit}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{ENNState}) — Surrogate state to fit.}
          \li{\code{k} (\em{int}, default \code{10}) — Neighbor count \code{k_neighbors > 0}.}
          \li{\code{num_candidates} (\em{int}, keyword-only, default \code{100}) — Log-uniform Monte Carlo scale candidates evaluated.}
          \li{\code{num_samples} (\em{int}, keyword-only, default \code{10}) — Subsampled LOO training rows scored per candidate.}
          \li{\code{infer_aleatoric} (\em{bool}, keyword-only, default \code{True}) — Optimize \code{aleatoric_scale} jointly rather than fixing it to zero.}
          \li{\code{key} (\em{Key | None}, keyword-only, default \code{None}) — PRNG key (defaults deterministically to \code{state.key.fold(k).fold(num_samples)} when both \code{key} and \code{seed} are \code{None}).}
          \li{\code{seed} (\em{int | np.random.Generator | None}, keyword-only, default \code{None}) — Optional integer or NumPy \code{Generator} seed.}
          \li{\code{warm} (\em{ENNParams | None}, keyword-only, default \code{None}) — Optional warm-start candidate included in the LOO tournament.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{ENNParams} — Fitted hyperparameter record.}
    }
  }

  \<div>[id]{baux.enn_posterior}[class]{api-entry}[data-symbol]{baux.enn_posterior}[data-kind]{function}[data-module]{baux.enn}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.enn_posterior}](#baux.enn_posterior)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.enn_posterior(
    state: ENNState,
    x: np.ndarray | Any,
    params: ENNParams,
    *,
    flags: PosteriorFlags | None = None,
) -> ENNNormal | Posterior
    }
    \p{Pure posterior query evaluating precision-weighted predictive moments at \code{x}. Exported at top level under both \code{baux.enn_posterior} and the alias \code{baux.posterior}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{ENNState}) — Immutable surrogate state.}
          \li{\code{x} (\em{ndarray of shape (Q, D) | DLPack FP32 tensor}) — Host query coordinates (\code{float64}) or contiguous FP32 device tensor on an explicit Metal/CUDA index.}
          \li{\code{params} (\em{ENNParams}) — Neighbor count and variance scales.}
          \li{\code{flags} (\em{PosteriorFlags | None}, keyword-only, default \code{None}) — Optional \code{baux.enn.PosteriorFlags(exclude_nearest=False, observation_noise=False, tie_neighbors=True)}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{ENNNormal} for host NumPy queries (\code{.mu}, \code{.se}, \code{.se_epi}, \code{.se_ale} of shape \code{(Q, M)} and \code{.idx} of shape \code{(Q, k_eff)}), or native device-resident [\code{Posterior}](#baux.Posterior) for DLPack GPU queries.}
      \<dt>{Notes}
      \<dd>{Each neighbor's working variance is bounded below by the numerical floor \code{1e-9 * sigma_y**2} (\code{ENN._EPS_VAR = 1e-9}) before reciprocal precision weighting, ensuring finite moments when \code{x} coincides with a noiseless training point.}
    }
  }

  \<div>[id]{baux.enn_sample}[class]{api-entry}[data-symbol]{baux.enn_sample}[data-kind]{function}[data-module]{baux.enn}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.enn_sample}](#baux.enn_sample)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.enn_sample(
    state: ENNState,
    x: np.ndarray | Any,
    params: ENNParams,
    *,
    key: Key | int | None = None,
    num_draws: int = 1,
    seeds: np.ndarray | list[int] | tuple[int, ...] | None = None,
    flags: PosteriorFlags | None = None,
) -> tuple[np.ndarray, np.ndarray]
    }
    \p{Draw spatially coherent latent (or noisy) posterior function evaluations at query rows \code{x} via datum-indexed hash normals. Exported at top level under both \code{baux.enn_sample} and the alias \code{baux.sample}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{state} (\em{ENNState}) — Immutable surrogate state.}
          \li{\code{x} (\em{ndarray of shape (Q, D)}) — Query coordinate matrix.}
          \li{\code{params} (\em{ENNParams}) — Fitted or manual ENN hyperparameters.}
          \li{\code{key} (\em{Key | int | None}, keyword-only, default \code{None}) — PRNG key split into \code{num_draws} function seeds (defaults to \code{state.key} folded with a BLAKE3 hash of \code{x}).}
          \li{\code{num_draws} (\em{int}, keyword-only, default \code{1}) — Number of independent function realizations when \code{seeds is None}.}
          \li{\code{seeds} (\em{Sequence[int] | np.ndarray | None}, keyword-only, default \code{None}) — Explicit 63-bit integer function seeds overriding \code{key} and \code{num_draws}.}
          \li{\code{flags} (\em{PosteriorFlags | None}, keyword-only, default \code{None}) — Optional exclusion, observation-noise, and tie-breaking flags.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{tuple[np.ndarray, np.ndarray]} — \code{(draws, idx)} where \code{draws} has shape \code{(Q, M, S)} (\code{float64}, \code{S = num_draws} or \code{len(seeds)}) and \code{idx} has shape \code{(Q, k_eff)} (\code{int64}).}
    }
  }

  \<div>[id]{baux.ENNState}[class]{api-entry}[data-symbol]{baux.ENNState}[data-kind]{class}[data-module]{baux.enn}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.ENNState}](#baux.ENNState)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
class baux.ENNState  (frozen dataclass; constructed via baux.enn_init)
    }
    \p{Immutable value token pairing read-only training arrays with a copy-on-write Rust \code{ENN} neighbor index.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{x} (\em{np.ndarray}) — Read-only \code{(N, D)} \code{float64} training coordinate matrix.}
          \li{\code{y} (\em{np.ndarray}) — Read-only \code{(N, M)} \code{float64} training target matrix.}
          \li{\code{y_var} (\em{np.ndarray | None}) — Read-only \code{(N, M)} \code{float64} observation noise variances, or \code{None}.}
          \li{\code{scale_x} (\em{bool}) — Whether empirical column standardization is active.}
          \li{\code{options} (\em{tuple[tuple[str, Any], ...]}) — Sorted immutable \code{(name, value)} configuration pairs.}
          \li{\code{num_dim} (\em{int}) — Input feature dimension \code{D}.}
          \li{\code{num_outputs} (\em{int}) — Output metric count \code{M}.}
          \li{\code{key} (\em{Key}) — Content-addressed 128-bit [\code{Key}](#baux.Key) hashed over \code{x}, \code{y}, \code{y_var}, and \code{options}.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{__len__() -> int} — Return number of training observations \code{N}.}
        }
      }
    }
  }

  \<div>[id]{baux.ENNParams}[class]{api-entry}[data-symbol]{baux.ENNParams}[data-kind]{class}[data-module]{baux.enn}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.ENNParams}](#baux.ENNParams)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.ENNParams(
    k_neighbors: int,
    epistemic_scale: float,
    aleatoric_scale: float,
)
    }
    \p{Frozen hyperparameter record governing ENN neighbor count and dimensionless epistemic/aleatoric variance multipliers.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{k_neighbors} (\em{int}) — Number of nearest neighbors aggregated per query (\code{k_neighbors > 0}).}
          \li{\code{epistemic_scale} (\em{float}) — Finite nonnegative distance-proportional dispersion scale \code{c_e >= 0.0}.}
          \li{\code{aleatoric_scale} (\em{float}) — Finite nonnegative homoscedastic noise variance ratio \code{s_0^2 >= 0.0}.}
        }
      }
    }
  }

  \<div>[id]{baux.Posterior}[class]{api-entry}[data-symbol]{baux.Posterior}[data-kind]{class}[data-module]{baux.enn}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.Posterior}](#baux.Posterior)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
class baux.Posterior  (native device-resident posterior; paired with host baux.enn.ENNNormal)
    }
    \p{Device-resident posterior snapshot returned by \code{ENN.device_posterior} (and \code{enn_posterior} / \code{ENN.posterior} on DLPack GPU tensors), owning read-only DLPack buffers without host round-trips.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{mean} (\em{Tensor}) — Read-only DLPack tensor of predictive means with shape \code{(Q, M)} on the model's accelerator.}
          \li{\code{se} (\em{Tensor}) — Read-only DLPack tensor of predictive standard errors with shape \code{(Q, M)} on the model's accelerator.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{draw(seeds: Sequence[int]) -> Tensor} — Compute shared-seed joint function draws on device, flattened to shape \code{(len(seeds) * Q, M)} (\code{float64} on CUDA; \code{float32} on Metal).}
        }
      }
      \<dt>{Notes}
      \<dd>{Host NumPy calls to [\code{baux.enn_posterior}](#baux.enn_posterior) and \code{ENN.posterior} return \code{baux.enn.ENNNormal}, exposing \code{mu} (\code{(Q, M)}), \code{se} (\code{(Q, M)}), \code{se_epi} (\code{(Q, M)}), \code{se_ale} (\code{(Q, M)}), \code{idx} (\code{(Q, k_eff)} \code{int64} or \code{None}), \code{y_bounds} (\code{(M, 2)} or \code{None}), and \code{sample(num_samples: int, rng: Generator, clip: float | None = None) -> np.ndarray} of shape \code{(Q, M, num_samples)} with logit/log Jacobian warping when finite \code{y_bounds} are configured.}
    }
  }

  \<div>[id]{baux.ENN}[class]{api-entry}[data-symbol]{baux.ENN}[data-kind]{class}[data-module]{baux.enn}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.ENN}](#baux.ENN)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.ENN(
    train_x: np.ndarray,
    train_y: np.ndarray,
    train_yvar: np.ndarray | None = None,
    *,
    scale_x: bool = False,
    index_driver: NeighborIndex = NeighborIndex.FLAT,
    work_dir: str | os.PathLike[str] | None = None,
    enn_storage: str | None = None,
    y_bounds: np.ndarray | None = None,
    **options: Any,
)
    }
    \p{Stateful Epistemic Nearest Neighbors model supporting incremental \code{add}, hypothetical \code{conditional_posterior} / \code{conditional_draw} fantasization, multi-hyperparameter \code{batch_posterior}, and zero-copy DLPack \code{device_posterior}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{device} (\em{str}) — Active execution backend (\code{"cpu"}, \code{"metal"}, \code{"cuda"}, or \code{"opencl"}).}
          \li{\code{index_kind} (\em{str}) — Resolved index topology (\code{"exact"}, \code{"hnsw"}, \code{"tree"}, or \code{"auto"}).}
          \li{\code{num_outputs} (\em{int}) — Target metric dimension \code{M}.}
          \li{\code{y_bounds} (\em{np.ndarray}) — \code{(M, 2)} \code{float64} lower/upper target bounds (\code{[-inf, +inf]} when unbounded).}
          \li{\code{metric} (\em{DiagonalMetric | None}) — Learned diagonal metric weights and refit/rebuild counters when \code{metric_learning} is enabled, else \code{None}.}
          \li{\code{rust_backend} (\em{Any}) — Underlying native Rust \code{ENN} handle.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{add(x: np.ndarray, y: np.ndarray, yvar: np.ndarray | None = None) -> None} — Append \code{(K, D)} inputs and \code{(K, M)} targets in place.}
          \li{\code{posterior(x: Any, params: ENNParams, *, flags: PosteriorFlags | None = None) -> ENNNormal | Posterior} — Evaluate moments on host NumPy or DLPack GPU queries.}
          \li{\code{device_posterior(x: Any, params: ENNParams, *, flags: PosteriorFlags | None = None) -> Posterior} — Synchronous zero-copy FP32 GPU posterior supporting Torch CUDA, Torch MPS, and JAX CUDA DLPack arrays (JAX Metal arrays raise \code{ValueError} rather than copying silently via host RAM).}
          \li{\code{posterior_draw(x: np.ndarray, params: ENNParams, *, function_seeds: Sequence[int] | np.ndarray, flags: PosteriorFlags | None = None) -> tuple[np.ndarray, np.ndarray]} — Return \code{(draws, idx)} of shapes \code{(Q, M, S)} and \code{(Q, k_eff)}.}
          \li{\code{conditional_posterior(x_whatif: np.ndarray, y_whatif: np.ndarray, x: np.ndarray, *, params: ENNParams, flags: PosteriorFlags | None = None) -> ENNNormal} — Evaluate moments conditioned on hypothetical observations \code{(x_whatif, y_whatif)} without mutating stored data.}
          \li{\code{conditional_draw(x_whatif: np.ndarray, y_whatif: np.ndarray, x: np.ndarray, *, params: ENNParams, function_seeds: Sequence[int] | np.ndarray, flags: PosteriorFlags | None = None) -> tuple[np.ndarray, np.ndarray]} — Draw coherent samples conditioned on \code{(x_whatif, y_whatif)}.}
          \li{\code{batch_posterior(x: np.ndarray, paramss: list[ENNParams], *, flags: PosteriorFlags | None = None) -> ENNNormal} — Evaluate moments across \code{P} hyperparameter sets simultaneously.}
          \li{\code{neighbors(x: np.ndarray, k: int, *, exclude_nearest: bool = False) -> np.ndarray} — Return \code{int64} neighbor indices of shape \code{(k_eff,)} for a single query point.}
          \li{\code{train_rows(indices: list[int] | np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray | None]} — Fetch stored \code{(x, y, yvar)} rows by index.}
          \li{\code{ensure_sync() -> None}, \code{schedule_flush() -> None}, \code{persist_index() -> None}, \code{index_bytes() -> int}, \code{__len__() -> int} — Storage synchronization and memory introspection.}
        }
      }
    }
  }

  \<div>[id]{baux.ENNFitter}[class]{api-entry}[data-symbol]{baux.ENNFitter}[data-kind]{class}[data-module]{baux.enn}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.ENNFitter}](#baux.ENNFitter)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
baux.ENNFitter(
    k: int,
    rng: np.random.Generator,
    *,
    infer_aleatoric_variance_scale: bool = True,
)
    }
    \p{Stateful hyperparameter fitter maintaining streaming Welford target variance statistics alongside an incremental [\code{ENN}](#baux.ENN) model.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{tell(x: np.ndarray, y: np.ndarray, yvar: np.ndarray | None = None) -> None} — Register newly observed rows (total row count must match \code{len(model)} before \code{ask}).}
          \li{\code{ask(model: ENN, *, num_candidates: int, num_samples: int, params_warm_start: ENNParams | None = None) -> ENNParams} — Fit \code{ENNParams} by subsampled LOO log-pseudolikelihood.}
          \li{\code{y_std() -> np.ndarray} — Return \code{(M,)} \code{float64} empirical standard deviation per output metric.}
        }
      }
    }
  }

  \<div>[id]{baux.NeighborIndex}[class]{api-entry}[data-symbol]{baux.NeighborIndex}[data-kind]{class}[data-module]{baux.index}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.NeighborIndex}](#baux.NeighborIndex)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
class baux.NeighborIndex(enum.Enum)
    }
    \p{Enumeration selecting the nearest-neighbor search driver for [\code{ENN}](#baux.ENN), [\code{baux.enn}](#baux.enn), and \code{ENNSurrogate}.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{NeighborIndex.FLAT} — Exact SIMD \code{f64} CPU scan (wire driver \code{"exact"}).}
          \li{\code{NeighborIndex.AUTO} — Adaptive backend selection (wire driver \code{"auto"}).}
          \li{\code{NeighborIndex.USEARCH} — In-memory HNSW approximate graph index with exact \code{f64} pool certification (wire driver \code{"usearch"}).}
          \li{\code{NeighborIndex.BPANN_DISK} — Disk-backed tree index for large observation histories (wire driver \code{"bpann_disk"}).}
          \li{\code{NeighborIndex.METAL} — Apple Metal GPU exact distance sweep (wire driver \code{"metal"}).}
          \li{\code{NeighborIndex.CUDA} — NVIDIA CUDA / cuVS GPU distance kernel (wire driver \code{"cuda"}).}
          \li{\code{NeighborIndex.OPENCL} — OpenCL GPU distance driver (wire driver \code{"opencl"}).}
        }
      }
    }
  }

  \<div>[id]{baux.DistanceMetric}[class]{api-entry}[data-symbol]{baux.DistanceMetric}[data-kind]{class}[data-module]{baux.index}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.DistanceMetric}](#baux.DistanceMetric)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
class baux.DistanceMetric(enum.Enum)
    }
    \p{Enumeration of base pairwise distance metrics supported by neighbor indices.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{DistanceMetric.SQUARED_L2 = "squared_l2"} — Squared Euclidean distance (required by \code{OptimizerConfig}).}
          \li{\code{DistanceMetric.COSINE = "cosine"} — Cosine angular dissimilarity for standalone index queries.}
        }
      }
    }
  }
}


