  \subtree{
    \title{Stateful Wrappers}

    \<div>[id]{baux.create_optimizer}[class]{api-entry}[data-symbol]{baux.create_optimizer}[data-kind]{function}[data-module]{baux.bo}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.create_optimizer}](#baux.create_optimizer)}
        \<span>[class]{api-kind-badge}{function}
      }
      \pre{
baux.create_optimizer(
    *,
    bounds: np.ndarray,
    config: OptimizerConfig,
    rng: np.random.Generator,
) -> Optimizer
      }
      \p{Validate domain bounds and configuration, initialize random state from \code{rng}, and construct an in-place stateful [\code{baux.Optimizer}](#baux.Optimizer).}
      \<dl>[class]{api-spec-list}{
        \<dt>{Parameters}
        \<dd>{
          \ul{
            \li{\code{bounds} (\em{ndarray of shape (D, 2)}, keyword-only) — Continuous coordinate bounds \code{[low, high]} for each feature dimension.}
            \li{\code{config} (\em{OptimizerConfig}, keyword-only) — Configuration record specifying surrogate, trust region, and acquisition rules.}
            \li{\code{rng} (\em{np.random.Generator}, keyword-only) — NumPy random generator providing the initial 63-bit seed.}
          }
        }
        \<dt>{Returns}
        \<dd>{\code{Optimizer} — Stateful optimization harness.}
        \<dt>{Example}
        \<dd>{
          \pre{
import numpy as np
import baux

bounds = np.array([[-1.0, 1.0], [-2.0, 2.0]])
cfg = (baux.enn(k=5) | baux.ucb(beta=1.5))()
rng = np.random.default_rng(0)
opt = baux.create_optimizer(bounds=bounds, config=cfg, rng=rng)
x = opt.ask(num_arms=3)
y = np.sum(x**2, axis=-1, keepdims=True)
pred = opt.tell(x, y)
telem = opt.telemetry()

assert x.shape == (3, 2)
assert pred.shape == (3, 1)
assert isinstance(telem, baux.Telemetry)
          }
        }
      }
    }

    \<div>[id]{baux.Optimizer}[class]{api-entry}[data-symbol]{baux.Optimizer}[data-kind]{class}[data-module]{baux.bo}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.Optimizer}](#baux.Optimizer)}
        \<span>[class]{api-kind-badge}{class}
      }
      \pre{
class baux.Optimizer  (constructed via baux.create_optimizer)
      }
      \p{Stateful in-place Bayesian optimization harness wrapping single-region and multi-region native solvers.}
      \<dl>[class]{api-spec-list}{
        \<dt>{Attributes}
        \<dd>{
          \ul{
            \li{\code{num_observations} (\em{int}) — Total observations committed to the optimizer.}
            \li{\code{num_regions} (\em{int}) — Configured trust region slots.}
            \li{\code{tr_length} (\em{float}) — Current side length of the primary trust region in unit coordinates.}
            \li{\code{init_progress} (\em{tuple[int, int] | None}) — \code{(completed, total)} warm-up evaluation counts, or \code{None}.}
            \li{\code{pending_ids} (\em{tuple[int, ...] | None}) — Outstanding proposal identities in original \code{ask} order.}
            \li{\code{ingestion_failure} (\em{str | None}) — Terminal background flush error message, or \code{None}.}
          }
        }
        \<dt>{Methods}
        \<dd>{
          \ul{
            \li{\code{ask(num_arms: int) -> np.ndarray} — Propose \code{num_arms >= 1} candidate coordinates inside \code{bounds}.}
            \li{\code{ask_batch(num_arms: int) -> AskBatch} — Multi-region proposal returning an \code{AskBatch} with typed \code{AskId} tokens.}
            \li{\code{tell(x: np.ndarray, y: np.ndarray, y_var: np.ndarray | None = None) -> np.ndarray} — Record observations and return fitted posterior means at \code{x}.}
            \li{\code{complete(ids: AskBatch | tuple[AskId, ...], y: np.ndarray, y_var: np.ndarray | None = None) -> None} — Complete a subset of pending proposals by \code{AskId}.}
            \li{\code{cancel(ids: AskBatch | tuple[AskId, ...]) -> None} — Cancel unevaluated pending proposals without recording rewards.}
            \li{\code{restart_region(slot: int, center: np.ndarray) -> tuple[AskId, ...]} — Restart a regional slot at \code{center}, returning abandoned \code{AskId} tokens.}
            \li{\code{import_observations(x: np.ndarray, y: np.ndarray, y_var: np.ndarray | None = None) -> np.ndarray} — Ingest external observations without crediting regional controllers.}
            \li{\code{posterior_mu(x: np.ndarray) -> np.ndarray} — Evaluate fitted surrogate means at \code{x} without recording observations.}
            \li{\code{telemetry() -> Telemetry} — Return timing and candidate metrics from the latest proposal round.}
          }
        }
      }
    }

    \<div>[id]{baux.ENN}[class]{api-entry}[data-symbol]{baux.ENN}[data-kind]{class}[data-module]{baux.enn}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.ENN}](#baux.ENN)}
        \<span>[class]{api-kind-badge}{class}
      }
      \pre{
baux.ENN(
    train_x: np.ndarray,
    train_y: np.ndarray,
    train_yvar: np.ndarray | None = None,
    *,
    scale_x: bool = False,
    index_driver: NeighborIndex = NeighborIndex.FLAT,
    work_dir: str | os.PathLike[str] | None = None,
    enn_storage: str | None = None,
    y_bounds: np.ndarray | None = None,
    **options: Any,
)
      }
      \p{Stateful Epistemic Nearest Neighbors surrogate supporting incremental updates, conditional queries, and accelerator execution.}
      \<dl>[class]{api-spec-list}{
        \<dt>{Attributes}
        \<dd>{
          \ul{
            \li{\code{device} (\em{str}) — Execution backend identifier (\code{"cpu"}, \code{"metal"}, \code{"cuda"}, or \code{"opencl"}).}
            \li{\code{index_kind} (\em{str}) — Resolved index topology (\code{"exact"}, \code{"hnsw"}, \code{"tree"}, or \code{"auto"}).}
            \li{\code{num_outputs} (\em{int}) — Target metric dimension \code{M}.}
            \li{\code{y_bounds} (\em{np.ndarray}) — \code{(M, 2)} output boundary constraints.}
            \li{\code{metric} (\em{DiagonalMetric | None}) — Learned diagonal metric diagnostics when enabled, else \code{None}.}
            \li{\code{rust_backend} (\em{Any}) — Underlying native Rust surrogate handle.}
          }
        }
        \<dt>{Methods}
        \<dd>{
          \ul{
            \li{\code{add(x: np.ndarray, y: np.ndarray, yvar: np.ndarray | None = None) -> None} — Append new observations in place.}
            \li{\code{posterior(x: Any, params: ENNParams, *, flags: PosteriorFlags | None = None) -> ENNNormal | Posterior} — Evaluate moments for host NumPy or DLPack device queries.}
            \li{\code{neighbors(x: np.ndarray, k: int, *, exclude_nearest: bool = False) -> np.ndarray} — Return neighbor row indices for a single query coordinate.}
            \li{\code{posterior_draw(x: np.ndarray, params: ENNParams, *, function_seeds: Sequence[int], flags: PosteriorFlags | None = None) -> tuple[np.ndarray, np.ndarray]} — Draw coherent function samples at query points.}
            \li{\code{conditional_posterior(x_whatif: np.ndarray, y_whatif: np.ndarray, x: np.ndarray, *, params: ENNParams, flags: PosteriorFlags | None = None) -> ENNNormal} — Evaluate moments conditioned on hypothetical data without mutating state.}
            \li{\code{device_posterior(x: Any, params: ENNParams, *, flags: PosteriorFlags | None = None) -> Posterior} — Synchronous zero-copy FP32 GPU posterior evaluation for DLPack arrays.}
          }
        }
      }
    }

    \<div>[id]{baux.ENNFitter}[class]{api-entry api-entry-compact}[data-symbol]{baux.ENNFitter}[data-kind]{class}[data-module]{baux.enn}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.ENNFitter}](#baux.ENNFitter)}
        \<span>[class]{api-kind-badge}{class}
      }
      \pre{
baux.ENNFitter(
    k: int,
    rng: np.random.Generator,
    *,
    infer_aleatoric_variance_scale: bool = True,
)
      }
      \p{Incremental stateful hyperparameter fitter maintaining streaming target variance statistics via \code{tell(x, y, yvar)}, fitting \code{ask(model, num_candidates=..., num_samples=...) -> ENNParams}, and reporting \code{y_std()}.}
    }

    \<div>[id]{baux.Telemetry}[class]{api-entry api-entry-compact}[data-symbol]{baux.Telemetry}[data-kind]{class}[data-module]{baux.turbo.optimizer_types}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.Telemetry}](#baux.Telemetry)}
        \<span>[class]{api-kind-badge}{class}
      }
      \pre{
baux.Telemetry(
    dt_fit: float,
    dt_sel: float,
    dt_gen: float = 0.0,
    dt_tell: float = 0.0,
    num_candidates: int = 0,
)
      }
      \p{Frozen slotted dataclass reporting native wall-clock phase durations in seconds (\code{dt_fit}, \code{dt_sel}, \code{dt_gen}, \code{dt_tell}) and candidate pool size (\code{num_candidates}) from the latest proposal round.}
    }

    \<div>[id]{baux.TellPredictionError}[class]{api-entry api-entry-compact}[data-symbol]{baux.TellPredictionError}[data-kind]{class}[data-module]{baux.bo}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.TellPredictionError}](#baux.TellPredictionError)}
        \<span>[class]{api-kind-badge}{class}
      }
      \pre{
class baux.TellPredictionError(RuntimeError)
      }
      \p{Exception raised when observation ingestion succeeds in the native store but the subsequent \code{posterior_mu} call fails; invariant \code{observations_accepted = True} confirms observations were recorded and must not be resubmitted.}
    }
  }

  \subtree{
    \title{Configuration Records & Presets}

    \<div>[id]{baux.OptimizerConfig}[class]{api-entry}[data-symbol]{baux.OptimizerConfig}[data-kind]{class}[data-module]{baux.turbo.config}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.OptimizerConfig}](#baux.OptimizerConfig)}
        \<span>[class]{api-kind-badge}{class}
      }
      \pre{
baux.OptimizerConfig(
    trust_region: TrustRegionConfig = TurboTrustRegion(),
    candidates: CandidateConfig = CandidateConfig(),
    init: InitConfig = InitConfig(),
    surrogate: Surrogate = NoSurrogate(),
    acquisition: AcquisitionConfig = RandomAcquisitionConfig(),
    acq_optimizer: AcqOptimizerConfig = ...,
    observation_history: ObservationHistoryConfig = ObservationHistoryConfig(),
)
      }
      \p{Composite configuration record defining trust region behavior, candidate sampling, warm-up initialization, surrogate architecture, and acquisition optimization.}
      \<dl>[class]{api-spec-list}{
        \<dt>{Attributes}
        \<dd>{
          \ul{
            \li{\code{trust_region} (\em{TrustRegionConfig}) — Trust region policy (\code{TurboTrustRegion}, \code{MorboTrustRegion}, \code{RegionalSearchPolicy}, or \code{NoTrustRegion}).}
            \li{\code{candidates} (\em{CandidateConfig}) — Candidate sampling rules and budget.}
            \li{\code{init} (\em{InitConfig}) — Warm-up evaluation strategy and initial sample size.}
            \li{\code{surrogate} (\em{Surrogate}) — Fitted surrogate model (\code{ENNSurrogate}, \code{GaussianProcess}, \code{ExternalSurrogate}, or \code{NoSurrogate}).}
            \li{\code{acquisition} (\em{AcquisitionConfig}) — Acquisition function specification (\code{UCB}, \code{Thompson}, \code{Pareto}, or \code{Random}).}
            \li{\code{acq_optimizer} (\em{AcqOptimizerConfig}) — Acquisition optimizer strategy.}
            \li{\code{num_metrics} (\em{int | None}) — Target objective metric count for multi-objective trust regions.}
          }
        }
      }
    }

    \<div>[id]{baux.RegionalSearchPolicy}[class]{api-entry}[data-symbol]{baux.RegionalSearchPolicy}[data-kind]{class}[data-module]{baux.region}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.RegionalSearchPolicy}](#baux.RegionalSearchPolicy)}
        \<span>[class]{api-kind-badge}{class}
      }
      \pre{
baux.RegionalSearchPolicy(
    count: int = 4,
    length: TrustRegionBounds = TrustRegionBounds(),
    success_tolerance: int = 3,
    failure_tolerance: int = 5,
    sharing: Literal["box_contain", "ellipsoid_ball", "nearest_center", "origin_only"] = "box_contain",
    allocation: Literal["incumbent_ucb1", "least_trials", "joint_acquisition"] = "incumbent_ucb1",
    restart_memory: Literal["fresh", "retain_relevant"] = "fresh",
    restart_center: RestartCenterPolicy = RestartCenterPolicy(),
    controller: Literal["turbo", "fixed_radius"] = "turbo",
    acquisitions: tuple[AcquisitionConfig | None, ...] = (),
)
      }
      \p{Multi-region trust region policy managing concurrent region allocations, observation sharing rules, and restart conditions.}
      \<dl>[class]{api-spec-list}{
        \<dt>{Attributes}
        \<dd>{
          \ul{
            \li{\code{count} (\em{int}, default \code{4}) — Number of active regional trust region slots.}
            \li{\code{length} (\em{TrustRegionBounds}) — Side length bounds governing contraction and expansion.}
            \li{\code{success_tolerance} (\em{int}, default \code{3}) — Consecutive improvements required before expanding side length.}
            \li{\code{failure_tolerance} (\em{int}, default \code{5}) — Consecutive non-improving steps before contracting side length.}
            \li{\code{sharing} (\em{str}, default \code{"box_contain"}) — Observation sharing policy across regions (\code{"box_contain"}, \code{"ellipsoid_ball"}, \code{"nearest_center"}, or \code{"origin_only"}).}
            \li{\code{allocation} (\em{str}, default \code{"incumbent_ucb1"}) — Multi-armed bandit arm allocation policy across regions.}
            \li{\code{controller} (\em{str}, default \code{"turbo"}) — Local search controller (\code{"turbo"} or \code{"fixed_radius"}).}
          }
        }
      }
    }

    \<div>[id]{baux.TrustRegionBounds}[class]{api-entry api-entry-compact}[data-symbol]{baux.TrustRegionBounds}[data-kind]{class}[data-module]{baux.turbo.config}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.TrustRegionBounds}](#baux.TrustRegionBounds)}
        \<span>[class]{api-kind-badge}{class}
      }
      \pre{
baux.TrustRegionBounds(
    length_init: float = 0.8,
    length_min: float = 0.5**7,
    length_max: float = 1.6,
)
      }
      \p{Frozen dataclass specifying side length limits for trust regions, validating \code{0 < length_min <= length_init <= length_max}.}
    }

    \<div>[id]{baux.turbo_enn}[class]{api-entry api-entry-compact}[data-symbol]{baux.turbo_enn}[data-kind]{function}[data-module]{baux.turbo.config}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.turbo_enn}](#baux.turbo_enn)}
        \<span>[class]{api-kind-badge}{function}
      }
      \pre{
baux.turbo_enn(
    *,
    enn: ENNSurrogate | None = None,
    trust_region: TrustRegionConfig | None = None,
    candidates: CandidateConfig | None = None,
    num_init: int | None = None,
    acquisition: AcquisitionKind = AcquisitionKind.PARETO,
) -> OptimizerConfig
      }
      \p{Preset factory returning an [\code{baux.OptimizerConfig}](#baux.OptimizerConfig) backed by an Epistemic Nearest Neighbors surrogate; equivalent to composable pipeline \code{baux.enn(...) | baux.ucb(...)} or \code{baux.pareto(...)}.}
    }

    \<div>[id]{baux.turbo_one}[class]{api-entry api-entry-compact}[data-symbol]{baux.turbo_one}[data-kind]{function}[data-module]{baux.turbo.config}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.turbo_one}](#baux.turbo_one)}
        \<span>[class]{api-kind-badge}{function}
      }
      \pre{
baux.turbo_one(
    *,
    num_candidates: int | None = None,
    num_init: int | None = None,
    trust_region: TrustRegionConfig | None = None,
    sampler: CandidateSampler = CandidateSampler.SOBOL,
    acquisition: AcquisitionKind = AcquisitionKind.THOMPSON,
) -> OptimizerConfig
      }
      \p{Preset factory returning a TuRBO-1 [\code{baux.OptimizerConfig}](#baux.OptimizerConfig) backed by an exact Gaussian Process surrogate with Thompson or UCB acquisition.}
    }

    \<div>[id]{baux.turbo_zero}[class]{api-entry api-entry-compact}[data-symbol]{baux.turbo_zero}[data-kind]{function}[data-module]{baux.turbo.config}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.turbo_zero}](#baux.turbo_zero)}
        \<span>[class]{api-kind-badge}{function}
      }
      \pre{
baux.turbo_zero(
    *,
    num_candidates: int | None = None,
    num_candidates_per_arm: int | None = None,
    num_init: int | None = None,
    trust_region: TrustRegionConfig | None = None,
    sampler: CandidateSampler = CandidateSampler.SOBOL,
) -> OptimizerConfig
      }
      \p{Preset factory returning a surrogate-free TuRBO-0 [\code{baux.OptimizerConfig}](#baux.OptimizerConfig) using local trust region bounds with random candidate acquisition.}
    }

    \<div>[id]{baux.lhd_only}[class]{api-entry api-entry-compact}[data-symbol]{baux.lhd_only}[data-kind]{function}[data-module]{baux.turbo.config}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.lhd_only}](#baux.lhd_only)}
        \<span>[class]{api-kind-badge}{function}
      }
      \pre{
baux.lhd_only(
    *,
    num_candidates: int | None = None,
    num_init: int | None = None,
    trust_region: TrustRegionConfig | None = None,
    sampler: CandidateSampler = CandidateSampler.SOBOL,
) -> OptimizerConfig
      }
      \p{Preset factory returning an [\code{baux.OptimizerConfig}](#baux.OptimizerConfig) configured for space-filling Latin Hypercube Design sampling without surrogate modeling or trust regions.}
    }

    \<div>[id]{baux.enn_optimizer}[class]{api-entry api-entry-compact}[data-symbol]{baux.enn_optimizer}[data-kind]{function}[data-module]{baux.bo}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.enn_optimizer}](#baux.enn_optimizer)}
        \<span>[class]{api-kind-badge}{function}
      }
      \pre{
baux.enn_optimizer(
    bounds: np.ndarray,
    k: int = 10,
    num_init: int = 10,
    seed: int | None = None,
    config: Any = None,
) -> BayesOptimizer
      }
      \p{Low-level PyO3 constructor returning a native Rust single-region TuRBO-ENN optimizer; prefer [\code{baux.init}](#baux.init) or [\code{baux.create_optimizer}](#baux.create_optimizer) for validated configurations and PyTree domains.}
    }

    \<div>[id]{baux.create_zero}[class]{api-entry api-entry-compact}[data-symbol]{baux.create_zero}[data-kind]{function}[data-module]{baux.bo}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.create_zero}](#baux.create_zero)}
        \<span>[class]{api-kind-badge}{function}
      }
      \pre{
baux.create_zero(
    bounds: np.ndarray,
    num_init: int = 10,
    seed: int | None = None,
    config: Any = None,
) -> BayesOptimizer
      }
      \p{Low-level PyO3 constructor returning a native Rust surrogate-free TuRBO-0 optimizer handle.}
    }

    \<div>[id]{baux.create_lhd}[class]{api-entry api-entry-compact}[data-symbol]{baux.create_lhd}[data-kind]{function}[data-module]{baux.bo}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.create_lhd}](#baux.create_lhd)}
        \<span>[class]{api-kind-badge}{function}
      }
      \pre{
baux.create_lhd(
    bounds: np.ndarray,
    num_init: int = 10,
    seed: int | None = None,
    config: Any = None,
) -> BayesOptimizer
      }
      \p{Low-level PyO3 constructor returning a native Rust Latin Hypercube Design baseline optimizer handle.}
    }
  }

  \subtree{
    \title{Runtime & Optional Integrations}

    \<div>[id]{baux.capabilities}[class]{api-entry}[data-symbol]{baux.capabilities}[data-kind]{function}[data-module]{baux.runtime}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.capabilities}](#baux.capabilities)}
        \<span>[class]{api-kind-badge}{function}
      }
      \pre{
baux.capabilities(*, probe: bool = False) -> tuple[BackendCapabilities, ...]
      }
      \p{Inspect the installed native extension capabilities across CPU, CUDA, Metal, and OpenCL backends, optionally exercising device hardware when \code{probe=True}.}
      \<dl>[class]{api-spec-list}{
        \<dt>{Parameters}
        \<dd>{
          \ul{
            \li{\code{probe} (\em{bool}, keyword-only, default \code{False}) — When \code{False}, inspects compile-time inclusion without hardware queries; when \code{True}, runs active hardware checks.}
          }
        }
        \<dt>{Returns}
        \<dd>{\code{tuple[BackendCapabilities, ...]} — Capability records ordered \code{("cpu", "cuda", "metal", "opencl")}.}
      }
    }

    \<div>[id]{baux.BackendCapabilities}[class]{api-entry}[data-symbol]{baux.BackendCapabilities}[data-kind]{class}[data-module]{baux.runtime}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.BackendCapabilities}](#baux.BackendCapabilities)}
        \<span>[class]{api-kind-badge}{class}
      }
      \pre{
baux.BackendCapabilities(
    name: Literal["cpu", "cuda", "metal", "opencl"],
    compiled: bool,
    available: bool | None,
    reason: str | None,
    direct_operations: tuple[str, ...],
    fallback_operations: tuple[str, ...],
    missing_operations: tuple[str, ...],
    host_operations: tuple[str, ...],
    array_frameworks: tuple[str, ...],
)
      }
      \p{Frozen slotted dataclass describing native build support, hardware availability, operation execution tiers, and detected Python array frameworks for one backend.}
      \<dl>[class]{api-spec-list}{
        \<dt>{Attributes}
        \<dd>{
          \ul{
            \li{\code{name} (\em{Literal["cpu", "cuda", "metal", "opencl"]}) — Canonical backend identifier.}
            \li{\code{compiled} (\em{bool}) — Whether the active binary was compiled with support for this backend.}
            \li{\code{available} (\em{bool | None}) — Hardware availability outcome (\code{True} or \code{False} when probed or uncompiled; \code{None} for unprobed compiled backends).}
            \li{\code{reason} (\em{str | None}) — Diagnostic message when \code{compiled=False} or \code{available=False}, else \code{None}.}
            \li{\code{direct_operations} (\em{tuple[str, ...]}) — Operations executing directly on the target device.}
            \li{\code{fallback_operations} (\em{tuple[str, ...]}) — Operations routed to host CPU fallbacks.}
            \li{\code{missing_operations} (\em{tuple[str, ...]}) — Operations unsupported on this backend.}
            \li{\code{host_operations} (\em{tuple[str, ...]}) — Operations executed in float64 precision on the host CPU.}
            \li{\code{array_frameworks} (\em{tuple[str, ...]}) — Installed optional Python array packages detected via \code{importlib.util.find_spec} among \code{("torch", "jax")}.}
          }
        }
      }
    }

    \<div>[id]{baux.Device}[class]{api-entry api-entry-compact}[data-symbol]{baux.Device}[data-kind]{class}[data-module]{baux.runtime}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.Device}](#baux.Device)}
        \<span>[class]{api-kind-badge}{class}
      }
      \pre{
baux.Device(name: str = "auto") -> Device
      }
      \p{Native accelerator context selector resolving \code{"auto"}, \code{"cpu"}, \code{"metal"}, or \code{"cuda"}, with constructors \code{Device.auto()}, \code{Device.cpu()}, \code{Device.metal()}, \code{Device.cuda()}, and memory telemetry via \code{memory_info()}.}
    }

    \<div>[id]{baux.optuna.Sampler}[class]{api-entry}[data-symbol]{baux.optuna.Sampler}[data-kind]{class}[data-module]{baux.optuna}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.optuna.Sampler}](#baux.optuna.Sampler)}
        \<span>[class]{api-kind-badge}{class}
      }
      \pre{
baux.optuna.Sampler(
    space: Mapping[str, FloatDistribution],
    *,
    config: OptimizerConfig | None = None,
    seed: int | None = None,
)
      }
      \p{Subclass of \code{optuna.samplers.BaseSampler} routing fixed continuous single-objective Optuna studies through BAUX. Imported via \code{import baux.optuna} (requires optional \code{optuna} package).}
      \<dl>[class]{api-spec-list}{
        \<dt>{Parameters}
        \<dd>{
          \ul{
            \li{\code{space} (\em{Mapping[str, FloatDistribution]}) — Continuous search space mapping parameter names to \code{FloatDistribution} instances.}
            \li{\code{config} (\em{OptimizerConfig | None}, keyword-only, default \code{None}) — Optional optimizer configuration (defaults to \code{OptimizerConfig()}).}
            \li{\code{seed} (\em{int | None}, keyword-only, default \code{None}) — Optional integer seed for reproducible evaluation orders.}
          }
        }
        \<dt>{Methods}
        \<dd>{
          \ul{
            \li{\code{infer_relative_search_space(study, trial) -> dict} — Return the declared fixed parameter space.}
            \li{\code{sample_relative(study, trial, search_space) -> dict} — Ingest completed trial history and suggest the next candidate point.}
            \li{\code{sample_independent(study, trial, param_name, param_distribution) -> Any} — Raises \code{ValueError} to reject undeclared or dynamic parameters.}
            \li{\code{reseed_rng() -> None} — Raises \code{RuntimeError} to enforce single-worker (\code{n_jobs=1}) usage.}
          }
        }
      }
    }

    \<div>[id]{baux.experimental.program}[class]{api-entry api-entry-compact}[data-symbol]{baux.experimental.program}[data-kind]{module}[data-module]{baux.experimental.program}{
      \<div>[class]{api-entry-header}{
        \<span>[class]{api-entry-title}{[\code{baux.experimental.program}](#baux.experimental.program)}
        \<span>[class]{api-kind-badge}{module}
      }
      \pre{
baux.experimental.program
      }
      \p{Experimental compilation and resident buffer execution interface lowering StableHLO MLIR modules or traced functions to IREE, TVM, or XLA backends, exposing \code{compile}, \code{Executable}, \code{Buffer}, \code{TensorSpec}, and \code{register}.}
    }
  }
}
