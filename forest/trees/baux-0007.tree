  \<div>[id]{baux.create_optimizer}[class]{api-entry}[data-symbol]{baux.create_optimizer}[data-kind]{function}[data-module]{baux.bo}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.create_optimizer}](#baux.create_optimizer)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.create_optimizer(
    *,
    bounds: np.ndarray,
    config: OptimizerConfig,
    rng: np.random.Generator,
) -> Optimizer
    }
    \p{Validate domain bounds and configuration, draw a 63-bit base seed from \code{rng}, and construct an in-place stateful [\code{Optimizer}](#baux.Optimizer).}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{bounds} (\em{ndarray of shape (D, 2)}, keyword-only) — Finite continuous lower and upper coordinate bounds \code{[low, high]} (\code{float64}, \code{D >= 1}, \code{low <= high}).}
          \li{\code{config} (\em{OptimizerConfig}, keyword-only) — Composite [\code{OptimizerConfig}](#baux.OptimizerConfig) validated against \code{D}.}
          \li{\code{rng} (\em{np.random.Generator}, keyword-only) — NumPy random generator supplying the initial 63-bit native seed.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{Optimizer} — Stateful optimization harness.}
      \<dt>{Raises}
      \<dd>{\code{ValueError} — If \code{bounds} is non-finite, empty, not shape \code{(D, 2)} with \code{low <= high}, or if \code{config} fails validation.}
    }
  }

  \<div>[id]{baux.Optimizer}[class]{api-entry}[data-symbol]{baux.Optimizer}[data-kind]{class}[data-module]{baux.bo}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.Optimizer}](#baux.Optimizer)}
      \<span>[class]{api-kind-badge}{class}
    }
    \pre{
class baux.Optimizer  (constructed via baux.create_optimizer)
    }
    \p{Stateful in-place Bayesian optimization harness wrapping the native Rust single-region (\code{BayesOptimizer}) and multi-region (\code{MultiRegionOptimizer}) engines.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Attributes}
      \<dd>{
        \ul{
          \li{\code{num_observations} (\em{int}) — Total count \code{N} of observations recorded across the global store (also returned by \code{len(optimizer)} and alias \code{region_count}).}
          \li{\code{num_regions} (\em{int}) — Number of configured trust-region slots (\code{1} for single-region, \code{policy.count} for [\code{RegionalSearchPolicy}](#baux.RegionalSearchPolicy)).}
          \li{\code{tr_length} (\em{float}) — Current side length of the primary trust region in normalized unit-cube coordinates.}
          \li{\code{init_progress} (\em{tuple[int, int] | None}) — \code{(completed, total)} warm-up evaluation counts while initialization is active, else \code{None}.}
          \li{\code{pending_ids} (\em{tuple[int, ...] | None}) — Outstanding raw unsigned 64-bit evaluation IDs in original \code{ask} order, or \code{None} when no proposals are in flight.}
          \li{\code{ingestion_failure} (\em{str | None}) — Terminal deferred-flush error message if asynchronous storage failed, else \code{None}.}
        }
      }
      \<dt>{Methods}
      \<dd>{
        \ul{
          \li{\code{ask(num_arms: int) -> np.ndarray} — Propose \code{num_arms >= 1} candidate rows, returning a \code{(num_arms, D)} \code{float64} matrix inside \code{bounds}.}
          \li{\code{ask_batch(num_arms: int) -> AskBatch} — Multi-region proposal returning an [\code{AskBatch}](#baux.AskBatch) pairing typed [\code{AskId}](#baux.AskId) tokens with \code{(num_arms, D)} \code{points} (raises \code{RuntimeError} on single-region optimizers).}
          \li{\code{tell(x: np.ndarray, y: np.ndarray, y_var: np.ndarray | None = None) -> np.ndarray} — Validate and ingest \code{(N, D)} coordinates and finite \code{(N,)} or \code{(N, M)} maximization objectives, marking caller arrays read-only (\code{writeable=False}) and returning fitted posterior means at \code{x} (or \code{y} directly when surrogate-free).}
          \li{\code{import_observations(x: np.ndarray, y: np.ndarray, y_var: np.ndarray | None = None) -> np.ndarray} — Append external or historical observations to a multi-region optimizer without resolving pending \code{AskId} tokens or crediting regional controllers.}
          \li{\code{complete(ids: AskBatch | tuple[AskId, ...] | list[AskId], y: np.ndarray, y_var: np.ndarray | None = None) -> None} (alias \code{complete_ids}) — Resolve a non-empty subset of pending multi-region \code{AskId} tokens out of order with scalar rewards \code{y} of shape \code{(K,)} or \code{(K, 1)}.}
          \li{\code{cancel(ids: AskBatch | tuple[AskId, ...] | list[AskId]) -> None} (alias \code{cancel_ids}) — Retire unevaluated pending \code{AskId} tokens without recording observations or altering regional failure counters.}
          \li{\code{restart_region(slot: int, center: np.ndarray) -> tuple[AskId, ...]} — Restart multi-region slot \code{slot} at natural-coordinate \code{center} of shape \code{(D,)}, advancing its regional generation and returning invalidated \code{AskId} tokens.}
          \li{\code{posterior_mu(x: np.ndarray) -> np.ndarray} — Evaluate surrogate posterior means of shape \code{(Q, M)} (\code{float64}) at \code{x} without mutating observation history.}
          \li{\code{telemetry() -> Telemetry} — Return [\code{Telemetry}](#baux.Telemetry) timings and candidate count from the latest round.}
        }
      }
    }
  }

  \<div>[id]{baux.enn_optimizer}[class]{api-entry}[data-symbol]{baux.enn_optimizer}[data-kind]{function}[data-module]{baux.bo}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.enn_optimizer}](#baux.enn_optimizer)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.enn_optimizer(
    bounds: np.ndarray,
    k: int = 10,
    num_init: int = 10,
    seed: int | None = None,
    config: Any = None,
) -> BayesOptimizer
    }
    \p{Low-level PyO3 constructor returning a native Rust \code{BayesOptimizer} configured for single-region TuRBO-ENN.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{bounds} (\em{ndarray of shape (D, 2)}) — Continuous coordinate bounds (\code{float64}).}
          \li{\code{k} (\em{int}, default \code{10}) — Nearest-neighbor count \code{k > 0} when \code{config is None}.}
          \li{\code{num_init} (\em{int}, default \code{10}) — Initial Latin Hypercube warm-up budget.}
          \li{\code{seed} (\em{int | None}, default \code{None}) — Optional unsigned 64-bit integer seed.}
          \li{\code{config} (\em{Any}, default \code{None}) — Optional native Rust wire configuration dictionary overriding \code{k} and \code{num_init}.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{BayesOptimizer} — Native Rust single-region optimizer handle. Prefer [\code{baux.init}](#baux.init) (functional) or [\code{baux.create_optimizer}](#baux.create_optimizer) (stateful) for validated configurations, PyTree domains, and multi-region \code{AskId} workflows.}
    }
  }

  \<div>[id]{baux.create_zero}[class]{api-entry}[data-symbol]{baux.create_zero}[data-kind]{function}[data-module]{baux.bo}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.create_zero}](#baux.create_zero)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.create_zero(
    bounds: np.ndarray,
    num_init: int = 10,
    seed: int | None = None,
    config: Any = None,
) -> BayesOptimizer
    }
    \p{Low-level PyO3 constructor returning a native Rust \code{BayesOptimizer} configured for surrogate-free \code{TuRBO-0} trust-region search.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{bounds} (\em{ndarray of shape (D, 2)}) — Continuous coordinate bounds (\code{float64}).}
          \li{\code{num_init} (\em{int}, default \code{10}) — Warm-up evaluation count.}
          \li{\code{seed} (\em{int | None}, default \code{None}) — Optional unsigned 64-bit integer seed.}
          \li{\code{config} (\em{Any}, default \code{None}) — Optional native Rust wire configuration override.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{BayesOptimizer} — Native Rust surrogate-free TuRBO handle.}
    }
  }

  \<div>[id]{baux.create_lhd}[class]{api-entry}[data-symbol]{baux.create_lhd}[data-kind]{function}[data-module]{baux.bo}{
    \<div>[class]{api-entry-header}{
      \<span>[class]{api-entry-title}{[\code{baux.create_lhd}](#baux.create_lhd)}
      \<span>[class]{api-kind-badge}{function}
    }
    \pre{
baux.create_lhd(
    bounds: np.ndarray,
    num_init: int = 10,
    seed: int | None = None,
    config: Any = None,
) -> BayesOptimizer
    }
    \p{Low-level PyO3 constructor returning a native Rust \code{BayesOptimizer} configured for pure Latin Hypercube Design sampling.}
    \<dl>[class]{api-spec-list}{
      \<dt>{Parameters}
      \<dd>{
        \ul{
          \li{\code{bounds} (\em{ndarray of shape (D, 2)}) — Continuous coordinate bounds (\code{float64}).}
          \li{\code{num_init} (\em{int}, default \code{10}) — Initial LHD block size.}
          \li{\code{seed} (\em{int | None}, default \code{None}) — Optional unsigned 64-bit integer seed.}
          \li{\code{config} (\em{Any}, default \code{None}) — Optional native Rust wire configuration override.}
        }
      }
      \<dt>{Returns}
      \<dd>{\code{BayesOptimizer} — Native Rust LHD baseline handle.}
    }
