\title{Structured Parameters}

\p{
  Pass a nested dictionary, tuple, or dataclass template to [baux.init](docs.html#baux.init). \code{batch.points} holds solver coordinates; \code{batch.params} holds decoded objects.
}

\subtree{
  \title{Parameter Coordinate Maps}

  \ul{
    \li{
      \strong{Log-scale} ([baux.Log](api-domains.html#baux.Log)): On #{[a, b] \subset \mathbb{R}_+},
      ##{
        \psi(x) = \frac{\log x - \log a}{\log b - \log a} \in [0, 1], \qquad \rho(u) = a\left(\frac{b}{a}\right)^{\Pi_{[0,1]}(u)}.
      }
    }
    \li{
      \strong{Periodic} ([baux.Periodic](api-domains.html#baux.Periodic)): On #{\lbrack a, b\rparen} with period #{P = b - a} and phase #{\phi(x) = \tfrac{2\pi(x - a)}{P}},
      ##{
        \psi(x) = \left(\frac{1}{2} + \frac{\cos\phi(x)}{2\pi},\; \frac{1}{2} + \frac{\sin\phi(x)}{2\pi}\right), \qquad d_{\mathcal{U}}\bigl(\psi(x), \psi(x')\bigr) = \frac{1}{\pi}\left|\sin\left(\frac{\phi(x) - \phi(x')}{2}\right)\right|.
      }
    }
    \li{
      \strong{Simplex} ([baux.Simplex](api-domains.html#baux.Simplex)): On #{\Delta^{d-1}} (twice squared Hellinger distance; returns uniform if all clipped entries vanish),
      ##{
        \psi(p) = \bigl(\sqrt{p_1}, \dots, \sqrt{p_d}\bigr) \in S_+^{d-1}, \qquad \rho(u) = \frac{\max(u, 0)^{\odot 2}}{\Vert\max(u, 0)\Vert_2^2}.
      }
    }
    \li{
      \strong{Categorical} ([baux.Categorical](api-domains.html#baux.Categorical)): Orthogonal/Rademacher codewords #{\psi(c) \in \mathbb{R}^{d_c}} (Achlioptas [[Ach03]](https://doi.org/10.1016/S0022-0000(03)00025-4)), decoded via #{\rho(u) = \arg\max_c \langle u, \psi(c)\rangle}.
    }
  }
}

\subtree{
  \title{Linear Subspace Shrinkage}

  \p{
    [baux.Stiefel.from_factors](api-domains.html#baux.Stiefel) orthonormalizes a full-rank basis #{L} into #{V} with projector #{P=VV^\top} and residual contraction #{\alpha \in [0,1]}:
  }

  ##{
    \hat{\theta}_\alpha = P y + \alpha (I_M - P)y.
  }

  \p{
    For #{y=\theta+\eta \in \mathbb{R}^M} with #{v_\parallel=\mathbb{E}\Vert P\eta\Vert^2}, #{v_\perp=\mathbb{E}\Vert(I-P)\eta\Vert^2>0}, and #{b_\perp^2=\Vert(I-P)\theta\Vert^2}, MSE #{\mathcal{R}(\alpha)=v_\parallel+(1-\alpha)^2 b_\perp^2+\alpha^2 v_\perp} is minimized at:
  }

  ##{
    \alpha^* = \frac{b_\perp^2}{b_\perp^2 + v_\perp}, \qquad \mathcal{R}(\alpha^*) = v_\parallel + \frac{v_\perp b_\perp^2}{b_\perp^2 + v_\perp} < v_\parallel + v_\perp = \mathcal{R}(1).
  }

  \p{
    [baux.stein](api-pipelines.html#baux.stein) estimates #{\alpha} from ENN residuals and variances (James–Stein [[JS61]](https://projecteuclid.org/ebooks/berkeley-symposium-on-mathematical-statistics-and-probability/Proceedings-of-the-Fourth-Berkeley-Symposium-on-Mathematical-Statistics-and/chapter/Estimation-with-Quadratic-Loss/bsmsp/1200512173)); [baux.calibrate](api-pipelines.html#baux.calibrate) fits affine quantile scaling.
  }

  \pre{
import math
import numpy as np
import baux

rng = np.random.default_rng(3)
space = {
    "gain": baux.Log(1e-3, 1.0),
    "phase": baux.Periodic(0.0, 2.0 * math.pi),
    "weights": baux.Simplex(4),
    "window": baux.Categorical(["hann", "hamming", "blackman", "kaiser"]),
}
loadings = np.array([
    [1.0, 0.0],
    [0.8, 0.2],
    [0.2, 0.9],
    [-0.4, 0.7],
    [0.5, -0.5],
    [-0.3, -0.6],
])
frame = baux.Stiefel.from_factors(loadings)
target_w = np.array([0.45, 0.30, 0.15, 0.10])
win_loss = {"hann": 0.0, "hamming": 0.04, "blackman": 0.08, "kaiser": 0.01}


def spectral_channels(p):
    g_err = math.log10(p["gain"] / 0.05)
    ph_err = math.sin(0.5 * (p["phase"] - 1.2))
    w_err = float(np.sum((np.sqrt(p["weights"]) - np.sqrt(target_w)) ** 2))
    latent = np.array([-(g_err**2 + w_err + win_loss[p["window"]]), -(ph_err**2)])
    return loadings @ latent + 0.15 * rng.normal(size=6)


pipe = (
    baux.enn(k=8, geometry="conformal")
    | baux.stein(frame)
    | baux.ucb(beta=1.5)
    | baux.regions(count=3)
)
state = baux.init(space, pipe, key=baux.key(19))
for _ in range(10):
    state, batch = baux.ask(state, num_arms=3)
    y = np.vstack([spectral_channels(p) for p in batch.params])
    state, mu_shrunk = baux.tell(state, batch, y)

assert mu_shrunk.shape == (3, 6) and state.y_obs.shape == (30, 6)
print(f"Structured Stein: best_y={state.best_y:.4f} best_params={state.best_params}")
  }
}
