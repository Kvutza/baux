\title{Regions and Workers}

\p{
  Maintain local trust regions with \code{baux.regions(count=4)} (TuRBO [[EPG+19]](https://arxiv.org/abs/1910.01739)); submit out-of-order results via \code{baux.complete(state, ids, y)} and retire stale work via \code{baux.cancel(state, ids)}.
}

\subtree{
  \title{Multi-Region & Async Search}

  \p{
    [baux.regions](api-pipelines.html#baux.regions) sets \code{origin_only} or \code{ellipsoid_ball} incumbent sharing across centers. [baux.complete](docs.html#baux.complete), [baux.cancel](docs.html#baux.cancel), and [baux.import_observations](docs.html#baux.import_observations) reconcile worker \code{AskId} tickets cleanly across restarts.
  }
}

\subtree{
  \title{Deterministic Rollouts & Checkpoints}

  \p{
    Each transition returns a fresh [\code{OptimizerState}](docs.html#baux.OptimizerState). Splittable PRNG keys ([[CP13]](https://doi.org/10.1145/2503778.2503784), [[SLF14]](https://doi.org/10.1145/2660193.2660195)) drive deterministic [baux.scan](api-state.html#baux.scan) and [baux.pmap](api-state.html#baux.pmap) traces, while [baux.freeze](api-state.html#baux.freeze) / [baux.thaw](api-state.html#baux.thaw) checkpoint state with BLAKE3 integrity tags.
  }

  \pre{
import numpy as np
import baux

bounds = np.tile([-3.0, 3.0], (8, 1))
weights = np.geomspace(1.0, 16.0, 8)


def anisotropic_loss(x):
    return -np.sum(weights * (x - 0.35) ** 2 + 0.1 * np.cos(3.0 * x), axis=1)


pipe = (
    baux.lhd(8)
    | baux.enn(k=6)
    | baux.thompson()
    | baux.regions(count=4, sharing="ellipsoid_ball")
)
s0 = baux.init(bounds, pipe, key=baux.key(101))
s_warm, b_init = baux.ask(s0, num_arms=8)
s_warm = baux.complete(s_warm, b_init.ids, anisotropic_loss(b_init.points))

s_live, b1 = baux.ask(s_warm, num_arms=2)
s_live, b2 = baux.ask(s_live, num_arms=2)
s_live = baux.complete(s_live, [b2.ids[0]], anisotropic_loss(b2.points[:1]))
s_live = baux.cancel(s_live, [b2.ids[1]])
s_live = baux.complete(s_live, b1.ids, anisotropic_loss(b1.points))

blob = baux.freeze(s_live)
restored_a = baux.thaw(s0, blob)
restored_b = baux.thaw(s0, baux.freeze(restored_a))
assert baux.freeze(restored_a) == blob
assert baux.digest(s_live) == baux.digest(restored_a) == baux.digest(restored_b)

rollouts_live = baux.pmap(
    s_live,
    baux.key(77),
    branches=4,
    branch_fn=lambda i, st, k: baux.digest(
        baux.scan(st, k, steps=4, eval_fn=anisotropic_loss, num_arms=2)[0]
    ),
)
rollouts_a = baux.pmap(
    restored_a,
    baux.key(77),
    branches=4,
    branch_fn=lambda i, st, k: baux.digest(
        baux.scan(st, k, steps=4, eval_fn=anisotropic_loss, num_arms=2)[0]
    ),
)
rollouts_b = baux.pmap(
    restored_b,
    baux.key(77),
    branches=4,
    branch_fn=lambda i, st, k: baux.digest(
        baux.scan(st, k, steps=4, eval_fn=anisotropic_loss, num_arms=2)[0]
    ),
)
assert rollouts_live == rollouts_a == rollouts_b and len(set(rollouts_live)) == 4
print(f"Verified BLAKE3 digest={baux.digest(s_live)[:16]}... parity across 4 forked rollouts")
  }
}
