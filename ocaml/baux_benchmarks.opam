opam-version: "2.0"
synopsis: "SFU numerical optimization benchmarks for BAUX on OxCaml"
maintainer: "Kvutza"
authors: "Kvutza"
license: "MIT"
homepage: "https://github.com/Kvutza/baux"
bug-reports: "https://github.com/Kvutza/baux/issues"
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
depends: [
  "oxcaml-compiler" {= "5.2.0minus39"}
  "dune" {= "3.22.2+ox"}
  "ocamlformat" {= "0.26.2+ox2" & with-dev-setup}
  "otoml" {= "1.0.5+ox"}
  "jane_rope" {= "v0.18~preview.130.106+341"}
  "hardcaml" {= "v0.18~preview.130.106+341"}
  "yojson" {= "2.2.2+ox"}
  "core_bench" {= "v0.18~preview.130.106+341"}
  "core" {= "v0.18~preview.130.106+341"}
  "core_unix" {= "v0.18~preview.130.106+341"}
  "base_quickcheck" {= "v0.18~preview.130.106+341" & with-test}
  "base" {= "v0.18~preview.130.106+341"}
  "parallel" {= "v0.18~preview.130.106+341"}
  "ppx_template" {= "v0.18~preview.130.106+341"}
]
