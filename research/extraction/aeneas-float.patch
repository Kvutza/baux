+(** Parse Charon's decimal representation exactly. Never route a literal through
+    the host's floating-point arithmetic: the Lean runtime performs rounding. *)
+let float_ratio (span : Meta.span) (value : string) : bool * Z.t * Z.t =
+  let value = String.lowercase_ascii value in
+  let negative = String.length value > 0 && value.[0] = '-' in
+  let value = if negative then String.sub value 1 (String.length value - 1) else value in
+  let significand, exponent = match String.split_on_char 'e' value with
+    | [ mantissa ] -> (mantissa, 0)
+    | [ mantissa; exponent ] -> (mantissa, int_of_string exponent)
+    | _ -> [%craise] span "Invalid decimal float literal"
+  in
+  let digits, places = match String.split_on_char '.' significand with
+    | [ whole ] -> (whole, 0)
+    | [ whole; fraction ] -> (whole ^ fraction, String.length fraction)
+    | _ -> [%craise] span "Invalid decimal float significand"
+  in
+  if digits = "" || not (String.for_all (fun c -> c >= '0' && c <= '9') digits)
+  then [%craise] span "Non-finite float literals require explicit bit semantics";
+  let shift = exponent - places in
+  if abs shift > 5000 then [%craise] span "Float literal exponent is out of range";
+  let numerator = Z.of_string digits in
+  if shift >= 0 then (negative, Z.mul numerator (Z.pow (Z.of_int 10) shift), Z.one)
+  else (negative, numerator, Z.pow (Z.of_int 10) (-shift))
 
