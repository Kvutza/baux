+fn ty_projection_depth<'tcx>(ty: Ty<'tcx>) -> usize {
+    match ty.kind() {
+        TyKind::Alias(
+            _is_rigid,
+            ty::AliasTy {
+                kind: AliasTyKind::Projection { .. },
+                args,
+                ..
+            },
+        ) => {
+            1 + args
+                .iter()
+                .filter_map(|arg| arg.as_type())
+                .map(ty_projection_depth)
+                .max()
+                .unwrap_or(0)
+        }
+        TyKind::Ref(_, inner, _)
+        | TyKind::RawPtr(inner, _)
+        | TyKind::Slice(inner)
+        | TyKind::Array(inner, _) => ty_projection_depth(*inner),
+        TyKind::Adt(_, args) => args
+            .iter()
+            .filter_map(|arg| arg.as_type())
+            .map(ty_projection_depth)
+            .max()
+            .unwrap_or(0),
+        TyKind::Tuple(tys) => tys.iter().map(ty_projection_depth).max().unwrap_or(0),
+        _ => 0,
+    }
+}
