+/// Preserve the exact late-bound variable kinds and region variances of a
+/// function signature without translating its value. This matters for opaque
+/// external calls whose signature contains unconstrained generic consts.
+pub fn fn_sig_binder_shape<'tcx, S: UnderOwnerState<'tcx>>(
+    sig: ty::PolyFnSig<'tcx>,
+    s: &S,
+) -> Binder<()> {
+    let variances = fn_sig_bound_region_variances(s.base().tcx, sig);
+    let mut bound_vars: Vec<BoundVariableKind> = sig.bound_vars().sinto(s);
+    for (index, var) in bound_vars.iter_mut().enumerate() {
+        if let BoundVariableKind::Region(_, variance) = var {
+            *variance = variances
+                .get(&ty::BoundVar::from_usize(index))
+                .copied()
+                .sinto(s);
+        }
+    }
+    Binder { value: (), bound_vars }
+}
