/-- Convert one unit-cube scalar word `x` to natural coordinates given `[low, high]`. -/
def fromUnitWord (x low high : BitVec 64) : BitVec 64 :=
  let lowF : BauxResearch.Extraction.Native.F64 := FloatLib.Floats.Formats.BinaryInterchange.Model.ofBits low
  let highF : BauxResearch.Extraction.Native.F64 := FloatLib.Floats.Formats.BinaryInterchange.Model.ofBits high
  let xF : BauxResearch.Extraction.Native.F64 := FloatLib.Floats.Formats.BinaryInterchange.Model.ofBits x
  let range := BauxResearch.Extraction.Native.F64.sub highF lowF
  (BauxResearch.Extraction.Native.F64.add lowF
    (BauxResearch.Extraction.Native.F64.mul xF range)).bits

/-- Convert one natural-coordinate scalar word `v` to unit-cube coordinates given `[low, high]`. -/
def toUnitWord (v low high : BitVec 64) : BitVec 64 :=
  let lowF : BauxResearch.Extraction.Native.F64 := FloatLib.Floats.Formats.BinaryInterchange.Model.ofBits low
  let highF : BauxResearch.Extraction.Native.F64 := FloatLib.Floats.Formats.BinaryInterchange.Model.ofBits high
  let valF : BauxResearch.Extraction.Native.F64 := FloatLib.Floats.Formats.BinaryInterchange.Model.ofBits v
  let range := BauxResearch.Extraction.Native.F64.sub highF lowF
  let zero : BauxResearch.Extraction.Native.F64 := FloatLib.Floats.Formats.BinaryInterchange.Model.ofBits 0#64
  if BauxResearch.Extraction.Native.F64.gt range zero then
    (BauxResearch.Extraction.Native.F64.div
      (BauxResearch.Extraction.Native.F64.sub valF lowF) range).bits
  else
    0x3fe0000000000000#64

