      lift (BauxResearch.Extraction.Native.F64.mul fl1 y_scale)
    let fl2 ← BauxResearch.Extraction.Native.F64.sqrt aleatoric_var
    let se_ale ←
      lift (BauxResearch.Extraction.Native.F64.mul fl2 y_scale)
