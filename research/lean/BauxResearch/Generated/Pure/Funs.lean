def surrogate_state.AppendPlan.new
  (input : surrogate_state.AppendInput) :
  Result surrogate_state.AppendPlan
  := do
  let bulk ←
    if input.on_disk
    then ok (input.rows >= surrogate_state.BULK_DISK_TELL_SKIP_FIT_ROWS)
    else ok false
  if input.initial
  then
    let act ← if input.frozen
                then ok true
                else ok (! bulk)
    let b ← if act
              then ok input.on_disk
              else ok false
    let b1 ← if act
               then ok (! input.frozen)
               else ok false
    if act
    then ok { sync := b, search := b1, release := input.on_disk }
    else ok { sync := b, search := b1, release := false }
  else
    let skip_fit ←
      if bulk
      then ok true
      else if input.on_disk
           then ok input.has_params
           else ok false
    let b ← if skip_fit
              then ok bulk
              else ok true
    let b1 ← if input.frozen
               then ok false
               else ok (! skip_fit)
    if skip_fit
    then ok { sync := b, search := b1, release := bulk }
    else ok { sync := b, search := b1, release := true }

