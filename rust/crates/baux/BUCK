load("//build/buck2:reindeer_rules.bzl", "app_rust_binary", "app_rust_library")
load("//build/buck2:baux_targets.bzl", "baux_program_targets")
load("//build/buck2/tests:suite.bzl", "test_suite")
load("//build:targets.bzl", "BAUX_CRATES", "BAUX_PROGRAMS", "BAUX_TEST_CRATES", "RUST_EDITION")

BAUX_BUCK_DEPS = ["//rust:" + crate for crate in BAUX_CRATES]

BAUX_BUCK_TEST_DEPS = ["//rust:" + crate for crate in BAUX_TEST_CRATES]

_BAUX_RUST_SRCS = glob(
    [
        "src/hnet/*.json",
        "src/**/*.metal",
        "src/**/*.rs",
        "semantics/src/**/*.rs",
        "neighbor-index/src/**/*.rs",
        "artifact/src/**/*.rs",
    ],
    exclude = ["src/bin/**/*.rs"],
)


filegroup(
    name = "baux-source",
    srcs = glob([
        "examples/**/*.rs",
        "src/**/*.h",
        "src/**/*.metal",
        "src/**/*.rs",
        "semantics/src/**/*.rs",
        "neighbor-index/src/**/*.rs",
        "artifact/src/**/*.rs",
        "tests/**/*.cpp",
        "tests/**/*.rs",
    ]) + [
        "Cargo.toml",
        "LICENSE",
        "NOTICE",
    ],
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "usearch-bridge",
    srcs = ["src/usearch_bridge.cpp"],
    compiler_flags = [
        "-std=c++17",
        "-Wno-unknown-pragmas",
    ],
    deps = ["//build/buck2/native:usearch"],
    exported_linker_flags = select({
        "//:linux-arm64": ["-lstdc++"],
        "//:linux-x86_64": ["-lstdc++"],
        "//:macos-arm64": ["-lc++"],
    }),
    visibility = ["PUBLIC"],
)

write_file(
    name = "baux-cli-root",
    out = "cli_lib.rs",
    content = [
        "#![allow(clippy::pedantic, clippy::nursery, clippy::cargo)]",
        "extern crate self as baux;",
        "#[path = \"artifact/src/lib.rs\"]",
        "pub mod artifact;",
        "pub use artifact as baux_artifact;",
        "#[path = \"semantics/src/lib.rs\"]",
        "pub mod semantics;",
        "pub use semantics as baux_semantics;",
    ],
)

app_rust_library(
    name = "baux-cli",
    srcs = [":baux-cli-root"] + glob([
        "artifact/src/**/*.rs",
        "semantics/src/**/*.rs",
    ]),
    crate = "baux",
    crate_root = "cli_lib.rs",
    edition = RUST_EDITION,
    visibility = ["PUBLIC"],
    deps = [
        "//rust:anstream",
        "//rust:charming",
        "//rust:deser",
        "//rust:deser-cbor",
        "//rust:deser-json",
        "//rust:deser-toml",
        "//rust:deser-value",
        "//rust:jiff",
        "//rust:kuva",
        "//rust:rand",
        "//rust:redb",
        "//rust:sha2",
    ],
)

app_rust_library(
    name = "baux",
    srcs = _BAUX_RUST_SRCS,
    crate = "baux",
    crate_root = "src/lib.rs",
    edition = RUST_EDITION,
    features = select({
        "//:linux-arm64": ["usearch-native"],
        "//:linux-x86_64": ["usearch-native"],
        "//:macos-arm64": ["metal", "usearch-native"],
    }),
    visibility = ["PUBLIC"],
    deps = BAUX_BUCK_DEPS + [
        ":usearch-bridge",
    ] + select({
        "//:linux-arm64": [],
        "//:linux-x86_64": [],
        "//:macos-arm64": ["//rust:metal"],
    }),
)

rust_test(
    name = "region-metal",
    srcs = _BAUX_RUST_SRCS + ["//experiments:specs"],
    crate = "baux",
    crate_root = "src/lib.rs",
    edition = RUST_EDITION,
    rustc_flags = select({
        "root//:release-mode": [],
        "DEFAULT": ["-Zthreads=8", "-Ccodegen-units=16"],
    }),
    features = ["buck2-test-data", "metal", "usearch-native"],
    visibility = ["PUBLIC"],
    deps = BAUX_BUCK_TEST_DEPS + [
        ":usearch-bridge",
        "//build/buck2/native:openmp-macos",
        "//rust:metal",
    ],
    rpath = True,
    runtime_dependency_handling = "symlink",
    target_compatible_with = ["prelude//os/constraints:macos"],
)

rust_test(
    name = "baux-unit",
    srcs = _BAUX_RUST_SRCS + ["//experiments:specs"],
    crate = "baux",
    crate_root = "src/lib.rs",
    edition = RUST_EDITION,
    rustc_flags = select({
        "root//:release-mode": [],
        "DEFAULT": ["-Zthreads=8", "-Ccodegen-units=16"],
    }),
    features = ["buck2-test-data", "usearch-native"],
    visibility = ["//build/buck2/tests:all"],
    deps = BAUX_BUCK_TEST_DEPS + [
        ":usearch-bridge",
    ] + select({
        "//:linux-arm64": [],
        "//:linux-x86_64": [],
        "//:macos-arm64": [
            "//build/buck2/native:openmp-macos",
        ],
    }),
    rpath = True,
    runtime_dependency_handling = "symlink",
)

app_rust_library(
    name = "baux_bench",
    srcs = _BAUX_RUST_SRCS,
    crate = "baux",
    crate_root = "src/lib.rs",
    edition = RUST_EDITION,
    features = [
        "metal",
        "usearch-native",
    ],
    deps = BAUX_BUCK_DEPS + [
        ":usearch-bridge",
        "//rust:metal",
    ],
    target_compatible_with = ["prelude//os/constraints:macos"],
)

[
    baux_program_targets(
        [program],
        RUST_EDITION,
        glob(["src/bin/" + program["name"] + "/**/*.rs"]) if program["root"].startswith("src/bin/") else [program["root"]],
    )
    for program in BAUX_PROGRAMS
]

# Each integration crate receives the same platform features as the library.
[
    rust_test(
        name = source.removeprefix("tests/").removesuffix(".rs") + "_test",
        srcs = [source],
        crate_root = source,
        edition = RUST_EDITION,
        features = select({
            "//:macos-arm64": ["metal", "usearch-native"],
            "DEFAULT": ["usearch-native"],
        }),
        deps = [
            ":baux",
            "//rust:ndarray",
            "//rust:rand",
            "//rust:rand_chacha",
            "//rust:rayon",
            "//rust:tempfile",
        ] + select({
            "//:macos-arm64": [
                "//build/buck2/native:openmp-macos",
                "//rust:metal",
            ],
            "DEFAULT": [],
        }),
        visibility = ["PUBLIC"],
        rpath = True,
        runtime_dependency_handling = "symlink",
        run_env = {"RUST_TEST_THREADS": "1"},
        target_compatible_with = ["prelude//os/constraints:macos"] if source == "tests/knn_metal.rs" else [],
    )
    for source in glob(["tests/*.rs"], exclude = ["tests/resident_metal.rs"])
]

_TESTS = [
    ":" + source.removeprefix("tests/").removesuffix(".rs") + "_test"
    for source in glob(["tests/*.rs"], exclude = ["tests/knn_metal.rs", "tests/resident_metal.rs"])
] + select({
    "//:macos-arm64": [":knn_metal_test"],
    "DEFAULT": [],
})

test_suite(
    name = "integration",
    tests = _TESTS,
    visibility = ["//build/buck2/tests:all"],
)

rust_test(
    name = "baux-tune-test",
    srcs = glob(["src/bin/baux-tune/**/*.rs"]),
    crate = "baux_tune_test",
    crate_root = [program["root"] for program in BAUX_PROGRAMS if program["name"] == "baux-tune"][0],
    edition = RUST_EDITION,
    deps = [":baux", "//rust:anstream", "//rust:tempfile"] + select({
        "//:macos-arm64": ["//build/buck2/native:openmp-macos"],
        "DEFAULT": [],
    }),
    rpath = True,
    runtime_dependency_handling = "symlink",
    visibility = ["//build/buck2/tests:all"],
)
