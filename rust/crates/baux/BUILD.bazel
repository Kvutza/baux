load("@crates//:defs.bzl", "aliases", "crate_edition")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//build:targets.bzl", "BAUX_CRATES", "BAUX_PROGRAMS", "BAUX_TEST_CRATES")
load("//rust/crates/baux:defs.bzl", "baux_crate_deps", "baux_program_targets")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

BAUX_SRCS = glob(
    [
        "src/**/*.rs",
        "semantics/src/**/*.rs",
        "neighbor-index/src/**/*.rs",
        "artifact/src/**/*.rs",
    ],
    exclude = ["src/baux_build.rs"],
)

BAUX_SHADER_SRCS = glob([
    "src/**/*.cl",
    "src/**/*.metal",
])

BAUX_DEPS = baux_crate_deps(BAUX_CRATES)

BAUX_TEST_DEPS = baux_crate_deps(BAUX_TEST_CRATES)

cc_library(
    name = "usearch_bridge",
    srcs = ["src/usearch_bridge.cpp"],
    hdrs = ["src/usearch_bridge.h"],
    copts = [
        "-std=c++17",
        "-Wno-unknown-pragmas",
    ],
    includes = ["src"],
    deps = ["@usearch_src//:usearch"],
)

rust_library(
    name = "baux_cpu",
    srcs = BAUX_SRCS,
    aliases = aliases(),
    compile_data = BAUX_SHADER_SRCS,
    crate_features = ["usearch-native"],
    crate_name = "baux",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    link_deps = [
        ":usearch_bridge",
    ],
    deps = BAUX_DEPS,
)

rust_library(
    name = "baux_metal",
    srcs = BAUX_SRCS,
    aliases = aliases(),
    compile_data = BAUX_SHADER_SRCS,
    crate_features = [
        "metal",
        "usearch-native",
    ],
    crate_name = "baux",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    link_deps = [
        ":usearch_bridge",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    deps = BAUX_DEPS + [
        "@crates//:metal",
    ],
)

rust_library(
    name = "baux_opencl",
    srcs = BAUX_SRCS,
    aliases = aliases(),
    compile_data = BAUX_SHADER_SRCS,
    crate_features = [
        "opencl",
        "usearch-native",
    ],
    crate_name = "baux",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    link_deps = [
        ":usearch_bridge",
    ],
    deps = BAUX_DEPS + [
        "@crates//:opencl3",
    ],
)

alias(
    name = "baux",
    actual = ":baux_cpu",
)

alias(
    name = "baux_accelerators",
    actual = select({
        "@platforms//os:linux": ":baux_opencl",
        "@platforms//os:macos": ":baux_metal",
        "//conditions:default": ":baux_cpu",
    }),
)

baux_program_targets(BAUX_PROGRAMS, glob(["src/**/*.rs", "semantics/src/**/*.rs", "neighbor-index/src/**/*.rs", "artifact/src/**/*.rs", "examples/**/*.rs"]))

rust_test(
    name = "baux_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":baux_cpu",
    compile_data = ["//experiments:specs"],
    deps = BAUX_TEST_DEPS,
)

# Metal unit tests are separate from baux_test because the CPU crate compiles
# accelerator modules out. Keep this target narrow and filter it in local/CI
# invocations when validating Qwen context compilation.
rust_test(
    name = "qwen_metal_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    compile_data = ["//experiments:specs"],
    crate = ":baux_metal",
    crate_features = [
        "metal",
        "usearch-native",
    ],
    deps = BAUX_TEST_DEPS,
    target_compatible_with = ["@platforms//os:macos"],
)

rust_binary(
    name = "trial_bench_metal",
    srcs = ["examples/trial_bench.rs"],
    aliases = aliases(normal_dev = True),
    crate_name = "trial_bench_metal",
    crate_root = "examples/trial_bench.rs",
    edition = crate_edition(),
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":baux_metal",
    ],
)

rust_binary(
    name = "trial_bench_opencl",
    srcs = ["examples/trial_bench.rs"],
    aliases = aliases(normal_dev = True),
    crate_name = "trial_bench_opencl",
    crate_root = "examples/trial_bench.rs",
    edition = crate_edition(),
    deps = [
        ":baux_opencl",
    ],
)

rust_binary(
    name = "knn_bench_metal",
    srcs = ["examples/knn_bench.rs"],
    aliases = aliases(normal_dev = True),
    crate_name = "knn_bench_metal",
    crate_root = "examples/knn_bench.rs",
    edition = crate_edition(),
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":baux_metal",
    ] + baux_crate_deps(["ndarray"]),
)

rust_test(
    name = "knn_metal_test",
    srcs = ["tests/knn_metal.rs"],
    aliases = aliases(normal_dev = True),
    crate_name = "knn_metal_test",
    crate_root = "tests/knn_metal.rs",
    edition = crate_edition(),
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":baux_metal",
    ] + baux_crate_deps(["ndarray"]),
)

rust_test(
    name = "trial_search_metal_test",
    srcs = ["tests/trial_search.rs"],
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate_features = ["metal"],
    crate_name = "trial_search_metal_test",
    crate_root = "tests/trial_search.rs",
    edition = crate_edition(),
    target_compatible_with = ["@platforms//os:macos"],
    deps = BAUX_TEST_DEPS + [
        ":baux_metal",
    ],
)

rust_test(
    name = "trial_search_opencl_test",
    srcs = ["tests/trial_search.rs"],
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate_features = ["opencl"],
    crate_name = "trial_search_opencl_test",
    crate_root = "tests/trial_search.rs",
    edition = crate_edition(),
    deps = BAUX_TEST_DEPS + [
        ":baux_opencl",
    ],
)
