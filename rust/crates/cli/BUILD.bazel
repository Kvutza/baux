load("@crates//:defs.bzl", "aliases", "crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//build:targets.bzl", "CLI_CRATES", "CLI_PROGRAMS")
load("//rust/crates/baux:defs.bzl", "baux_program_targets")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

CLI_DEPS = crate_deps(CLI_CRATES) + [
    "//rust/crates/tooling:tooling",
    "//rust/crates/baux:baux_accelerators",
]

baux_program_targets(CLI_PROGRAMS, glob(["src/**/*.rs"]))

rust_test(
    name = "baux_test",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    crate_name = "baux_cli_test",
    crate_root = [program["root"] for program in CLI_PROGRAMS if program["name"] == "baux"][0],
    rustc_env = {"CARGO_PKG_VERSION": [program["version"] for program in CLI_PROGRAMS if program["name"] == "baux"][0]},
    edition = crate_edition(),
    deps = CLI_DEPS,
)
