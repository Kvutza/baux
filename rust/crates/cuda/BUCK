load("//admin:targets.bzl", "RUST_EDITION")
load("//admin/buck2:reindeer_rules.bzl", "app_rust_binary", "app_rust_library")

codegen_backend = read_config("baux", "cuda_codegen_backend", "")
ptx_dir = read_config("baux", "cuda_ptx_dir", "")

filegroup(
    name = "source",
    srcs = glob(["**/*.rs", "native/*"]) + [
        "Cargo.toml",
        "device/Cargo.toml",
        "rust-toolchain.toml",
    ],
    visibility = ["PUBLIC"],
)

device_env = {k: v for k, v in ([("CARGO_CRATE_NAME", "baux_cuda_device"), ("CARGO_PKG_NAME", "baux-cuda-device"), ("CARGO_PKG_VERSION", "0.0.6"), ("CUDA_OXIDE_DEVICE_CODEGEN_CRATE", "baux_cuda_device"), ("CUDA_OXIDE_LLC", select({"prelude//os:macos": "/opt/homebrew/opt/llvm/bin/llc", "DEFAULT": "/usr/bin/llc-21"})), ("CUDA_OXIDE_TARGET", "sm_80")] + ([("CUDA_OXIDE_PTX_DIR", ptx_dir)] if ptx_dir != "" else []))}

device_rustc_flags = [
    "--cfg=buck_build",
    "-Zmir-enable-passes=-JumpThreading",
    "-Zalways-encode-mir",
    "-Csymbol-mangling-version=v0",
    "-Copt-level=3",
    "-Cdebug-assertions=off",
    "-Ccodegen-units=1",
] + (["-Zcodegen-backend=" + codegen_backend] if codegen_backend != "" else [])

rust_library(
    name = "baux-cuda-device",
    srcs = glob(["device/src/**/*.rs"]) + ["//rust/crates/baux:baux-source"],
    crate = "baux_cuda_device",
    crate_root = "device/src/lib.rs",
    edition = RUST_EDITION,
    features = ["cuda", "cuda-device", "default"],
    env = device_env,
    rustc_flags = device_rustc_flags,
    target_compatible_with = ["prelude//os/constraints:linux"],
    visibility = ["PUBLIC"],
    deps = [
        "//rust:cuda-core",
        "//rust:cuda-device",
        "//rust:cuda-host",
        "//rust:deser",
        "//rust:rand",
    ],
)

app_rust_library(
    name = "baux-cuda",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/main.rs",
            "src/main_bench.rs",
            "src/main_parity.rs",
        ],
    ) + ["//rust/crates/baux:baux-source"],
    crate = "baux_cuda",
    crate_root = "src/lib.rs",
    edition = RUST_EDITION,
    features = ["cuda-host", "default"],
    env = {
        "CARGO_CRATE_NAME": "baux_cuda",
        "CARGO_PKG_NAME": "baux-cuda",
        "CARGO_PKG_VERSION": "0.0.6",
    },
    rustc_flags = ["--cfg=buck_build"],
    target_compatible_with = ["prelude//os/constraints:linux"],
    visibility = ["PUBLIC"],
    deps = [
        ":baux-cuda-device",
        "//rust:anstream",
        "//rust:anstyle",
        "//rust:charming",
        "//rust:cuda-core",
        "//rust:cuda-host",
        "//rust:deser",
        "//rust:deser-cbor",
        "//rust:deser-json",
        "//rust:deser-toml",
        "//rust:deser-value",
        "//rust:half",
        "//rust:jiff",
        "//rust:kuva",
        "//rust:memmap2",
        "//rust:rand",
        "//rust:rand_distr",
        "//rust:redb",
        "//rust:sha2",
    ],
)

app_rust_binary(
    name = "baux-cuda-bin",
    srcs = [
        "src/main.rs",
        "src/main_bench.rs",
        "src/main_parity.rs",
    ],
    crate = "baux_cuda",
    crate_root = "src/main.rs",
    edition = RUST_EDITION,
    env = {
        "CARGO_BIN_NAME": "baux-cuda",
        "CARGO_CRATE_NAME": "baux_cuda",
        "CARGO_PKG_NAME": "baux-cuda",
        "CARGO_PKG_VERSION": "0.0.6",
    },
    rustc_flags = [],
    target_compatible_with = ["prelude//os/constraints:linux"],
    visibility = ["PUBLIC"],
    deps = [
        ":baux-cuda",
        ":baux-cuda-device",
        "//rust:cuda-core",
        "//rust:cuda-host",
        "//rust:half",
        "//rust:rand",
    ],
)
