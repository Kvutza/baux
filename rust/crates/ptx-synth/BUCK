load("//build/buck2:reindeer_rules.bzl", "app_rust_library")

app_rust_library(
    name = "ptx-synth",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate = "ptx_synth",
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["PUBLIC"],
    deps = [],
)

rust_test(
    name = "ptx-synth-unit",
    srcs = glob(["src/**/*.rs"]),
    crate = "ptx_synth",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [],
    visibility = ["//build/buck2/tests:all"],
)

filegroup(
    name = "ptx-source",
    srcs = glob(["src/**/*.rs"]) + ["Cargo.toml"],
    visibility = ["PUBLIC"],
)
