load("//admin/buck2:reindeer_rules.bzl", "app_rust_library")
load("//admin:targets.bzl", "RUST_EDITION", "TOKAMAK_CRATES", "TOKAMAK_TEST_CRATES")

TOKAMAK_BUCK_DEPS = ["//rust:" + crate for crate in TOKAMAK_CRATES]

TOKAMAK_BUCK_TEST_DEPS = ["//rust:" + crate for crate in TOKAMAK_TEST_CRATES]

_TOKAMAK_SRCS = glob([
    "src/**/*.metal",
    "src/**/*.rs",
])

filegroup(
    name = "source",
    srcs = glob([
        "src/**/*.metal",
        "src/**/*.rs",
    ]) + [
        "Cargo.toml",
    ],
    visibility = ["PUBLIC"],
)

app_rust_library(
    name = "tokamak",
    srcs = _TOKAMAK_SRCS,
    crate = "baux_tokamak",
    crate_root = "src/lib.rs",
    edition = RUST_EDITION,
    features = select({
        "//:macos-arm64": ["metal"],
        "DEFAULT": [],
    }),
    visibility = ["PUBLIC"],
    deps = TOKAMAK_BUCK_DEPS + [
        "//rust/crates/baux:baux",
    ] + select({
        "//:macos-arm64": ["//rust:metal"],
        "DEFAULT": [],
    }),
)

rust_test(
    name = "tokamak-unit",
    srcs = _TOKAMAK_SRCS,
    crate = "baux_tokamak",
    crate_root = "src/lib.rs",
    edition = RUST_EDITION,
    rustc_flags = select({
        "root//:release-mode": [],
        "DEFAULT": ["-Zthreads=8", "-Ccodegen-units=16"],
    }),
    features = select({
        "//:macos-arm64": ["metal"],
        "DEFAULT": [],
    }),
    visibility = ["PUBLIC"],
    deps = TOKAMAK_BUCK_TEST_DEPS + [
        "//rust/crates/baux:baux",
    ] + select({
        "//:macos-arm64": [
            "//admin/buck2/native:openmp-macos",
            "//rust:metal",
        ],
        "DEFAULT": [],
    }),
    rpath = True,
    runtime_dependency_handling = "symlink",
)
