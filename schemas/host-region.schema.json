{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host regional restart-memory comparison",
  "type": "object",
  "required": ["version", "experiment", "dimensions", "evaluations", "regions", "seeds", "sharing", "starts", "restart_after_evaluations", "allocation", "controller", "restart_memory"],
  "properties": {
    "version": {"const": 1},
    "experiment": {"const": "host-regions"},
    "dimensions": {"type": "integer", "minimum": 1},
    "evaluations": {"type": "integer", "minimum": 8, "multipleOf": 8},
    "regions": {"const": 4},
    "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "sharing": {"type": "array", "minItems": 1, "items": {"enum": ["independent", "shared", "nearest_center"]}},
    "starts": {"type": "array", "minItems": 1, "items": {"enum": ["separated", "clustered"]}},
    "restart_after_evaluations": {"type": "integer", "minimum": 0},
    "allocation": {"const": "balanced"},
    "controller": {"enum": ["fixed_radius", "turbo"]},
    "restart_memory": {"const": ["fresh", "retain_relevant"]},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["uniform", "split_beta"]}},
    "restart_centers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["midpoint", "uniform", "maximin"]}},
    "restart_candidates": {"type": "integer", "minimum": 1},
    "objectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["double_well", "rastrigin", "ackley"]}},
    "length_init": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
    "length_min": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
    "length_max": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
    "failure_tolerance": {"type": "integer", "minimum": 1},
    "success_tolerance": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
