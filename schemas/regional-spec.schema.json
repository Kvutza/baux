{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resident multi-region lifecycle experiment",
  "type": "object",
  "required": ["version", "experiment", "dimensions", "evaluations", "regions", "seeds", "sharing", "starts"],
  "properties": {
    "version": {"const": 1},
    "experiment": {"const": "resident-regions"},
    "dimensions": {"type": "integer", "minimum": 1, "maximum": 65536},
    "evaluations": {"type": "integer", "minimum": 5},
    "regions": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 32}},
    "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "sharing": {"type": "array", "minItems": 1, "items": {"enum": ["independent", "shared", "nearest_center"]}},
    "starts": {"type": "array", "minItems": 1, "items": {"enum": ["separated", "clustered"]}}
  },
  "additionalProperties": false
}
