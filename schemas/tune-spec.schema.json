{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kvutza/baux/main/schemas/tune-spec.schema.json",
  "title": "BAUX Experiment and Tuning Specification",
  "description": "Closed schema for BAUX version 4 experiment recipes.",
  "type": "object",
  "required": ["version", "experiment", "optimizer"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 4,
      "description": "Experiment configuration schema version. Must be 4."
    },
    "experiment": {
      "type": "string",
      "enum": ["end-to-end", "moe-layer", "pretrain", "generation", "tokamak-tcv"],
      "description": "Experiment workflow type: 'pretrain' for foundation model pretraining, 'generation' for sequence generation tasks, or 'tokamak-tcv' for TCV tokamak policy optimization."
    },
    "model": {
      "type": "string",
      "enum": [
        "fbt-pisa1-legacy-v1",
        "fbt-pisa1-residual1-v1",
        "fbt-pisa1-projected-boundary-v1",
        "fbt-pisa1-hc4-v1",
        "fbt-pisa1-mhc4-v1",
        "fbt-pisa1-hnet-mhc4-v1",
        "fbt-pisa1-looped-mhc4-v1",
        "fbt-pisa1-diffusion-mhc4-v1"
      ],
      "description": "Architecture preset for pretraining."
    },
    "output": {
      "type": "string",
      "description": "Optional destination directory for serialized run records, checkpoints, and telemetry logs."
    },
    "recipe": {
      "type": "string",
      "description": "Versioned immutable data recipe identifier (e.g., 'stack-v3-rust-go-v1' or 'fineweb-bytes-100m-v1')."
    },
    "train": {
      "type": "string",
      "description": "Filesystem path to training corpus token split (populated in frozen run records)."
    },
    "validation": {
      "type": "string",
      "description": "Filesystem path to held-out validation token split (populated in frozen run records)."
    },
    "objective": {
      "type": "string",
      "enum": ["cross-entropy", "bounded-log-likelihood"],
      "default": "cross-entropy",
      "description": "Objective loss function evaluated over sequence tokens: 'cross-entropy' (-log p) or 'bounded-log-likelihood' (log(2 - p))."
    },
    "window-tokens": {
      "type": "integer",
      "minimum": 1,
      "description": "Tokens per causal evaluation window (e.g., 4096, 65536, 1048576 for 1M context)."
    },
    "rounds": {
      "type": "integer",
      "minimum": 1,
      "description": "Total optimizer rounds / transactions to execute."
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Requested repetitions of the experiment."
    },
    "round-target-ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Requested round latency threshold in milliseconds."
    },
    "validation-interval": {
      "type": "integer",
      "minimum": 1,
      "description": "Held-out evaluation cadence in optimizer transactions."
    },
    "trace": {
      "type": "boolean",
      "default": false,
      "description": "Enable execution trace recording."
    },
    "stage-samples": {
      "type": "integer",
      "minimum": 1,
      "description": "Sample count for stage timing profiling."
    },
    "optimizer": {
      "type": "object",
      "description": "Optimizer recipe defining algorithm, candidate proposal, surrogate model, and trust-region bounds.",
      "required": ["algorithm"],
      "oneOf": [
        {
          "title": "Operator BO",
          "required": ["algorithm"],
          "properties": {
            "algorithm": { "const": "operator-bo" }
          },
          "allOf": [
            { "not": { "required": ["candidates"] } },
            { "not": { "required": ["arms"] } },
            { "not": { "required": ["acquisition"] } },
            { "not": { "required": ["beta"] } },
            { "not": { "required": ["scales"] } }
          ]
        },
        {
          "title": "Bayesian search",
          "required": ["algorithm", "acquisition"],
          "properties": {
            "algorithm": { "const": "bayesian-search" }
          }
        },
        {
          "title": "Muon",
          "properties": { "algorithm": { "const": "muon" } },
          "allOf": [
            { "not": { "required": ["surrogate"] } },
            { "not": { "required": ["acquisition"] } },
            { "not": { "required": ["trust-region"] } },
            { "not": { "required": ["regional-search"] } }
          ]
        },
        {
          "title": "AdamW",
          "properties": { "algorithm": { "const": "adamw" } },
          "allOf": [
            { "not": { "required": ["surrogate"] } },
            { "not": { "required": ["acquisition"] } },
            { "not": { "required": ["trust-region"] } },
            { "not": { "required": ["regional-search"] } }
          ]
        },
        {
          "title": "PPO",
          "properties": { "algorithm": { "const": "ppo" } },
          "allOf": [
            { "not": { "required": ["surrogate"] } },
            { "not": { "required": ["acquisition"] } },
            { "not": { "required": ["trust-region"] } },
            { "not": { "required": ["regional-search"] } }
          ]
        }
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["operator-bo", "bayesian-search", "muon", "adamw", "ppo"],
          "description": "Optimization recipe: operator BO, Bayesian search, Muon, AdamW, or PPO."
        },
        "candidates": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "description": "Total proposals generated per Bayesian-search round across all arms."
        },
        "arms": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of procedural seed namespaces sharing the current incumbent center."
        },
        "distribution": {
          "type": "string",
          "enum": ["gaussian", "rademacher"],
          "default": "gaussian",
          "description": "Coordinate noise innovation law: 'gaussian' (256-strip Ziggurat normal) or 'rademacher' ({-1, +1})."
        },
        "acquisition": {
          "type": "string",
          "enum": ["thompson", "random", "upper-confidence-bound", "pareto"],
          "description": "Acquisition policy for selecting Bayesian-search proposals."
        },
        "beta": {
          "type": "number",
          "default": 2.0,
          "description": "Exploration weight beta for Upper Confidence Bound (UCB)."
        },
        "scales": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Objective scales for multi-objective Pareto acquisition."
        },
        "perturbation": {
          "type": "object",
          "description": "Coordinate perturbation sampler and subspace cardinality.",
          "properties": {
            "sampler": {
              "type": "string",
              "enum": ["sobol", "uniform", "raasp"],
              "default": "raasp"
            },
            "num-pert": {
              "type": "integer",
              "minimum": 1,
              "default": 20
            },
            "raasp-fast": {
              "type": "boolean",
              "default": false
            },
            "coord-system": {
              "type": "string",
              "enum": ["cartesian", "spherical"],
              "default": "cartesian"
            }
          },
          "additionalProperties": false
        },
        "surrogate": {
          "type": "object",
          "description": "Surrogate model distance geometry, uncertainty scales, and fitting procedure.",
          "properties": {
            "neighbors": {
              "type": "integer",
              "minimum": 1,
              "default": 10,
              "description": "Number of nearest history neighbors k used for prediction."
            },
            "neighbor-rule": {
              "type": "string",
              "enum": ["fixed", "risk-prefix"],
              "default": "fixed",
              "description": "Query-local neighbor adaptation rule."
            },
            "epistemic-scale": {
              "type": "number",
              "default": 0.05,
              "description": "Prior epistemic uncertainty scale parameter."
            },
            "aleatoric-scale": {
              "type": "number",
              "default": 0.05,
              "description": "Prior observation noise (aleatoric) scale parameter."
            },
            "y-scale": {
              "type": "number",
              "default": 1.0,
              "description": "Output response scale parameter."
            },
            "metric": {
              "type": "string",
              "enum": ["euclidean", "conformal", "hyperbolic", "wasserstein"],
              "default": "euclidean",
              "description": "Distance metric across parameter dimensions."
            },
            "geometry": {
              "type": "string",
              "enum": ["latent", "realized"],
              "default": "latent",
              "description": "Coordinate geometry for parameter distance calculation."
            },
            "local-neighbors": {
              "type": "integer",
              "minimum": 1,
              "description": "Local neighborhood rank for conformal, hyperbolic, or wasserstein distance metrics."
            },
            "fit": {
              "type": "string",
              "enum": ["fixed", "leave-one-out"],
              "default": "fixed",
              "description": "Surrogate scale fitting rule."
            },
            "fit-candidates": {
              "type": "integer",
              "minimum": 1,
              "description": "Hyperparameter configurations considered by leave-one-out fitting."
            },
            "fit-samples": {
              "type": "integer",
              "minimum": 1,
              "description": "Retained observations scored per fitting configuration."
            }
          },
          "oneOf": [
            {
              "properties": { "fit": { "const": "leave-one-out" } },
              "required": ["fit", "fit-candidates", "fit-samples"]
            },
            {
              "not": { "properties": { "fit": { "const": "leave-one-out" } }, "required": ["fit"] },
              "allOf": [
                { "not": { "required": ["fit-candidates"] } },
                { "not": { "required": ["fit-samples"] } }
              ]
            }
          ],
          "additionalProperties": false
        },
        "trust-region": {
          "type": "object",
          "description": "Trust-region radius bounds and block scaling geometry.",
          "properties": {
            "initial": {
              "type": "number",
              "minimum": 0.0,
              "exclusiveMinimum": 0.0,
              "description": "Initial trust region radius (dimensionless multiplier on block scales)."
            },
            "min": {
              "type": "number",
              "minimum": 0.0,
              "exclusiveMinimum": 0.0,
              "description": "Minimum allowed trust region radius."
            },
            "max": {
              "type": "number",
              "minimum": 0.0,
              "exclusiveMinimum": 0.0,
              "description": "Maximum allowed trust region radius."
            },
            "shape": {
              "type": "string",
              "enum": ["scalar", "tensor-family-static"],
              "description": "Trust region geometry shape across parameter blocks."
            }
          },
          "additionalProperties": false
        },
        "regional-search": {
          "type": "object",
          "description": "Concurrent regional-search policies, independent of surrogate and acquisition selection.",
          "required": ["count"],
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "sharing": {
              "enum": ["box-contain", "ellipsoid-ball", "nearest-center", "origin-only"],
              "default": "box-contain"
            },
            "allocation": {
              "enum": ["incumbent-ucb1", "least-trials", "joint-acquisition"],
              "default": "incumbent-ucb1"
            },
            "controller": {
              "enum": ["turbo", "fixed-radius"],
              "default": "turbo"
            },
            "success-tolerance": { "type": "integer", "minimum": 1, "default": 3 },
            "failure-tolerance": { "type": "integer", "minimum": 1, "default": 5 },
            "restart-memory": {
              "enum": ["fresh", "retain-relevant"],
              "default": "fresh"
            },
            "restart-candidates": { "type": "integer", "minimum": 1, "default": 1 },
            "restart-center": {
              "enum": ["first", "maximin"],
              "default": "first"
            },
            "acquisitions": { "type": "array" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
