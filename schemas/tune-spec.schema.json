{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kvutza/baux/main/schemas/tune-spec.schema.json",
  "title": "BAUX Experiment and Tuning Specification",
  "description": "Closed schema for BAUX version 4 experiment recipes.",
  "type": "object",
  "required": ["version", "experiment", "optimizer"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 4,
      "description": "Experiment configuration schema version. Must be 4."
    },
    "experiment": {
      "type": "string",
      "enum": ["end-to-end", "moe-layer", "pretrain", "generation"],
      "description": "Experiment workflow type: 'pretrain' for foundation model pretraining or 'generation' for sequence generation tasks."
    },
    "model": {
      "type": "string",
      "enum": [
        "fbt-pisa1-legacy-v1",
        "fbt-pisa1-residual1-v1",
        "fbt-pisa1-projected-boundary-v1",
        "fbt-pisa1-hc4-v1",
        "fbt-pisa1-mhc4-v1",
        "fbt-pisa1-hnet-mhc4-v1",
        "fbt-pisa1-looped-mhc4-v1",
        "fbt-pisa1-diffusion-mhc4-v1"
      ],
      "description": "Architecture preset for pretraining."
    },
    "output": {
      "type": "string",
      "description": "Optional destination directory for serialized run records, checkpoints, and telemetry logs."
    },
    "data": {
      "type": "object",
      "description": "Dataset recipe and resolved split paths.",
      "properties": {
        "recipe": {
          "type": "string",
          "description": "Versioned immutable data recipe identifier (e.g., 'stack-v3-rust-go-v1' or 'fineweb-bytes-100m-v1')."
        },
        "train": {
          "type": "string",
          "description": "Filesystem path to training corpus token split (populated in frozen run records)."
        },
        "validation": {
          "type": "string",
          "description": "Filesystem path to held-out validation token split (populated in frozen run records)."
        }
      },
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "description": "Objective loss function and causal evaluation window.",
      "properties": {
        "function": {
          "type": "string",
          "enum": ["cross-entropy", "bounded-log-likelihood"],
          "default": "cross-entropy",
          "description": "Objective loss function evaluated over sequence tokens: 'cross-entropy' (-log p) or 'bounded-log-likelihood' (log(2 - p))."
        },
        "window-tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Tokens per causal evaluation window (e.g., 4096, 65536, 1048576 for 1M context)."
        },
        "reference": {
          "type": "string",
          "enum": ["moving-incumbent", "frozen-initial"],
          "default": "moving-incumbent",
          "description": "Reference baseline for contrastive evaluations."
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "description": "Execution budget, validation cadence, latency target, and optional profiling.",
      "properties": {
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "description": "Total optimizer rounds / transactions to execute."
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Requested repetitions of the experiment."
        },
        "round-target-ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Requested round latency threshold in milliseconds."
        },
        "validation-interval": {
          "type": "integer",
          "minimum": 1,
          "description": "Held-out evaluation cadence in optimizer transactions."
        },
        "trace": {
          "type": "boolean",
          "default": false,
          "description": "Enable execution trace recording."
        },
        "stage-samples": {
          "type": "integer",
          "minimum": 1,
          "description": "Sample count for stage timing profiling."
        },
        "pool-rank": {
          "type": "integer",
          "minimum": 1,
          "description": "Candidate pool rank audit frequency."
        },
        "kernels": {
          "type": "object",
          "description": "Kernel-level execution settings."
        }
      },
      "additionalProperties": false
    },
    "optimizer": {
      "type": "object",
      "description": "Optimizer recipe defining algorithm, candidate proposal, surrogate model, and trust-region bounds.",
      "required": ["algorithm"],
      "oneOf": [
        {
          "title": "Operator BO",
          "required": ["algorithm", "proposal", "distribution", "surrogate", "trust-region"],
          "properties": {
            "algorithm": { "const": "operator-bo" },
            "candidates": { "const": 1 },
            "arms": { "const": 1 }
          },
          "allOf": [
            { "not": { "required": ["acquisition"] } },
            { "not": { "required": ["beta"] } },
            { "not": { "required": ["scales"] } },
            { "not": { "required": ["preferences"] } },
            { "not": { "required": ["alpha"] } },
            { "not": { "required": ["seed-domain"] } },
            { "not": { "required": ["regions"] } },
            { "not": { "required": ["rescalarize"] } },
            { "not": { "required": ["clip"] } }
          ]
        },
        {
          "title": "TuRBO ENN",
          "required": ["algorithm", "proposal", "acquisition", "surrogate"],
          "properties": {
            "algorithm": { "const": "turbo-enn" }
          }
        },
        {
          "title": "Muon",
          "properties": { "algorithm": { "const": "muon" } },
          "allOf": [
            { "not": { "required": ["proposal"] } },
            { "not": { "required": ["surrogate"] } },
            { "not": { "required": ["acquisition"] } },
            { "not": { "required": ["trust-region"] } }
          ]
        },
        {
          "title": "AdamW",
          "properties": { "algorithm": { "const": "adamw" } },
          "allOf": [
            { "not": { "required": ["proposal"] } },
            { "not": { "required": ["surrogate"] } },
            { "not": { "required": ["acquisition"] } },
            { "not": { "required": ["trust-region"] } }
          ]
        }
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["operator-bo", "turbo-enn", "muon", "adamw"],
          "description": "Optimization algorithm: 'operator-bo', 'turbo-enn', 'muon', or 'adamw'."
        },
        "proposal": {
          "type": "string",
          "enum": ["pair-rotation", "independent", "lie"],
          "description": "Procedural proposal method: 'lie' (2nd-order Lie operator flow), 'pair-rotation' (unit-tangent mixing), or 'independent' (additive noise)."
        },
        "candidates": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Total proposals generated per round across all arms."
        },
        "arms": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of procedural seed namespaces sharing the current incumbent center."
        },
        "distribution": {
          "type": "string",
          "enum": ["gaussian", "rademacher"],
          "default": "gaussian",
          "description": "Coordinate noise innovation law: 'gaussian' (256-strip Ziggurat normal) or 'rademacher' ({-1, +1})."
        },
        "acquisition": {
          "type": "string",
          "enum": ["thompson", "random", "upper-confidence-bound", "pareto", "augmented-chebyshev"],
          "description": "Acquisition policy for selecting proposals in turbo-enn."
        },
        "beta": {
          "type": "number",
          "default": 2.0,
          "description": "Exploration weight beta for Upper Confidence Bound (UCB)."
        },
        "scales": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Objective scales for multi-objective acquisition."
        },
        "preferences": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Preference weights for augmented Chebyshev acquisition."
        },
        "alpha": {
          "type": "number",
          "description": "Augmentation factor for Chebyshev scalarization."
        },
        "seed-domain": {
          "type": "string",
          "description": "Seed domain identifier for multi-objective acquisition."
        },
        "regions": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "description": "Count of trust regions for multi-region MORBO."
        },
        "rescalarize": {
          "type": "string",
          "enum": ["on-propose", "on-restart"],
          "description": "MORBO rescalarization schedule."
        },
        "clip": {
          "type": "boolean",
          "description": "Whether MORBO clips updates to the active region."
        },
        "surrogate": {
          "type": "object",
          "description": "Surrogate model distance geometry, uncertainty scales, and fitting procedure.",
          "required": ["fit"],
          "properties": {
            "neighbors": {
              "type": "integer",
              "minimum": 1,
              "default": 10,
              "description": "Number of nearest history neighbors k used for prediction."
            },
            "neighbor-rule": {
              "type": "string",
              "enum": ["fixed", "risk-prefix"],
              "default": "fixed",
              "description": "Query-local neighbor adaptation rule."
            },
            "epistemic-scale": {
              "type": "number",
              "default": 0.05,
              "description": "Prior epistemic uncertainty scale parameter."
            },
            "aleatoric-scale": {
              "type": "number",
              "default": 0.05,
              "description": "Prior observation noise (aleatoric) scale parameter."
            },
            "y-scale": {
              "type": "number",
              "default": 1.0,
              "description": "Output response scale parameter."
            },
            "scaling": {
              "type": "string",
              "enum": ["global", "self-tuning", "hyperbolic"],
              "default": "global",
              "description": "Distance normalization mode across parameter dimensions."
            },
            "geometry": {
              "type": "string",
              "enum": ["latent", "realized"],
              "default": "latent",
              "description": "Coordinate geometry for parameter distance calculation."
            },
            "local-neighbors": {
              "type": "integer",
              "minimum": 1,
              "description": "Local neighborhood rank for self-tuning or hyperbolic distance scaling."
            },
            "fit": {
              "type": "string",
              "enum": ["fixed", "leave-one-out"],
              "description": "Surrogate scale fitting rule."
            },
            "fit-candidates": {
              "type": "integer",
              "minimum": 1,
              "description": "Hyperparameter configurations considered by leave-one-out fitting."
            },
            "fit-samples": {
              "type": "integer",
              "minimum": 1,
              "description": "Retained observations scored per fitting configuration."
            }
          },
          "oneOf": [
            {
              "properties": { "fit": { "const": "fixed" } },
              "allOf": [
                { "not": { "required": ["fit-candidates"] } },
                { "not": { "required": ["fit-samples"] } }
              ]
            },
            {
              "required": ["fit", "fit-candidates", "fit-samples"],
              "properties": { "fit": { "const": "leave-one-out" } }
            }
          ],
          "additionalProperties": false
        },
        "trust-region": {
          "type": "object",
          "description": "Trust-region radius bounds and block scaling geometry.",
          "properties": {
            "initial": {
              "type": "number",
              "minimum": 0.0,
              "exclusiveMinimum": 0.0,
              "description": "Initial trust region radius (dimensionless multiplier on block scales)."
            },
            "min": {
              "type": "number",
              "minimum": 0.0,
              "exclusiveMinimum": 0.0,
              "description": "Minimum allowed trust region radius."
            },
            "max": {
              "type": "number",
              "minimum": 0.0,
              "exclusiveMinimum": 0.0,
              "description": "Maximum allowed trust region radius."
            },
            "shape": {
              "type": "string",
              "enum": ["scalar", "tensor-family-static"],
              "description": "Trust region geometry shape across parameter blocks."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
